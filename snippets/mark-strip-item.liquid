{% doc %}
  Renders one item of the mark strip section: icon + title + optional caption,
  or a standalone logo when the title is blank.

  @param {object} block - An `item` block of the mark-strip section.
  @param {boolean} [is_clone] - Whether the item belongs to the duplicated (aria-hidden) run. Defaults to `false`.
  @param {object} [section] - The mark-strip section, supplied implicitly; used for icon settings.

  @example
  {% render 'mark-strip-item', block: block, is_clone: false %}
{% enddoc %}

{%- liquid
  if block.settings.link != blank
    assign item_tag = 'a'
  else
    assign item_tag = 'div'
  endif

  assign image = block.settings.image
  assign has_copy = false
  if block.settings.title != blank or block.settings.caption != blank
    assign has_copy = true
  endif

  # A logo without text carries the meaning, so it gets alt text (except in the aria-hidden clone).
  assign image_alt = ''
  unless has_copy or is_clone
    assign image_alt = image.alt | escape
  endunless

  assign logo_style = ''
  if block.settings.logo_height > 0 and image != blank
    assign logo_width = block.settings.logo_height | times: image.aspect_ratio | round: 2
    assign logo_style = '--logo-h: ' | append: block.settings.logo_height | append: 'px; --logo-w: ' | append: logo_width | append: 'px;'
  endif
-%}
<li
  class="mark-strip__item"
  {% unless is_clone %}
    {{ block.shopify_attributes }}
  {% endunless %}
>
  <{{ item_tag }}
    class="mark-strip__mark{% if item_tag == 'a' %} mark-strip__link{% endif %}"
    {% if item_tag == 'a' %}
      href="{{ block.settings.link }}"
      {% if is_clone %}
        tabindex="-1"
      {% endif %}
    {% endif %}
  >
    {%- if image != blank -%}
      {%- if section.settings.tint_icons -%}
        <span
          class="mark-strip__ink{% if logo_style != blank %} mark-strip__logo{% endif %}"
          style="--mask: url('{{ image | image_url: width: 480 }}'); {{ logo_style }}"
          {% if image_alt != blank %}
            role="img" aria-label="{{ image_alt }}"
          {% else %}
            aria-hidden="true"
          {% endif %}
        ></span>
      {%- else -%}
        {%- liquid
          assign image_class = 'mark-strip__icon'
          if logo_style != blank
            assign image_class = 'mark-strip__icon mark-strip__logo'
          endif
        -%}
        {{
          image
          | image_url: width: 480
          | image_tag:
            class: image_class,
            widths: '120, 240, 480',
            sizes: '240px',
            loading: 'lazy',
            alt: image_alt,
            style: logo_style
        }}
      {%- endif -%}
    {%- elsif block.settings.icon != 'none' -%}
      <span class="mark-strip__icon mark-strip__icon--theme" aria-hidden="true">
        {%- render 'icon-accordion', icon: block.settings.icon -%}
      </span>
    {%- endif -%}
    {%- if has_copy -%}
      <span class="mark-strip__copy">
        {%- if block.settings.title != blank -%}
          <span class="mark-strip__title">{{ block.settings.title }}</span>
        {%- endif -%}
        {%- if block.settings.caption != blank -%}
          <span class="mark-strip__caption">{{ block.settings.caption }}</span>
        {%- endif -%}
      </span>
    {%- endif -%}
  </{{ item_tag }}>
</li>
