{{ 'section-faq-list.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font

  case section.settings.heading_font_source
    when 'theme_heading'
      assign heading_ff = 'var(--font-heading-family)'
      assign heading_fs = 'var(--font-heading-style)'
    when 'theme_body'
      assign heading_ff = 'var(--font-body-family)'
      assign heading_fs = 'var(--font-body-style)'
    else
      assign heading_ff = heading_font.family | append: ', ' | append: heading_font.fallback_families
      assign heading_fs = heading_font.style
  endcase

  case section.settings.body_font_source
    when 'theme_heading'
      assign body_ff = 'var(--font-heading-family)'
      assign body_fs = 'var(--font-heading-style)'
    when 'theme_body'
      assign body_ff = 'var(--font-body-family)'
      assign body_fs = 'var(--font-body-style)'
    else
      assign body_ff = body_font.family | append: ', ' | append: body_font.fallback_families
      assign body_fs = body_font.style
  endcase

  assign heading_id = 'FaqList-Heading-' | append: section.id
-%}

{%- style -%}
  {%- if section.settings.heading_font_source == 'custom' -%}
    {{ heading_font | font_face: font_display: 'swap' }}
    {%- assign heading_font_weighted = heading_font | font_modify: 'weight', section.settings.heading_font_weight -%}
    {%- if heading_font_weighted -%}
      {{ heading_font_weighted | font_face: font_display: 'swap' }}
    {%- endif -%}
  {%- endif -%}
  {%- if section.settings.body_font_source == 'custom' -%}
    {{ body_font | font_face: font_display: 'swap' }}
    {%- assign body_font_bold = body_font | font_modify: 'weight', '700' -%}
    {%- if body_font_bold -%}
      {{ body_font_bold | font_face: font_display: 'swap' }}
    {%- endif -%}
  {%- endif -%}

  .faq-list-{{ section.id }} {
    --faq-bg: {{ section.settings.background }};
    --faq-heading-color: {{ section.settings.heading_color }};
    --faq-color: {{ section.settings.text_color }};
    --faq-question-color: {{ section.settings.question_color }};
    --faq-border: {{ section.settings.border_color }};
    --faq-toggle-bg: {{ section.settings.toggle_background }};
    --faq-toggle-color: {{ section.settings.toggle_color }};
    --faq-button-bg: {{ section.settings.button_background }};
    --faq-button-color: {{ section.settings.button_text }};
    --faq-button-bg-hover: {{ section.settings.button_background_hover }};
    --faq-button-color-hover: {{ section.settings.button_text_hover }};
    --faq-pt: {{ section.settings.padding_top }}px;
    --faq-pb: {{ section.settings.padding_bottom }}px;
    --faq-pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --faq-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --faq-max-width: {{ section.settings.max_width }}px;
    --faq-list-max-width: {{ section.settings.list_max_width }}px;
    --faq-px: {{ section.settings.padding_x }}px;
    --faq-px-mobile: {{ section.settings.padding_x_mobile }}px;
    --faq-gap: {{ section.settings.stack_gap }}px;
    --faq-item-gap: {{ section.settings.item_spacing }}px;
    --faq-heading-ff: {{ heading_ff }};
    --faq-heading-fs: {{ heading_fs }};
    --faq-heading-fw: {{ section.settings.heading_font_weight }};
    --faq-heading-size: {{ section.settings.heading_size }}px;
    --faq-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --faq-heading-tt: {% if section.settings.heading_uppercase %}uppercase{% else %}none{% endif %};
    --faq-body-ff: {{ body_ff }};
    --faq-body-fs: {{ body_fs }};
    --faq-subheading-size: {{ section.settings.subheading_size }}px;
    --faq-subheading-size-mobile: {{ section.settings.subheading_size_mobile }}px;
    --faq-question-size: {{ section.settings.question_size }}px;
    --faq-answer-size: {{ section.settings.answer_size }}px;
  }
{%- endstyle -%}

<div
  class="faq-list faq-list-{{ section.id }}"
  {% if section.settings.heading != blank %}
    role="region" aria-labelledby="{{ heading_id }}"
  {% endif %}
>
  <div class="faq-list__container">
    {%- if section.settings.heading != blank -%}
      <h2 id="{{ heading_id }}" class="faq-list__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="faq-list__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="faq-list__items">
        {%- for block in section.blocks -%}
          <details
            class="faq-list__item"
            {% if block.settings.open %}
              open
            {% endif %}
            {{ block.shopify_attributes }}
          >
            <summary class="faq-list__summary">
              <h3 class="faq-list__question">{{ block.settings.question }}</h3>
              <span class="faq-list__toggle" aria-hidden="true"></span>
            </summary>
            <div class="faq-list__answer">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a
        {% if section.settings.button_link != blank %}
          href="{{ section.settings.button_link }}"
        {% else %}
          role="link" aria-disabled="true"
        {% endif %}
        class="faq-list__button"
      >
        {{- section.settings.button_label | escape -}}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Preguntas destacadas",
  "tag": "section",
  "class": "section",
  "max_blocks": 20,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título",
      "default": "Preguntas frecuentes"
