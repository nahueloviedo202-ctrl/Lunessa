    },
    {
      "type": "color",
      "id": "button_text_hover",
      "label": "Botón: texto al pasar el mouse",
      "default": "#075007"
    },
    {
      "type": "header",
      "content": "Tipografía"
    },
    {
      "type": "select",
      "id": "heading_font_source",
      "label": "Fuente del título",
      "options": [
        {
          "value": "theme_heading",
          "label": "Títulos del theme"
        },
        {
          "value": "theme_body",
          "label": "Textos del theme"
        },
        {
          "value": "custom",
          "label": "Personalizada"
        }
      ],
      "default": "theme_heading"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Fuente personalizada del título",
      "default": "assistant_n4"
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Peso del título",
      "options": [
        {
          "value": "400",
          "label": "400"
        },
        {
          "value": "600",
          "label": "600"
        },
        {
          "value": "700",
          "label": "700"
        },
        {
          "value": "800",
          "label": "800"
        },
        {
          "value": "900",
          "label": "900"
        }
      ],
      "default": "900"
    },
    {
      "type": "range",
      "id": "heading_size",
