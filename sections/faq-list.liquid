    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 16,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del título (mobile)",
      "default": 28
    },
    {
      "type": "checkbox",
      "id": "heading_uppercase",
      "label": "Título en mayúsculas",
      "default": false
    },
    {
      "type": "select",
      "id": "body_font_source",
      "label": "Fuente de textos",
      "options": [
        {
          "value": "theme_heading",
          "label": "Títulos del theme"
        },
        {
          "value": "theme_body",
          "label": "Textos del theme"
        },
        {
          "value": "custom",
          "label": "Personalizada"
        }
