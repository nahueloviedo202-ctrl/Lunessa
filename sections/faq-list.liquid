    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Espaciado inferior (mobile)",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Pregunta",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "question",
          "label": "Pregunta",
          "default": "¿Dónde se fabrican sus productos?"
        },
        {
          "type": "richtext",
          "id": "answer",
