      "default": "Para ver todas las preguntas sobre productos, visitá nuestra página de preguntas frecuentes."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Ver todos"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fondo",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Título",
      "default": "#075007"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Subtítulo y respuestas",
      "default": "#2E2E2E"
    },
    {
      "type": "color",
      "id": "question_color",
      "label": "Preguntas",
      "default": "#075007"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Líneas divisorias",
      "default": "#E3E3E3"
    },
    {
      "type": "color",
      "id": "toggle_background",
      "label": "Botón +/−: fondo",
      "default": "#075007"
    },
    {
      "type": "color",
      "id": "toggle_color",
      "label": "Botón +/−: signo",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Botón: fondo",
      "default": "#075007"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Botón: texto",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_background_hover",
