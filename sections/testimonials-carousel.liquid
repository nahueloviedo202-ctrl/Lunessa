{{ 'section-testimonials-carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'drag-scroll.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'testimonials-carousel.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  {%- if section.settings.heading_font_custom -%}
    {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if section.settings.body_font_custom -%}
    {{ section.settings.body_font | font_face: font_display: 'swap' }}
  {%- endif -%}

  .tst--{{ section.id }} {
    {%- if section.settings.heading_font_custom %}
      --tst-heading-font: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
      --tst-heading-style: {{ section.settings.heading_font.style }};
    {%- endif %}
    {%- if section.settings.body_font_custom %}
      --tst-body-font: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
      --tst-body-style: {{ section.settings.body_font.style }};
    {%- endif %}
    --tst-bg: {{ section.settings.background }};
    --tst-bg-mobile: {{ section.settings.background_mobile | default: section.settings.background }};
    --tst-pt: {{ section.settings.padding_top }}px;
    --tst-pb: {{ section.settings.padding_bottom }}px;
    --tst-pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --tst-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --tst-px-mobile: {{ section.settings.padding_horizontal_mobile }}px;

    --tst-badge-bg: {{ section.settings.badge_background }};
    --tst-badge-color: {{ section.settings.badge_color }};
    --tst-badge-border: {{ section.settings.badge_border_color }};
    --tst-badge-size: {{ section.settings.badge_size }}px;
    --tst-badge-size-mobile: {{ section.settings.badge_size_mobile }}px;
    --tst-subtitle-color: {{ section.settings.subtitle_color }};
    --tst-subtitle-size: {{ section.settings.subtitle_size }}px;
    --tst-subtitle-size-mobile: {{ section.settings.subtitle_size_mobile }}px;
    --tst-heading-color: {{ section.settings.heading_color }};
    --tst-heading-size: {{ section.settings.heading_size }}px;
    --tst-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --tst-heading-transform: {{ section.settings.heading_transform }};

    --tst-cards: {{ section.settings.cards_desktop }};
    --tst-cards-tablet: {{ section.settings.cards_tablet }};
    --tst-cards-mobile: {{ section.settings.cards_mobile }};
    --tst-gap: {{ section.settings.card_gap }}px;
    --tst-arrow-bg: {{ section.settings.arrow_background }};
    --tst-arrow-color: {{ section.settings.arrow_color }};
    --tst-fade-color: {{ section.settings.fade_color }};

    --tst-card-bg: {{ section.settings.card_background }};
    --tst-card-border: {{ section.settings.card_border_color }};
    --tst-card-radius: {{ section.settings.card_radius }}px;
    --tst-card-radius-mobile: {{ section.settings.card_radius_mobile }}px;
    --tst-image-ratio: {{ section.settings.image_ratio }};
    --tst-image-radius: {{ section.settings.image_radius }}px;
    --tst-star-color: {{ section.settings.star_color }};
    --tst-star-size: {{ section.settings.star_size }}px;
    --tst-title-color: {{ section.settings.title_color }};
    --tst-title-size: {{ section.settings.title_size }}px;
    --tst-title-size-mobile: {{ section.settings.title_size_mobile }}px;
    --tst-text-color: {{ section.settings.text_color }};
    --tst-text-size: {{ section.settings.text_size }}px;
    --tst-text-size-tablet: {{ section.settings.text_size_tablet }}px;
    --tst-text-size-mobile: {{ section.settings.text_size_mobile }}px;
    --tst-divider-color: {{ section.settings.divider_color }};
    --tst-verified-color: {{ section.settings.verified_color }};
  }
{%- endstyle -%}

<section class="tst tst--{{ section.id }}">
  <div class="tst__container page-width">
    <div class="tst__header">
      {%- if section.settings.badge != blank -%}
        <p class="tst__badge">{{ section.settings.badge | escape }}</p>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="tst__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="tst__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <testimonials-slider
        class="tst__carousel{% if section.settings.show_arrows %} tst__carousel--arrows{% endif %}"
        data-loop="{{ section.settings.loop }}"
        data-autoplay="{{ section.settings.autoplay }}"
        data-speed="{{ section.settings.autoplay_speed }}"
      >
        <div class="tst__controls">
          <button
            type="button"
            class="tst__arrow tst__arrow--prev"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            {%- render 'product-offer-hero-icon', icon: 'caret_right_bold' -%}
          </button>
          <button
            type="button"
            class="tst__arrow tst__arrow--next"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            {%- render 'product-offer-hero-icon', icon: 'caret_right_bold' -%}
          </button>
        </div>

        <div class="tst__viewport{% if section.settings.show_fade %} tst__viewport--fade{% endif %}">
          <drag-scroll
            id="Slider-{{ section.id }}"
            class="tst__track"
            role="region"
            aria-label="{{ section.settings.heading | strip_html | escape }}"
            tabindex="0"
          >
            <ul class="tst__list list-unstyled" role="list">
              {%- for block in section.blocks -%}
                <li
                  id="Slide-{{ section.id }}-{{ forloop.index }}"
                  class="tst__slide"
                  aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                  {{ block.shopify_attributes }}
                >
                  <article class="tst-card">
                    <div class="tst-card__media">
                      {%- if block.settings.image != blank -%}
                        {{
                          block.settings.image
                          | image_url: width: 900
                          | image_tag:
                            loading: 'lazy',
                            widths: '300, 450, 600, 900',
                            sizes: '(min-width: 990px) 340px, (min-width: 750px) 60vw, 80vw',
                            class: 'tst-card__image'
                        }}
                      {%- else -%}
                        {{ 'image' | placeholder_svg_tag: 'tst-card__image tst-card__image--placeholder placeholder-svg' }}
                      {%- endif -%}
                    </div>

                    {%- if block.settings.rating > 0 -%}
                      <div
                        class="tst-card__stars"
                        role="img"
                        aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: block.settings.rating, rating_max: 5 }}"
                      >
                        {%- for i in (1..block.settings.rating) -%}
                          {%- render 'product-offer-hero-icon', icon: 'star', class: 'tst-card__star' -%}
                        {%- endfor -%}
                      </div>
                    {%- endif -%}

                    {%- if block.settings.title != blank -%}
                      <h3 class="tst-card__title">{{ block.settings.title | escape }}</h3>
                    {%- endif -%}
                    {%- if block.settings.text != blank -%}
                      <p class="tst-card__text">{{ block.settings.text | escape }}</p>
                    {%- endif -%}

                    <div class="tst-card__footer">
                      <p class="tst-card__author">{{ block.settings.author | escape }}</p>
                      {%- if block.settings.verified and section.settings.verified_label != blank -%}
                        <p class="tst-card__verified">
                          {%- render 'product-offer-hero-icon', icon: 'check_circle', class: 'tst-card__verified-icon' -%}
                          <span>{{ section.settings.verified_label | escape }}</span>
                        </p>
                      {%- endif -%}
                    </div>
                  </article>
                </li>
              {%- endfor -%}
            </ul>
          </drag-scroll>
        </div>
      </testimonials-slider>
    {%- endif -%}
  </div>
</section>

