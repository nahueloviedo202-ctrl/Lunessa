{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-rail-controls.css' | asset_url | stylesheet_tag }}
{{ 'section-video-stories.css' | asset_url | stylesheet_tag }}
<script src="{{ 'centered-rail.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font

  case section.settings.heading_font_source
    when 'theme_heading'
      assign heading_ff = 'var(--font-heading-family)'
      assign heading_fs = 'var(--font-heading-style)'
    when 'theme_body'
      assign heading_ff = 'var(--font-body-family)'
      assign heading_fs = 'var(--font-body-style)'
    else
      assign heading_ff = heading_font.family | append: ', ' | append: heading_font.fallback_families
      assign heading_fs = heading_font.style
  endcase

  case section.settings.body_font_source
    when 'theme_heading'
      assign body_ff = 'var(--font-heading-family)'
      assign body_fs = 'var(--font-heading-style)'
    when 'theme_body'
      assign body_ff = 'var(--font-body-family)'
      assign body_fs = 'var(--font-body-style)'
    else
      assign body_ff = body_font.family | append: ', ' | append: body_font.fallback_families
      assign body_fs = body_font.style
  endcase

  assign slider_id = 'Slider-' | append: section.id
  assign show_arrows = false
  if section.settings.show_arrows and section.blocks.size > 1
    assign show_arrows = true
  endif

  assign rail_label = section.settings.heading | strip_html
  if rail_label == blank
    assign rail_label = 'general.slider.name' | t
  endif

  assign media_offset = section.settings.media_height_active | minus: section.settings.media_height | divided_by: 2.0
-%}

{%- style -%}
  {%- if section.settings.heading_font_source == 'custom' -%}
    {{ heading_font | font_face: font_display: 'swap' }}
    {%- assign heading_font_weighted = heading_font | font_modify: 'weight', section.settings.heading_font_weight -%}
    {%- if heading_font_weighted -%}
      {{ heading_font_weighted | font_face: font_display: 'swap' }}
    {%- endif -%}
  {%- endif -%}
  {%- if section.settings.body_font_source == 'custom' -%}
    {{ body_font | font_face: font_display: 'swap' }}
    {%- assign body_font_bold = body_font | font_modify: 'weight', '800' -%}
    {%- if body_font_bold -%}
      {{ body_font_bold | font_face: font_display: 'swap' }}
    {%- endif -%}
  {%- endif -%}

  .video-stories-{{ section.id }} {
    --vs-bg: {{ section.settings.background }};
    --vs-heading-color: {{ section.settings.heading_color }};
    --vs-highlight-color: {{ section.settings.highlight_color }};
    --vs-panel-bg: {{ section.settings.panel_background }};
    --vs-panel-color: {{ section.settings.panel_text_color }};
    --vs-button-bg: {{ section.settings.button_background }};
    --vs-button-color: {{ section.settings.button_text }};
    --vs-button-bg-hover: {{ section.settings.button_background_hover }};
    --vs-button-color-hover: {{ section.settings.button_text_hover }};
    --vs-pt: {{ section.settings.padding_top }}px;
    --vs-pb: {{ section.settings.padding_bottom }}px;
    --vs-pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --vs-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --vs-max-width: {{ section.settings.max_width }}px;
    --vs-px: {{ section.settings.padding_x }}px;
    --vs-px-mobile: {{ section.settings.padding_x_mobile }}px;
    --vs-stack-gap: {{ section.settings.stack_gap }}px;
    --vs-card-width: {{ section.settings.card_width }}px;
    --vs-gap: {{ section.settings.card_gap }}px;
    --vs-media-height: {{ section.settings.media_height }}px;
    --vs-media-height-active: {{ section.settings.media_height_active }}px;
    --vs-media-offset: {{ media_offset }}px;
    --vs-radius: {{ section.settings.radius }}px;
    --vs-heading-ff: {{ heading_ff }};
    --vs-heading-fs: {{ heading_fs }};
    --vs-heading-fw: {{ section.settings.heading_font_weight }};
    --vs-heading-size: {{ section.settings.heading_size }}px;
    --vs-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --vs-heading-tt: {% if section.settings.heading_uppercase %}uppercase{% else %}none{% endif %};
    --vs-heading-max: {{ section.settings.heading_max_width }}px;
    --vs-body-ff: {{ body_ff }};
    --vs-body-fs: {{ body_fs }};
    --rail-arrow-bg: {{ section.settings.button_background_hover }};
    --rail-arrow-color: {{ section.settings.button_text_hover }};
    --rail-arrow-bg-hover: {{ section.settings.panel_background }};
    --rail-arrow-color-hover: {{ section.settings.button_text_hover }};
    --rail-focus: {{ section.settings.highlight_color }};
  }
{%- endstyle -%}

<div class="video-stories video-stories-{{ section.id }}">
  <div class="video-stories__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="video-stories__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <centered-rail class="video-stories__rail">
        {%- render 'rail-controls', slider_id: slider_id, show_arrows: show_arrows -%}

        <ul
          id="{{ slider_id }}"
          class="slider slider--everywhere video-stories__track list-unstyled"
          role="list"
          aria-label="{{ rail_label | escape }}"
          tabindex="0"
        >
          {%- for block in section.blocks -%}
            <li
              id="Slide-{{ section.id }}-{{ forloop.index }}"
              class="slider__slide video-stories__slide"
              {% if forloop.first %}
                data-state="centre"
              {% endif %}
            >
              {%- render 'video-story-card', block: block -%}
            </li>
          {%- endfor -%}
        </ul>
      </centered-rail>
    {%- endif -%}
  </div>
</div>

