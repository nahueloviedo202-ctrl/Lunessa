{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-rail-controls.css' | asset_url | stylesheet_tag }}
{{ 'section-category-grid.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font

  case section.settings.heading_font_source
    when 'theme_heading'
      assign heading_ff = 'var(--font-heading-family)'
      assign heading_fs = 'var(--font-heading-style)'
    when 'theme_body'
      assign heading_ff = 'var(--font-body-family)'
      assign heading_fs = 'var(--font-body-style)'
    else
      assign heading_ff = heading_font.family | append: ', ' | append: heading_font.fallback_families
      assign heading_fs = heading_font.style
  endcase

  case section.settings.body_font_source
    when 'theme_heading'
      assign body_ff = 'var(--font-heading-family)'
      assign body_fs = 'var(--font-heading-style)'
    when 'theme_body'
      assign body_ff = 'var(--font-body-family)'
      assign body_fs = 'var(--font-body-style)'
    else
      assign body_ff = body_font.family | append: ', ' | append: body_font.fallback_families
      assign body_fs = body_font.style
  endcase

  assign slider_id = 'Slider-' | append: section.id
  assign is_mobile_slider = false
  if section.settings.mobile_layout == 'slider'
    assign is_mobile_slider = true
  endif

  assign show_arrows = false
  if is_mobile_slider and section.settings.show_arrows and section.blocks.size > 1
    assign show_arrows = true
  endif

  assign grid_label = section.settings.heading | strip_html
  if grid_label == blank
    assign grid_label = 'general.slider.name' | t
  endif
-%}

{%- style -%}
  {%- if section.settings.heading_font_source == 'custom' -%}
    {{ heading_font | font_face: font_display: 'swap' }}
    {%- assign heading_font_weighted = heading_font | font_modify: 'weight', section.settings.heading_font_weight -%}
    {%- if heading_font_weighted -%}
      {{ heading_font_weighted | font_face: font_display: 'swap' }}
    {%- endif -%}
  {%- endif -%}
  {%- if section.settings.body_font_source == 'custom' -%}
    {{ body_font | font_face: font_display: 'swap' }}
    {%- assign body_font_bold = body_font | font_modify: 'weight', '700' -%}
    {%- if body_font_bold -%}
      {{ body_font_bold | font_face: font_display: 'swap' }}
    {%- endif -%}
  {%- endif -%}

  .category-grid-{{ section.id }} {
    --cg-bg: {{ section.settings.background }};
    --cg-color: {{ section.settings.text_color }};
    --cg-pt: {{ section.settings.padding_top }}px;
    --cg-pb: {{ section.settings.padding_bottom }}px;
    --cg-pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --cg-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --cg-max-width: {{ section.settings.max_width }}px;
    --cg-px: {{ section.settings.padding_x }}px;
    --cg-px-mobile: {{ section.settings.padding_x_mobile }}px;
    --cg-stack-gap: {{ section.settings.stack_gap }}px;
    --cg-heading-ff: {{ heading_ff }};
    --cg-heading-fs: {{ heading_fs }};
    --cg-heading-fw: {{ section.settings.heading_font_weight }};
    --cg-heading-size: {{ section.settings.heading_size }}px;
    --cg-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --cg-heading-tt: {% if section.settings.heading_uppercase %}uppercase{% else %}none{% endif %};
    --cg-body-ff: {{ body_ff }};
    --cg-body-fs: {{ body_fs }};
    --cg-columns: {{ section.settings.columns_desktop }};
    --cg-columns-mobile: {{ section.settings.columns_mobile }};
    --cg-card-width-mobile: {{ section.settings.card_width_mobile }}px;
    --cg-gap: {{ section.settings.card_gap }}px;
    --cg-gap-mobile: {{ section.settings.card_gap_mobile }}px;
    --cg-card-height: {{ section.settings.card_height }}px;
    --cg-card-height-mobile: {{ section.settings.card_height_mobile }}px;
    --cg-footer-height: {{ section.settings.footer_height }}px;
    --cg-title-size: {{ section.settings.title_size }}px;
    --cg-arrow-size: {{ section.settings.arrow_size }}px;
    --cg-radius: {{ section.settings.radius }}px;
    --cg-border: {{ section.settings.card_border }};
    --cg-border-hover: {{ section.settings.card_border_hover }};
    --cg-footer-bg: {{ section.settings.footer_background }};
    --cg-footer-bg-hover: {{ section.settings.footer_background_hover }};
    --rail-arrow-bg: {{ section.settings.arrow_background }};
    --rail-arrow-color: {{ section.settings.arrow_color }};
    --rail-arrow-bg-hover: {{ section.settings.arrow_background_hover }};
    --rail-arrow-color-hover: {{ section.settings.arrow_color_hover }};
    --rail-focus: {{ section.settings.focus_color }};
    --rail-subheading-ff: {{ body_ff }};
    --rail-subheading-fs: {{ body_fs }};
    --rail-subheading-size: {{ section.settings.subheading_size }}px;
    --rail-subheading-size-mobile: {{ section.settings.subheading_size_mobile }}px;
  }
{%- endstyle -%}

<div class="category-grid category-grid-{{ section.id }}{% if is_mobile_slider %} category-grid--mobile-slider{% if section.settings.peek %} category-grid--peek{% endif %}{% endif %}">
  <div class="category-grid__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="category-grid__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <slider-component class="category-grid__slider">
      {%- render 'rail-controls',
        slider_id: slider_id,
        subheading: section.settings.subheading,
        show_arrows: show_arrows,
        arrows_mobile_only: true
      -%}

      <ul
        id="{{ slider_id }}"
        class="category-grid__list list-unstyled{% if is_mobile_slider %} slider slider--mobile{% endif %}"
        role="list"
        aria-label="{{ grid_label | escape }}"
        {% if is_mobile_slider %}
          tabindex="0"
        {% endif %}
      >
        {%- for block in section.blocks -%}
          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="category-grid__item{% if is_mobile_slider %} slider__slide{% endif %}"
          >
            {%- render 'category-card', block: block -%}
          </li>
        {%- endfor -%}
      </ul>
    </slider-component>
  </div>
</div>

