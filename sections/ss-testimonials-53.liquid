<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
>

{%- liquid
  assign padding_horizontal = section.settings.padding_horizontal
  assign padding_horizontal_mobile = section.settings.padding_horizontal_mobile
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign border_color = section.settings.border_color
  assign border_thickness = section.settings.border_thickness
  assign margin_top = section.settings.margin_top
  assign margin_bottom = section.settings.margin_bottom
  assign margin_horizontal_mobile = section.settings.margin_horizontal_mobile
  assign margin_horizontal = section.settings.margin_horizontal
  assign background_color = section.settings.background_color
  assign background_gradient = section.settings.background_gradient
  assign width = section.settings.width
  assign content_width = section.settings.content_width
  assign section_radius = section.settings.section_radius
  assign background_style = section.settings.background_style

  assign cards_per_row = section.settings.cards_per_row
  assign cards_per_row_mobile = section.settings.cards_per_row_mobile
  assign cards_gap = section.settings.cards_gap
  assign cards_gap_mobile = section.settings.cards_gap_mobile

  assign cards_blocks_count = section.blocks.size
  assign cards_per_row_visible = cards_per_row
  assign cards_per_row_mobile_visible = cards_per_row_mobile
  if cards_blocks_count > 0
    if cards_per_row > cards_blocks_count
      assign cards_per_row_visible = cards_blocks_count
    endif
    if cards_per_row_mobile > cards_blocks_count
      assign cards_per_row_mobile_visible = cards_blocks_count
    endif
  endif

  assign card_border_thickness = section.settings.card_border_thickness
  assign card_radius = section.settings.card_radius
  assign card_padding_vertical = section.settings.card_padding_vertical
  assign card_padding_vertical_mobile = section.settings.card_padding_vertical_mobile
  assign card_padding_horizontal = section.settings.card_padding_horizontal
  assign card_padding_horizontal_mobile = section.settings.card_padding_horizontal_mobile
  assign card_border_color = section.settings.card_border_color

  assign image_ratio = section.settings.image_ratio
  assign image_ratio_mobile = section.settings.image_ratio_mobile

  assign arrow_size = section.settings.arrow_size
  assign arrow_size_mobile = section.settings.arrow_size_mobile
  assign arrow_icon_size = section.settings.arrow_icon_size
  assign arrow_icon_size_mobile = section.settings.arrow_icon_size_mobile
  assign arrow_color = section.settings.arrow_color
  assign arrow_hover_color = section.settings.arrow_hover_color
  assign arrow_bg_color = section.settings.arrow_bg_color
  assign arrow_bg_hover_color = section.settings.arrow_bg_hover_color
  assign arrow_radius = section.settings.arrow_radius
  assign arrow_border_thickness = section.settings.arrow_border_thickness
  assign arrow_border_color = section.settings.arrow_border_color
  assign arrow_border_hover_color = section.settings.arrow_border_hover_color
  assign arrow_show_desktop = section.settings.arrow_show_desktop
  assign arrow_show_mobile = section.settings.arrow_show_mobile
  assign arrow_hover_effect = section.settings.arrow_hover_effect

  assign content_align = section.settings.content_align
  assign content_align_mobile = section.settings.content_align_mobile

  assign content_horizontal_align = ''
  if content_align == 'center'
    assign content_horizontal_align = 'center'
  elsif content_align == 'right'
    assign content_horizontal_align = 'end'
  else
    assign content_horizontal_align = 'start'
  endif

  assign content_horizontal_align_mobile = ''
  if content_align_mobile == 'center'
    assign content_horizontal_align_mobile = 'center'
  elsif content_align_mobile == 'right'
    assign content_horizontal_align_mobile = 'end'
  else
    assign content_horizontal_align_mobile = 'start'
  endif

  assign stars_size = section.settings.stars_size
  assign stars_size_mobile = section.settings.stars_size_mobile
  assign stars_gap = section.settings.stars_gap
  assign stars_color = section.settings.stars_color
  assign stars_bg_color = section.settings.stars_bg_color
  assign stars_bg_half_color = section.settings.stars_bg_half_color

  assign text_custom = section.settings.text_custom
  assign text_font = section.settings.text_font
  assign text_size = section.settings.text_size
  assign text_size_mobile = section.settings.text_size_mobile
  assign text_mt = section.settings.text_mt
  assign text_mt_mobile = section.settings.text_mt_mobile
  assign text_height = section.settings.text_height
  assign text_color = section.settings.text_color

  assign name_mt = section.settings.name_mt
  assign name_mt_mobile = section.settings.name_mt_mobile

  assign name_icon_size = section.settings.name_icon_size
  assign name_icon_color = section.settings.name_icon_color
  assign name_icon_size_mobile = section.settings.name_icon_size_mobile

  assign name_text_custom = section.settings.name_text_custom
  assign name_text_font = section.settings.name_text_font
  assign name_text_size = section.settings.name_text_size
  assign name_text_size_mobile = section.settings.name_text_size_mobile
  assign name_text_color = section.settings.name_text_color
  assign name_text_height = section.settings.name_text_height
-%}

{%- style -%}
  .section-{{ section.id }} {
    border-top: solid {{ border_color }} {{ border_thickness }}px;
    border-bottom: solid {{ border_color }} {{ border_thickness }}px;
    margin-top: {{ margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ margin_bottom | times: 0.75 | round: 0 }}px;
    margin-left: {{ margin_horizontal_mobile }}rem;
    margin-right: {{ margin_horizontal_mobile }}rem;
    border-radius: {{ section_radius | times: 0.6 | round: 0 }}px;
    overflow: hidden;
  }

  .section-{{ section.id }}-settings {
    margin: 0 auto;
    padding-top: {{ padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ padding_bottom | times: 0.75 | round: 0 }}px;
    padding-left: {{ padding_horizontal_mobile }}rem;
    padding-right: {{ padding_horizontal_mobile }}rem;
  }

  .testimonial-slider-{{ section.id }} {
    width: 100%;
    overflow: hidden;
  }

  @media(max-width: 1023px) {
    .testimonial-slider-{{ section.id }} {
      width: auto;
      margin-left: -{{ padding_horizontal_mobile }}rem;
      margin-right: -{{ padding_horizontal_mobile }}rem;
      padding-left: {{ padding_horizontal_mobile }}rem;
      padding-right: {{ padding_horizontal_mobile }}rem;
      overflow: visible !important;
    }

    .testimonial-slider-{{ section.id }} .swiper-wrapper {
      overflow: visible !important;
    }
  }

  .testimonial-slider-{{ section.id }}:not(.swiper-initialized) .swiper-wrapper {
    display: flex;
    gap: {{ cards_gap_mobile }}px;
  }

  .testimonial-slider-{{ section.id }}:not(.swiper-initialized) .swiper-slide {
    flex: 0 0 calc((100% - {{ cards_gap_mobile | times: cards_per_row_mobile_visible | minus: cards_gap_mobile }}px) / {{ cards_per_row_mobile_visible }});
    width: calc((100% - {{ cards_gap_mobile | times: cards_per_row_mobile_visible | minus: cards_gap_mobile }}px) / {{ cards_per_row_mobile_visible }});
  }

  .testimonial-card-{{ section.id }} {
    position: relative;
    isolation: isolate;
    display: grid !important;
    grid-template-rows: 1fr;
    grid-template-columns: 1fr;
    box-sizing: border-box;
    overflow: hidden;
    border: {{ card_border_thickness }}px solid {{ card_border_color }};
    border-radius: {{ card_radius }}px;
  }

  .testimonial-card-image-{{ section.id }} {
    grid-area: 1 / 1;
  }

  .testimonial-card-image-{{ section.id }} img,
  .testimonial-card-image-{{ section.id }} svg {
    display: flex;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .testimonial-card-image-{{ section.id }} svg {
    background-color: #f3f3f3;
  }

  .testimonial-card-{{ section.id }}::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0) 45%, rgba(0, 0, 0, 0.65) 75%, #000 100%);
    pointer-events: none;
  }

  .testimonial-card-content-{{ section.id }} {
    grid-area: 1 / 1;
    align-self: end;
    position: relative;
    z-index: 2;
    padding: {{ card_padding_vertical_mobile }}px {{ card_padding_horizontal_mobile }}px;
  }

  .testimonials-btns-{{ section.id }} {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 40px;
  }

  .testimonials-btn-prev-{{ section.id }},
  .testimonials-btn-next-{{ section.id }} {
    display: flex;
    flex-shrink: 0;
    width: {{ arrow_size_mobile }}px;
    height: {{ arrow_size_mobile }}px;
    border: {{ arrow_border_thickness }}px solid {{ arrow_border_color }};
    border-radius: {{ arrow_radius }}px;
    background: transparent;
    background: {{ arrow_bg_color }};
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease 0s;
    cursor: pointer;
    -webkit-appearance: none;
  }

  .testimonials-btn-prev-{{ section.id }} .animate-icon,
  .testimonials-btn-next-{{ section.id }} .animate-icon {
    pointer-events: none;
    place-items: center;
    display: grid;
  }

  .testimonials-btn-prev-{{ section.id }} .animate-icon:before,
  .testimonials-btn-next-{{ section.id }} .animate-icon:before {
    content: "";
    grid-area: 1 / -1;
    transition: all .2s ease;
    width: {{ arrow_icon_size_mobile }}px;
    height: {{ arrow_icon_size_mobile }}px;
    transform: rotate(calc(1 * 45deg));
    box-sizing: border-box;
    border-style: solid;
    border: 0px;
    border-right: 2px solid currentColor;
    border-top: 2px solid currentColor;
    position: relative;
    left: -1px;
  }

  .testimonials-btn-prev-{{ section.id }} .animate-icon:before {
    left: unset;
    right: -1px;
    border-right: 0px;
    border-top: 0px;
    border-bottom: 2px solid currentColor;
    border-left: 2px solid currentColor;
  }

  .testimonials-btn-prev-{{ section.id }} .animate-icon:after,
  .testimonials-btn-next-{{ section.id }} .animate-icon:after {
    content: "";
    grid-area: 1 / -1;
    transition: all .2s ease;
    width: {{ arrow_icon_size_mobile | minus: 0.3 }}px;
    height: 1.6px;
    transform-origin: center;
    opacity: 0;
    background: currentColor;
    transform: scaleX(.5);
  }

  .testimonials-btn-prev-{{ section.id }} span,
  .testimonials-btn-next-{{ section.id }} span {
    color: {{ arrow_color }};
  }

  .testimonials-btn-prev-{{ section.id }}.swiper-button-disabled,
  .testimonials-btn-next-{{ section.id }}.swiper-button-disabled {
    opacity: 0.5;
    cursor: default;
  }

  .testimonials-btn-prev-{{ section.id }}.swiper-button-lock,
  .testimonials-btn-next-{{ section.id }}.swiper-button-lock {
    opacity: 0;
    pointer-events: none;
  }

  .testimonial-review-{{ section.id }} {
    text-align: {{ content_align_mobile }};
  }

  .testimonial-stars-wrapper-{{ section.id }} {
    display: flex;
    align-items: center;
    justify-content: {{ content_align_mobile }};
    gap: 10px;
  }

  .testimonial-stars-{{ section.id }} {
    display: flex;
    align-items: center;
    gap: {{ stars_gap }}px;
    max-width: fit-content;
  }

  .testimonial-stars-{{ section.id }} svg,
  .testimonial-stars-{{ section.id }} img {
    display: block;
    width: {{ stars_size_mobile }}px;
    height: {{ stars_size_mobile }}px;
    object-fit: cover;
  }



  .testimonial-text-{{ section.id }} {
    margin-top: {{ text_mt_mobile }}px;
    text-align: {{ content_align_mobile }};
  }

  .testimonial-text-{{ section.id }} * {
    margin: 0px;
    font-size: {{ text_size_mobile }}px;
    line-height: {{ text_height }}%;
    color: {{ text_color }};
    text-transform: unset;
    text-decoration: none;
    word-break: break-word;
  }

  .testimonial-name-{{ section.id }} {
    display: flex;
    align-items: center;
    justify-content: {{ content_horizontal_align_mobile }};
    gap: 6px;
    margin-top: {{ name_mt_mobile }}px;
    position: relative;
    z-index: 1;
  }

  .testimonial-name-icon-{{ section.id }} {
    flex-shrink: 0;
    height: {{ name_icon_size_mobile }}px;
    width: {{ name_icon_size_mobile }}px;
    color: {{ name_icon_color }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .testimonial-name-icon-{{ section.id }} img,
  .testimonial-name-icon-{{ section.id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .testimonial-name-text-{{ section.id }} {
    margin: 0;
    font-size: {{ name_text_size_mobile }}px;
    color: {{ name_text_color }};
    line-height: {{ name_text_height }}%;
    text-transform: unset;
    text-decoration: none;
    word-break: break-word;
  }

  @media(min-width: 768px) {
    .testimonial-slider-{{ section.id }}:not(.swiper-initialized) .swiper-wrapper {
      gap: {{ cards_gap }}px;
    }

    .testimonial-slider-{{ section.id }}:not(.swiper-initialized) .swiper-slide {
      flex-basis: calc((100% - {{ cards_gap | times: cards_per_row_visible | minus: cards_gap }}px) / {{ cards_per_row_visible }});
      width: calc((100% - {{ cards_gap | times: cards_per_row_visible | minus: cards_gap }}px) / {{ cards_per_row_visible }});
    }
  }

  @media(min-width: 1024px) {

    .section-{{ section.id }} {
      margin-top: {{ margin_top }}px;
      margin-bottom: {{ margin_bottom }}px;
      margin-left: {{ margin_horizontal }}rem;
      margin-right: {{ margin_horizontal }}rem;
      border-radius: {{ section_radius }}px;
    }

    .section-{{ section.id }}-settings {
      padding: 0 5rem;
      padding-top: {{ padding_top }}px;
      padding-bottom: {{ padding_bottom }}px;
      padding-left: {{ padding_horizontal }}rem;
      padding-right: {{ padding_horizontal }}rem;
    }

    .testimonial-card-content-{{ section.id }} {
      padding: {{ card_padding_vertical }}px {{ card_padding_horizontal }}px;
    }

    .testimonials-btn-prev-{{ section.id }},
    .testimonials-btn-next-{{ section.id }} {
      width: {{ arrow_size }}px;
      height: {{ arrow_size }}px;
      transition: all 0.25s ease 0s;
    }

    .testimonials-btn-prev-{{ section.id }} .animate-icon:before,
    .testimonials-btn-next-{{ section.id }} .animate-icon:before {
      width: {{ arrow_icon_size }}px;
      height: {{ arrow_icon_size }}px;
    }

    .testimonials-btn-prev-{{ section.id }} .animate-icon:after,
    .testimonials-btn-next-{{ section.id }} .animate-icon:after {
      width: {{ arrow_icon_size | minus: 0.3 }}px;
    }

    .testimonial-review-{{ section.id }} {
      text-align: {{ content_align }};
    }

    .testimonial-stars-wrapper-{{ section.id }} {
      justify-content: {{ content_align }};
    }

    .testimonial-stars-{{ section.id }} svg,
    .testimonial-stars-{{ section.id }} img {
      width: {{ stars_size }}px;
      height: {{ stars_size }}px;
    }



    .testimonial-text-{{ section.id }} {
      margin-top: {{ text_mt }}px;
      text-align: {{ content_align }};
    }

    .testimonial-text-{{ section.id }} * {
      font-size: {{ text_size }}px;
    }

    .testimonial-name-{{ section.id }} {
      margin-top: {{ name_mt }}px;
      justify-content: {{ content_horizontal_align }};
     }

    .testimonial-name-icon-{{ section.id }} {
      height: {{ name_icon_size }}px;
      width: {{ name_icon_size }}px;
    }

    .testimonial-name-text-{{ section.id }} {
      font-size: {{ name_text_size }}px;
    }
  }
{%- endstyle -%}

{% if width == 'custom' %}
  <style>
    .section-{{ section.id }}-settings {
      max-width: {{ content_width }}px;
    }
  </style>
{% elsif width == 'page' %}
  <style>
    .section-{{ section.id }}-settings {
      max-width: clamp(100px, var(--page-content-width, var(--page-width)), 100%);
    }
  </style>
{% endif %}

{% if margin_horizontal_mobile > 0 %}
  <style>
    .section-{{ section.id }} {
      border-left: solid {{ border_color }} {{ border_thickness }}px;
      border-right: solid {{ border_color }} {{ border_thickness }}px;
    }

    @media(min-width: 1024px) {
      .section-{{ section.id }} {
        border-left: 0px;
        border-right: 0px;
      }
    }
  </style>
{% endif %}

{% if margin_horizontal > 0 %}
  <style>
    @media(min-width: 1024px) {
      .section-{{ section.id }} {
        border-left: solid {{ border_color }} {{ border_thickness }}px;
        border-right: solid {{ border_color }} {{ border_thickness }}px;
      }
    }
  </style>
{% endif %}

{% if text_custom %}
  <style>
    {{ text_font | font_face: font_display: 'swap' }}

    .testimonial-text-{{ section.id }} {
      font-family: {{ text_font.family }}, {{ text_font.fallback_families }};
      font-weight: {{ text_font.weight }};
      font-style: {{ text_font.style }};
    }
  </style>
{% endif %}

{% if name_text_custom %}
  <style>
    {{ name_text_font | font_face: font_display: 'swap' }}

    .testimonial-name-text-{{ section.id }} {
      font-family: {{ name_text_font.family }}, {{ name_text_font.fallback_families }};
      font-weight: {{ name_text_font.weight }};
      font-style: {{ name_text_font.style }};
    }
  </style>
{% endif %}

<style>
  .testimonial-card-image-{{ section.id }} {
    aspect-ratio: {{ image_ratio_mobile }};
  }

  @media (min-width: 1024px) {
    .testimonial-card-image-{{ section.id }} {
      aspect-ratio: {{ image_ratio }};
    }
  }
</style>

{% if arrow_hover_effect == 'color' %}
  <style>
    .testimonials-btn-prev-{{ section.id }}:hover,
    .testimonials-btn-next-{{ section.id }}:hover {
      transition: all 0.3s ease 0s;
      border: {{ arrow_border_thickness }}px solid {{ arrow_border_hover_color }};
      background: {{ arrow_bg_hover_color }};
    }

    .testimonials-btn-prev-{{ section.id }}:hover .animate-icon,
    .testimonials-btn-next-{{ section.id }}:hover .animate-icon {
      color: {{ arrow_hover_color }};
    }
  </style>
{% elsif arrow_hover_effect == 'scale' %}
  <style>
    .testimonials-btn-prev-{{ section.id }}:hover,
    .testimonials-btn-next-{{ section.id }}:hover {
      transform: scale(0.9);
    }

    @media(min-width: 1024px) {
      .testimonials-btn-prev-{{ section.id }}:hover,
      .testimonials-btn-next-{{ section.id }}:hover {
        transform: scale(0.9);
      }
    }
  </style>
{% elsif arrow_hover_effect == 'arrow' %}
  <style>
    .testimonials-btn-next-{{ section.id }}:hover .animate-icon:before {
      transform: translate(calc(1 * 0.125rem)) rotate(calc(1 * 45deg));
    }

    .testimonials-btn-prev-{{ section.id }}:hover .animate-icon:before {
      transform: translate(calc(-1 * 0.125rem)) rotate(calc(1 * 45deg));
    }

    .testimonials-btn-prev-{{ section.id }}:hover .animate-icon:after,
    .testimonials-btn-next-{{ section.id }}:hover .animate-icon:after {
      opacity: 1;
      transform: scaleX(1);
    }
  </style>
{% endif %}

{% if arrow_show_mobile %}
  <style>
    .testimonials-btns-{{ section.id }},
    .testimonials-btn-prev-{{ section.id }},
    .testimonials-btn-next-{{ section.id }} {
      display: flex;
    }
  </style>
{% else %}
  <style>
    .testimonials-btns-{{ section.id }},
    .testimonials-btn-prev-{{ section.id }},
    .testimonials-btn-next-{{ section.id }}  {
      display: none;
    }
  </style>
{% endif %}

{% if arrow_show_desktop %}
  <style>
    @media(min-width: 1024px) {
      .testimonials-btns-{{ section.id }},
      .testimonials-btn-prev-{{ section.id }},
      .testimonials-btn-next-{{ section.id }}  {
        display: flex;
      }
    }
  </style>
{% else %}
  <style>
    @media(min-width: 1024px) {
      .testimonials-btns-{{ section.id }},
      .testimonials-btn-prev-{{ section.id }},
      .testimonials-btn-next-{{ section.id }}  {
        display: none;
      }
    }
  </style>
{% endif %}

{% if content_align_mobile == 'right' %}
  <style>
    .testimonial-name-{{ section.id }} {
      flex-direction: row-reverse;
    }
  </style>
{% else %}
  <style>
    .testimonial-name-{{ section.id }} {
      flex-direction: row;
    }
  </style>
{% endif %}

{% if content_align == 'right' %}
  <style>
    @media(min-width: 1024px) {
      .testimonial-name-{{ section.id }} {
        flex-direction: row-reverse;
      }
    }
  </style>
{% else %}
  <style>
    @media(min-width: 1024px) {
    .testimonial-name-{{ section.id }} {
      flex-direction: row;
    }
    }
  </style>
{% endif %}

{%- capture author_icon_sizes -%}(min-width: 1024px) {{ name_icon_size }}px, {{ name_icon_size_mobile }}px{%- endcapture -%}

{% capture verified_icon %}
  {%- if section.settings.verified_icon == 'custom' and section.settings.custom_icon != blank -%}
    {{
      section.settings.custom_icon
      | image_url: width: 200
      | image_tag: widths: '20, 40, 60, 80, 100, 150, 200', sizes: author_icon_sizes, alt: ''
    }}
  {%- else -%}
    {%- case section.settings.verified_icon -%}
      {%- when '2' -%}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill-rule="evenodd" clip-rule="evenodd" d="M24 2C11.8497 2 2 11.8497 2 24C2 36.1503 11.8497 46 24 46C36.1503 46 46 36.1503 46 24C46 11.8497 36.1503 2 24 2ZM20.1078 34.2289L36.1117 14.7957L33.7959 12.8885L19.8926 29.7711L14.0002 23.8787L11.8789 26L20.1078 34.2289Z" fill="currentColor"/></svg>
      {%- when '3' -%}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" fill="currentColor"/></svg>
      {%- when '4' -%}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9.5" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M7.5 12.5l3 3 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
      {%- when '5' -%}
