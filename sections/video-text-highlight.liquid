{{ 'section-video-text-highlight.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font

  case section.settings.heading_font_source
    when 'theme_heading'
      assign heading_ff = 'var(--font-heading-family)'
      assign heading_fs = 'var(--font-heading-style)'
    when 'theme_body'
      assign heading_ff = 'var(--font-body-family)'
      assign heading_fs = 'var(--font-body-style)'
    else
      assign heading_ff = heading_font.family | append: ', ' | append: heading_font.fallback_families
      assign heading_fs = heading_font.style
  endcase

  case section.settings.body_font_source
    when 'theme_heading'
      assign body_ff = 'var(--font-heading-family)'
      assign body_fs = 'var(--font-heading-style)'
    when 'theme_body'
      assign body_ff = 'var(--font-body-family)'
      assign body_fs = 'var(--font-body-style)'
    else
      assign body_ff = body_font.family | append: ', ' | append: body_font.fallback_families
      assign body_fs = body_font.style
  endcase

  assign media_columns = 12 | minus: section.settings.content_columns
  assign icon_text_columns_mobile = 12 | minus: section.settings.icon_columns_mobile

  assign text_blocks = section.blocks | where: 'type', 'text'
  assign highlight_blocks = section.blocks | where: 'type', 'highlight'
-%}

{%- style -%}
  {% if section.settings.heading_font_source == 'custom' %}
    {%- assign heading_font_weighted = heading_font | font_modify: 'weight', section.settings.heading_font_weight | default: heading_font -%}
    {{ heading_font_weighted | font_face: font_display: 'swap' }}
  {% endif %}
  {% if section.settings.body_font_source == 'custom' %}
    {{ body_font | font_face: font_display: 'swap' }}
    {%- assign body_font_bold = body_font | font_modify: 'weight', 'bold' -%}
    {{ body_font_bold | font_face: font_display: 'swap' }}
    {%- assign body_font_italic = body_font | font_modify: 'style', 'italic' -%}
    {{ body_font_italic | font_face: font_display: 'swap' }}
    {%- assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic' -%}
    {{ body_font_bold_italic | font_face: font_display: 'swap' }}
  {% endif %}

  .video-text-highlight-{{ section.id }} {
    --vth-bg: {{ section.settings.background_color }};
    --vth-bg-mobile: {{ section.settings.background_color_mobile }};
    --vth-pt: {{ section.settings.padding_top }}px;
    --vth-pb: {{ section.settings.padding_bottom }}px;
    --vth-px: {{ section.settings.padding_x }}px;
    --vth-pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --vth-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --vth-px-mobile: {{ section.settings.padding_x_mobile }}px;
    --vth-max-width: {{ section.settings.max_width }}px;
    --vth-content-fr: {{ section.settings.content_columns }}fr;
    --vth-media-fr: {{ media_columns }}fr;
    --vth-column-gap: {{ section.settings.column_gap }}px;
    --vth-heading-ff: {{ heading_ff }};
    --vth-heading-fs: {{ heading_fs }};
    --vth-heading-fw: {{ section.settings.heading_font_weight }};
    --vth-heading-color: {{ section.settings.heading_color }};
    --vth-heading-size: {{ section.settings.heading_size }}px;
    --vth-heading-size-tablet: {{ section.settings.heading_size_tablet }}px;
    --vth-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --vth-heading-lh: {{ section.settings.heading_line_height }}%;
    --vth-heading-lh-tablet: {{ section.settings.heading_line_height_tablet }}%;
    --vth-heading-lh-mobile: {{ section.settings.heading_line_height_mobile }}%;
    --vth-heading-align: {{ section.settings.heading_alignment }};
    --vth-heading-align-mobile: {{ section.settings.heading_alignment_mobile }};
    --vth-heading-mb: {{ section.settings.heading_margin_bottom }}px;
    --vth-heading-mb-mobile: {{ section.settings.heading_margin_bottom_mobile }}px;
    --vth-body-ff: {{ body_ff }};
    --vth-body-fs: {{ body_fs }};
    --vth-text-color: {{ section.settings.text_color }};
    --vth-text-size: {{ section.settings.text_size }}px;
    --vth-text-size-tablet: {{ section.settings.text_size_tablet }}px;
    --vth-text-size-mobile: {{ section.settings.text_size_mobile }}px;
    --vth-text-lh: {{ section.settings.text_line_height }}%;
    --vth-text-lh-tablet: {{ section.settings.text_line_height_tablet }}%;
    --vth-text-lh-mobile: {{ section.settings.text_line_height_mobile }}%;
    --vth-text-ls: {{ section.settings.text_letter_spacing }}px;
    --vth-text-align: {{ section.settings.text_alignment }};
    --vth-text-spacing: {{ section.settings.paragraph_spacing }}px;
    --vth-text-spacing-mobile: {{ section.settings.paragraph_spacing_mobile }}px;
    --vth-video-radius: {{ section.settings.video_radius }}px;
    --vth-video-mt-mobile: {{ section.settings.video_margin_top_mobile }}px;
    {%- if section.settings.highlight_background_image != blank %}
      --vth-hl-bg-image: url('{{ section.settings.highlight_background_image | image_url: width: 1500 }}');
    {%- else %}
      --vth-hl-bg-image: none;
    {%- endif %}
    --vth-hl-bg: {{ section.settings.highlight_background_color }};
    --vth-hl-bg-mobile: {{ section.settings.highlight_background_color_mobile }};
    --vth-hl-border: {{ section.settings.highlight_border_width }}px solid {{ section.settings.highlight_border_color }};
    --vth-hl-border-mobile: {{ section.settings.highlight_border_width_mobile }}px solid {{ section.settings.highlight_border_color }};
    --vth-hl-radius: {{ section.settings.highlight_radius }}px;
    --vth-hl-radius-mobile: {{ section.settings.highlight_radius_mobile }}px;
    --vth-hl-padding: {{ section.settings.highlight_padding }}px;
    --vth-hl-py-mobile: {{ section.settings.highlight_padding_y_mobile }}px;
    --vth-hl-px-mobile: {{ section.settings.highlight_padding_x_mobile }}px;
    --vth-hl-mt: {{ section.settings.highlight_margin_top }}px;
    --vth-hl-mt-mobile: {{ section.settings.highlight_margin_top_mobile }}px;
    --vth-hl-gap: {{ section.settings.highlight_gap }}px;
    --vth-hl-icon-size: {{ section.settings.icon_size }}px;
    --vth-hl-icon-size-mobile: {{ section.settings.icon_size_mobile }}px;
    --vth-hl-icon-fr-mobile: {{ section.settings.icon_columns_mobile }}fr;
    --vth-hl-body-fr-mobile: {{ icon_text_columns_mobile }}fr;
    --vth-hl-icon-offset-mobile: {{ section.settings.icon_offset_mobile }}px;
    --vth-hl-color: {{ section.settings.highlight_text_color }};
    --vth-hl-title-size: {{ section.settings.highlight_title_size }}px;
    --vth-hl-title-size-tablet: {{ section.settings.highlight_title_size_tablet }}px;
    --vth-hl-title-size-mobile: {{ section.settings.highlight_title_size_mobile }}px;
    --vth-hl-title-lh: {{ section.settings.highlight_title_line_height }}%;
    --vth-hl-title-lh-mobile: {{ section.settings.highlight_title_line_height_mobile }}%;
    --vth-hl-title-ls-mobile: {{ section.settings.highlight_title_letter_spacing_mobile }}px;
    --vth-hl-text-size: {{ section.settings.highlight_text_size }}px;
    --vth-hl-text-size-tablet: {{ section.settings.highlight_text_size_tablet }}px;
    --vth-hl-text-size-mobile: {{ section.settings.highlight_text_size_mobile }}px;
    --vth-hl-text-lh: {{ section.settings.highlight_text_line_height }}%;
    --vth-hl-text-lh-tablet: {{ section.settings.highlight_text_line_height_tablet }}%;
    --vth-hl-text-lh-mobile: {{ section.settings.highlight_text_line_height_mobile }}%;
    --vth-hl-text-ls: {{ section.settings.highlight_text_letter_spacing }}px;
  }
{%- endstyle -%}

<div class="video-text-highlight video-text-highlight-{{ section.id }}">
  <div class="video-text-highlight__inner{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    {%- if section.settings.heading != blank -%}
      <h2 class="video-text-highlight__heading">{{ section.settings.heading | escape | newline_to_br }}</h2>
    {%- endif -%}

    {%- if text_blocks.size > 0 -%}
      <div class="video-text-highlight__texts">
        {%- for block in text_blocks -%}
          <p class="video-text-highlight__text" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="video-text-highlight__media">
      {%- if section.settings.video != blank -%}
        {{
          section.settings.video
          | video_tag:
            image_size: '1100x',
            autoplay: section.settings.video_autoplay,
            loop: section.settings.video_loop,
            controls: section.settings.video_controls,
            muted: true,
            playsinline: true,
            preload: 'metadata',
            title: section.settings.video_description,
            class: 'video-text-highlight__video'
        }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg video-text-highlight__video' }}
      {%- endif -%}
    </div>

    {%- if highlight_blocks.size > 0 -%}
      <div class="video-text-highlight__highlights">
        {%- for block in highlight_blocks -%}
          <div
            class="video-text-highlight__highlight{% unless block.settings.show_icon %} video-text-highlight__highlight--no-icon{% endunless %}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.show_icon -%}
              <div class="video-text-highlight__icon">
                {%- if block.settings.icon_image != blank -%}
                  {{
                    block.settings.icon_image
                    | image_url: width: 160
                    | image_tag: loading: 'lazy', widths: '80, 160', sizes: '80px', alt: ''
                  }}
                {%- else -%}
                  {{ 'icon-shield-heart.svg' | inline_asset_content }}
                {%- endif -%}
              </div>
            {%- endif -%}
            <div class="video-text-highlight__highlight-body">
              {%- if block.settings.title != blank -%}
                <p class="video-text-highlight__highlight-title">{{ block.settings.title }}</p>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="video-text-highlight__highlight-text{% if block.settings.text_mobile != blank %} video-text-highlight__highlight-text--desktop{% endif %}">
                  {{- block.settings.text -}}
                </p>
              {%- endif -%}
              {%- if block.settings.text_mobile != blank -%}
                <p class="video-text-highlight__highlight-text video-text-highlight__highlight-text--mobile">
                  {{- block.settings.text_mobile -}}
                </p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Video con destacado",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo en escritorio y tablet",
      "default": "#F9F9F7"
    },
    {
      "type": "color",
      "id": "background_color_mobile",
      "label": "Color de fondo en móvil",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Ancho máximo",
      "min": 600,
      "max": 1600,
      "step": 10,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "content_columns",
      "label": "Columnas del texto (de 12)",
      "info": "Escritorio y tablet. El resto es para el video.",
      "min": 3,
      "max": 9,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Separación entre columnas",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 50
    },
    {
      "type": "header",
      "content": "Título"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Título",
      "default": "Esto Es Lo Que\nRealmente Causa Tu Caída\n(No Es Genética)"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color",
      "default": "#6B0011"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Tamaño en escritorio",
      "min": 12,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "heading_size_tablet",
      "label": "Tamaño en tablet",
      "min": 12,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Tamaño en móvil",
      "min": 12,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "range",
      "id": "heading_line_height",
      "label": "Interlineado en escritorio",
      "min": 80,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 130
    },
    {
      "type": "range",
      "id": "heading_line_height_tablet",
      "label": "Interlineado en tablet",
      "min": 80,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 180
    },
    {
      "type": "range",
      "id": "heading_line_height_mobile",
      "label": "Interlineado en móvil",
      "min": 80,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 130
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Alineación en escritorio y tablet",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "heading_alignment_mobile",
      "label": "Alineación en móvil",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_margin_bottom",
      "label": "Espacio inferior en escritorio y tablet",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "heading_margin_bottom_mobile",
      "label": "Espacio inferior en móvil",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 5
    },
    {
      "type": "header",
      "content": "Párrafos"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color",
      "default": "#151515"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Tamaño en escritorio",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "text_size_tablet",
      "label": "Tamaño en tablet",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "Tamaño en móvil",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "text_line_height",
      "label": "Interlineado en escritorio",
      "min": 80,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 150
    },
    {
      "type": "range",
      "id": "text_line_height_tablet",
      "label": "Interlineado en tablet",
      "min": 80,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 180
    },
    {
      "type": "range",
      "id": "text_line_height_mobile",
      "label": "Interlineado en móvil",
      "min": 80,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 150
    },
    {
      "type": "range",
      "id": "text_letter_spacing",
      "label": "Espaciado entre letras",
      "min": -2,
      "max": 2,
      "step": 0.1,
      "unit": "px",
      "default": -0.4
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alineación",
