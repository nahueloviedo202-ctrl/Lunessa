{{ 'section-science-datablock.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font

  case section.settings.heading_font_source
    when 'theme_heading'
      assign heading_ff = 'var(--font-heading-family)'
      assign heading_fs = 'var(--font-heading-style)'
    when 'theme_body'
      assign heading_ff = 'var(--font-body-family)'
      assign heading_fs = 'var(--font-body-style)'
    else
      assign heading_ff = heading_font.family | append: ', ' | append: heading_font.fallback_families
      assign heading_fs = heading_font.style
  endcase

  case section.settings.body_font_source
    when 'theme_heading'
      assign body_ff = 'var(--font-heading-family)'
      assign body_fs = 'var(--font-heading-style)'
    when 'theme_body'
      assign body_ff = 'var(--font-body-family)'
      assign body_fs = 'var(--font-body-style)'
    else
      assign body_ff = body_font.family | append: ', ' | append: body_font.fallback_families
      assign body_fs = body_font.style
  endcase

  assign animate_bars = false
  if settings.animations_reveal_on_scroll and section.settings.animate_bars
    assign animate_bars = true
  endif

  case section.settings.scale_steps
    when '3'
      assign scale_step = 50
    when '6'
      assign scale_step = 20
    else
      assign scale_step = 25
  endcase
  assign scale_ticks = 100 | divided_by: scale_step
-%}

{%- style -%}
  {% if section.settings.heading_font_source == 'custom' %}
    {%- assign heading_font_weighted = heading_font | font_modify: 'weight', section.settings.heading_font_weight | default: heading_font -%}
    {{ heading_font_weighted | font_face: font_display: 'swap' }}
  {% endif %}
  {% if section.settings.body_font_source == 'custom' %}
    {{ body_font | font_face: font_display: 'swap' }}
    {%- assign body_font_bold = body_font | font_modify: 'weight', 'bold' -%}
    {{ body_font_bold | font_face: font_display: 'swap' }}
    {%- assign body_font_italic = body_font | font_modify: 'style', 'italic' -%}
    {{ body_font_italic | font_face: font_display: 'swap' }}
  {% endif %}

  .sdb--{{ section.id }} {
    --sdb-bg: {{ section.settings.background_color }};
    --sdb-max-width: {{ section.settings.max_width }}px;
    --sdb-pt: {{ section.settings.padding_top }}px;
    --sdb-pb: {{ section.settings.padding_bottom }}px;
    --sdb-px: {{ section.settings.padding_x }}px;
    --sdb-pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --sdb-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --sdb-px-mobile: {{ section.settings.padding_x_mobile }}px;
    --sdb-stack-gap: {{ section.settings.stack_gap }}px;
    --sdb-stack-gap-mobile: {{ section.settings.stack_gap_mobile }}px;
    --sdb-group-gap: {{ section.settings.group_gap }}px;
    --sdb-group-gap-mobile: {{ section.settings.group_gap_mobile }}px;

    --sdb-heading-ff: {{ heading_ff }};
    --sdb-heading-fs: {{ heading_fs }};
    --sdb-heading-fw: {{ section.settings.heading_font_weight }};
    --sdb-heading-tt: {% if section.settings.heading_uppercase %}uppercase{% else %}none{% endif %};
    --sdb-heading-color: {{ section.settings.heading_color }};
    --sdb-heading-size: {{ section.settings.heading_size }}px;
    --sdb-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --sdb-body-ff: {{ body_ff }};
    --sdb-body-fs: {{ body_fs }};

    --sdb-group-inner-gap: {{ section.settings.group_inner_gap }}px;
    --sdb-group-inner-gap-mobile: {{ section.settings.group_inner_gap_mobile }}px;
    --sdb-title-color: {{ section.settings.title_color }};
    --sdb-title-size: {{ section.settings.title_size }}px;
    --sdb-title-size-mobile: {{ section.settings.title_size_mobile }}px;
    --sdb-image-width: {{ section.settings.image_width }}px;
    --sdb-image-height: {{ section.settings.image_height }}px;
    --sdb-image-width-mobile: {{ section.settings.image_width_mobile }}px;
    --sdb-image-height-mobile: {{ section.settings.image_height_mobile }}px;
    --sdb-image-radius: {{ section.settings.image_radius }}px;

    --sdb-list-max-width: {{ section.settings.list_max_width }}px;
    --sdb-row-gap: {{ section.settings.row_gap }}px;
    --sdb-row-gap-mobile: {{ section.settings.row_gap_mobile }}px;
    --sdb-text-width: {{ section.settings.text_width }}px;
    --sdb-value-color: {{ section.settings.value_color }};
    --sdb-value-size: {{ section.settings.value_size }}px;
    --sdb-value-size-mobile: {{ section.settings.value_size_mobile }}px;
    --sdb-label-color: {{ section.settings.label_color }};
    --sdb-label-size: {{ section.settings.label_size }}px;
    --sdb-label-size-mobile: {{ section.settings.label_size_mobile }}px;

    --sdb-bar-height: {{ section.settings.bar_height }}px;
    --sdb-bar-height-mobile: {{ section.settings.bar_height_mobile }}px;
    --sdb-bar-radius: {{ section.settings.bar_radius }}px;
    --sdb-track-color: {{ section.settings.track_color }};
    --sdb-track-border: {{ section.settings.track_border_color }};
    --sdb-fill-color: {{ section.settings.fill_color }};
    --sdb-marker-color: {{ section.settings.marker_color }};
    --sdb-marker-overhang: {{ section.settings.marker_overhang }}px;
    --sdb-scale-color: {{ section.settings.scale_color }};
    --sdb-scale-size: {{ section.settings.scale_size }}px;
    --sdb-bar-duration: {{ section.settings.animation_duration }}ms;
    --sdb-bar-stagger: {{ section.settings.animation_stagger }}ms;

    --sdb-disclaimer-color: {{ section.settings.disclaimer_color }};
    --sdb-disclaimer-size: {{ section.settings.disclaimer_size }}px;
    --sdb-disclaimer-max-width: {{ section.settings.disclaimer_max_width }}px;
  }
{%- endstyle -%}

{%- capture scale_markup -%}
  {%- if section.settings.show_scale -%}
    <div class="sdb-row__scale">
      {%- for i in (0..scale_ticks) -%}
        <span>{{ i | times: scale_step }}{{ section.settings.value_suffix | escape }}</span>
      {%- endfor -%}
    </div>
  {%- endif -%}
{%- endcapture -%}

<section
  class="sdb sdb--{{ section.id }}"
  {% if section.settings.heading != blank %}
    aria-label="{{ section.settings.heading | strip_html | escape }}"
  {% endif %}
>
  <div class="sdb__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="sdb__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      {%- capture image_sizes -%}
        (min-width: 750px) {{ section.settings.image_width }}px, {{ section.settings.image_width_mobile }}px
      {%- endcapture -%}

      <div class="sdb__groups">
        {%- if section.blocks.first.type == 'stat' -%}
          <div class="sdb-group">
            {%- render 'science-datablock-rows',
              blocks: section.blocks,
              offset: 0,
              value_suffix: section.settings.value_suffix,
              show_marker: section.settings.show_marker,
              scale_markup: scale_markup,
              animate: animate_bars
            -%}
          </div>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- if block.type == 'group' -%}
            <div class="sdb-group" {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}
                <h3 class="sdb-group__title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.image != blank -%}
                <div class="sdb-group__media">
                  {{
                    block.settings.image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '160, 240, 320, 480, 640, 800',
                      sizes: image_sizes,
                      class: 'sdb-group__image'
                  }}
                </div>
              {%- endif -%}
              {%- render 'science-datablock-rows',
                blocks: section.blocks,
                offset: forloop.index,
                value_suffix: section.settings.value_suffix,
                show_marker: section.settings.show_marker,
                scale_markup: scale_markup,
                animate: animate_bars
              -%}
              {%- if block.settings.disclaimer != blank -%}
                <div class="sdb-group__disclaimer rte">{{ block.settings.disclaimer }}</div>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

