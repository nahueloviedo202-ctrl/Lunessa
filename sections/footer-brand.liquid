      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "range",
      "id": "brand_column_width",
      "min": 20,
      "max": 60,
      "step": 5,
      "unit": "%",
      "label": "Ancho de la columna de marca",
      "default": 50
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Separación entre columnas",
      "default": 32
    },
    {
      "type": "range",
      "id": "column_gap_mobile",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Separación entre columnas (móvil)",
      "default": 28
    },
    {
      "type": "range",
      "id": "top_margin_bottom",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Separación columnas / barra inferior",
      "default": 32
    },
    {
      "type": "range",
      "id": "top_margin_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Separación columnas / barra inferior (móvil)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Relleno superior",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Relleno inferior",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Relleno lateral (escritorio)",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_horizontal_tablet",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Relleno lateral (tablet)",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Relleno superior (móvil)",
      "default": 34
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Relleno inferior (móvil)",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Relleno lateral (móvil)",
      "default": 22
    },
    {
      "type": "header",
      "content": "Columnas de enlaces"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Tamaño de títulos",
      "default": 19
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Tamaño de títulos (móvil)",
      "default": 17
    },
    {
      "type": "range",
      "id": "heading_margin_bottom",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Margen bajo títulos",
      "default": 24
    },
    {
      "type": "range",
      "id": "heading_margin_bottom_mobile",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Margen bajo títulos (móvil)",
      "default": 14
    },
    {
      "type": "range",
      "id": "link_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Tamaño de enlaces",
      "default": 16
    },
    {
      "type": "range",
      "id": "link_size_mobile",
      "min": 10,
      "max": 24,
