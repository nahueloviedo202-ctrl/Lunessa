{{ 'section-footer-brand.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign column_count = 0
  for block in section.blocks
    if block.type == 'link_list'
      assign column_count = column_count | plus: 1
    endif
  endfor

  assign legal_menu = section.settings.legal_menu
-%}

{%- style -%}
  {%- if section.settings.heading_font_custom -%}
    {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if section.settings.body_font_custom -%}
    {{ section.settings.body_font | font_face: font_display: 'swap' }}
  {%- endif -%}

  .ftr--{{ section.id }} {
    {%- if section.settings.heading_font_custom %}
      --ftr-heading-font: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
      --ftr-heading-style: {{ section.settings.heading_font.style }};
    {%- endif %}
    {%- if section.settings.body_font_custom %}
      --ftr-body-font: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
      --ftr-body-style: {{ section.settings.body_font.style }};
    {%- endif %}
    --ftr-bg: {{ section.settings.background }};
    --ftr-color: {{ section.settings.text_color }};
    --ftr-muted: {{ section.settings.disclaimer_color }};
    --ftr-border: {{ section.settings.border_color }};
    --ftr-pt: {{ section.settings.padding_top }}px;
    --ftr-pb: {{ section.settings.padding_bottom }}px;
    --ftr-px: {{ section.settings.padding_horizontal }}px;
    --ftr-px-tablet: {{ section.settings.padding_horizontal_tablet }}px;
    --ftr-pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --ftr-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --ftr-px-mobile: {{ section.settings.padding_horizontal_mobile }}px;
    --ftr-brand-ratio: {{ section.settings.brand_column_width | divided_by: 100.0 }};
    --ftr-columns: {{ column_count | at_least: 1 }};
    --ftr-gap: {{ section.settings.column_gap }}px;
    --ftr-gap-mobile: {{ section.settings.column_gap_mobile }}px;
    --ftr-top-mb: {{ section.settings.top_margin_bottom }}px;
    --ftr-top-mb-mobile: {{ section.settings.top_margin_bottom_mobile }}px;
    --ftr-heading-size: {{ section.settings.heading_size }}px;
    --ftr-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --ftr-heading-mb: {{ section.settings.heading_margin_bottom }}px;
    --ftr-heading-mb-mobile: {{ section.settings.heading_margin_bottom_mobile }}px;
    --ftr-link-size: {{ section.settings.link_size }}px;
    --ftr-link-size-mobile: {{ section.settings.link_size_mobile }}px;
    --ftr-link-gap: {{ section.settings.link_spacing }}px;
    --ftr-copyright-size: {{ section.settings.copyright_size }}px;
    --ftr-copyright-size-mobile: {{ section.settings.copyright_size_mobile }}px;
    --ftr-legal-size: {{ section.settings.legal_size }}px;
    --ftr-legal-size-mobile: {{ section.settings.legal_size_mobile }}px;
    --ftr-legal-columns: {{ legal_menu.links.size | at_least: 1 }};
    --ftr-legal-columns-mobile: {{ section.settings.legal_columns_mobile }};
    --ftr-disclaimer-size: {{ section.settings.disclaimer_size }}px;
  }
{%- endstyle -%}

<footer class="ftr ftr--{{ section.id }}">
  <div class="ftr__inner">
    {%- if section.blocks.size > 0 -%}
      <div class="ftr__top">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'brand' -%}
              <div
                class="ftr__brand"
                style="--ftr-logo-width: {{ block.settings.logo_width }}%; --ftr-logo-width-mobile: {{ block.settings.logo_width_mobile }}%; --ftr-tagline-size: {{ block.settings.tagline_size }}px; --ftr-tagline-size-mobile: {{ block.settings.tagline_size_mobile }}px; --ftr-tagline-mb: {{ block.settings.tagline_margin_bottom }}px; --ftr-tagline-mb-mobile: {{ block.settings.tagline_margin_bottom_mobile }}px;"
                {{ block.shopify_attributes }}
              >
                {%- liquid
                  assign logo = block.settings.logo | default: settings.logo
                -%}
                <a href="{{ routes.root_url }}" class="ftr__logo-link">
                  {%- if logo != blank -%}
                    {{
                      logo
                      | image_url: width: 800
                      | image_tag:
                        loading: 'lazy',
                        widths: '200, 300, 400, 600, 800',
                        sizes: '(min-width: 990px) 300px, 30vw',
                        class: 'ftr__logo',
                        alt: shop.name
                    }}
                  {%- else -%}
                    <span class="ftr__logo-text">{{ shop.name | escape }}</span>
                  {%- endif -%}
                </a>
                {%- if block.settings.tagline != blank -%}
                  <div class="ftr__tagline">{{ block.settings.tagline }}</div>
                {%- endif -%}
              </div>

            {%- when 'link_list' -%}
              <nav
                class="ftr__column"
                {% if block.settings.heading != blank %}
                  aria-label="{{ block.settings.heading | escape }}"
                {% endif %}
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.heading != blank -%}
                  <h2 class="ftr__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.menu != blank and block.settings.menu.links.size > 0 -%}
                  <ul class="ftr__links list-unstyled" role="list">
                    {%- for link in block.settings.menu.links -%}
                      <li>
                        <a
                          href="{{ link.url }}"
                          class="ftr__link"
                          {% if link.current %}
                            aria-current="page"
                          {% endif %}
                        >
                          {{- link.title | escape -}}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </nav>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="ftr__bottom{% if section.settings.show_border %} ftr__bottom--border{% endif %}">
      <p class="ftr__copyright">
        {%- if section.settings.copyright != blank -%}
          {{ section.settings.copyright | escape }}
        {%- else -%}
          &copy; {{ 'now' | date: '%Y' }}, {{ shop.name | link_to: routes.root_url }}
        {%- endif -%}
      </p>

      {%- if legal_menu != blank and legal_menu.links.size > 0 -%}
        <ul class="ftr__legal list-unstyled" role="list">
          {%- for link in legal_menu.links -%}
            <li>
              <a
                href="{{ link.url }}"
                class="ftr__legal-link"
                {% if link.current %}
                  aria-current="page"
                {% endif %}
              >
                {{- link.title | escape -}}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.disclaimer != blank -%}
        <div class="ftr__disclaimer">{{ section.settings.disclaimer }}</div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer de marca",
  "tag": "div",
  "class": "section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Color de fondo",
      "default": "#7F1525"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color de texto",
      "default": "#FFFFFF"
    },
