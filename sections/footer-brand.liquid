    {
      "type": "range",
      "id": "disclaimer_size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del aviso legal",
      "default": 12
    },
    {
      "type": "header",
      "content": "Tipografía"
    },
    {
      "type": "checkbox",
      "id": "heading_font_custom",
      "label": "Usar fuente personalizada en títulos y lema",
      "info": "Si está desactivado se usa la fuente de títulos del tema.",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Fuente de títulos y lema",
      "default": "assistant_n4"
    },
    {
      "type": "checkbox",
      "id": "body_font_custom",
      "label": "Usar fuente personalizada en enlaces y textos",
      "info": "Si está desactivado se usa la fuente de cuerpo del tema.",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Fuente de enlaces y textos",
      "default": "assistant_n4"
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Marca",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo",
          "info": "Si se deja vacío se usa el logo del tema."
        },
        {
