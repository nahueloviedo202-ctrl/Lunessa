      "label": "Texto de copyright",
      "info": "Si se deja vacío se muestra © año y nombre de la tienda.",
      "default": "Copyright © GUJOY"
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Menú legal",
      "info": "Políticas, términos, accesibilidad…"
    },
    {
      "type": "range",
      "id": "legal_columns_mobile",
      "min": 1,
