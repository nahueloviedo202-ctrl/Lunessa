{{ 'section-ingredient-glossary.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ingredient-glossary.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font

  case section.settings.heading_font_source
    when 'theme_heading'
      assign heading_ff = 'var(--font-heading-family)'
      assign heading_fs = 'var(--font-heading-style)'
    when 'theme_body'
      assign heading_ff = 'var(--font-body-family)'
      assign heading_fs = 'var(--font-body-style)'
    else
      assign heading_ff = heading_font.family | append: ', ' | append: heading_font.fallback_families
      assign heading_fs = heading_font.style
  endcase

  case section.settings.body_font_source
    when 'theme_heading'
      assign body_ff = 'var(--font-heading-family)'
      assign body_fs = 'var(--font-heading-style)'
    when 'theme_body'
      assign body_ff = 'var(--font-body-family)'
      assign body_fs = 'var(--font-body-style)'
    else
      assign body_ff = body_font.family | append: ', ' | append: body_font.fallback_families
      assign body_fs = body_font.style
  endcase

  assign letters_string = section.settings.letters | upcase | remove: ' ' | remove: ','
  assign letters = letters_string | split: ''
  assign search_id = 'IngredientGlossarySearch-' | append: section.id
  assign filter_id = 'IngredientGlossaryFilter-' | append: section.id
  # Index letter of every block (accents removed), '_' for blocks that are not rendered.
  assign total = 0
  assign initials_string = ''
  for block in section.blocks
    assign initial = '_'
    if block.type == 'ingredient' and block.settings.name != blank
      assign total = total | plus: 1
      assign initial = block.settings.name | strip | slice: 0 | upcase
      case initial
        when 'Á', 'À', 'Ä', 'Â'
          assign initial = 'A'
        when 'É', 'È', 'Ë', 'Ê'
          assign initial = 'E'
        when 'Í', 'Ì', 'Ï', 'Î'
          assign initial = 'I'
        when 'Ó', 'Ò', 'Ö', 'Ô'
          assign initial = 'O'
        when 'Ú', 'Ù', 'Ü', 'Û'
          assign initial = 'U'
      endcase
    endif
    assign initials_string = initials_string | append: initial | append: '|'
  endfor
  assign initials = initials_string | split: '|'
-%}

{%- style -%}
  {%- if section.settings.heading_font_source == 'custom' -%}
    {{ heading_font | font_face: font_display: 'swap' }}
    {%- assign heading_font_weighted = heading_font | font_modify: 'weight', section.settings.heading_font_weight -%}
    {%- if heading_font_weighted -%}
      {{ heading_font_weighted | font_face: font_display: 'swap' }}
    {%- endif -%}
  {%- endif -%}
  {%- if section.settings.body_font_source == 'custom' -%}
    {{ body_font | font_face: font_display: 'swap' }}
    {%- assign body_font_weighted = body_font | font_modify: 'weight', section.settings.body_font_weight -%}
    {%- if body_font_weighted -%}
      {{ body_font_weighted | font_face: font_display: 'swap' }}
    {%- endif -%}
    {%- assign body_font_strong = body_font | font_modify: 'weight', section.settings.body_strong_weight -%}
    {%- if body_font_strong -%}
      {{ body_font_strong | font_face: font_display: 'swap' }}
    {%- endif -%}
  {%- endif -%}

  .igl-{{ section.id }} {
    --igl-bg: {{ section.settings.background }};
    --igl-heading-color: {{ section.settings.heading_color }};
    --igl-text-color: {{ section.settings.text_color }};
    --igl-group-letter-color: {{ section.settings.group_letter_color }};
    --igl-card-bg: {{ section.settings.card_background }};
    --igl-card-color: {{ section.settings.card_text }};
    --igl-letter-bg: {{ section.settings.letter_background }};
    --igl-letter-color: {{ section.settings.letter_text }};
    --igl-letter-active-bg: {{ section.settings.letter_active_background }};
    --igl-letter-active-color: {{ section.settings.letter_active_text }};
    --igl-button-bg: {{ section.settings.button_background }};
    --igl-button-color: {{ section.settings.button_text }};
    --igl-button-bg-hover: {{ section.settings.button_background_hover }};
    --igl-button-color-hover: {{ section.settings.button_text_hover }};
    --igl-search-bg: {{ section.settings.search_background }};
    --igl-search-border: {{ section.settings.search_border }};
    --igl-search-color: {{ section.settings.search_text }};
    --igl-search-icon: {{ section.settings.search_icon }};
    --igl-filter-bg: {{ section.settings.filter_background }};
    --igl-filter-color: {{ section.settings.filter_text }};
    --igl-focus: {{ section.settings.focus_color }};
    --igl-max-width: {{ section.settings.max_width }}px;
    --igl-px: {{ section.settings.padding_x }}px;
    --igl-px-mobile: {{ section.settings.padding_x_mobile }}px;
    --igl-pt: {{ section.settings.padding_top }}px;
    --igl-pb: {{ section.settings.padding_bottom }}px;
    --igl-pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --igl-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --igl-gap: {{ section.settings.block_gap }}px;
    --igl-gap-mobile: {{ section.settings.block_gap_mobile }}px;
    --igl-hero-width: {{ section.settings.hero_width }}px;
    --igl-search-width: {{ section.settings.search_width }}px;
    --igl-search-radius: {{ section.settings.search_radius }}px;
    --igl-letter-radius: {{ section.settings.letter_radius }}px;
    --igl-sticky-top: {% if section.settings.offset_sticky_header %}var(--header-height, 0px){% else %}0px{% endif %};
    --igl-card-radius: {{ section.settings.card_radius }}px;
    --igl-card-gap: {{ section.settings.card_gap }}px;
    --igl-item-gap: {{ section.settings.item_gap }}px;
    --igl-photo-size: {{ section.settings.photo_size }}px;
    --igl-photo-size-mobile: {{ section.settings.photo_size_mobile }}px;
    --igl-product-image: {{ section.settings.product_image_size }}px;
    --igl-heading-ff: {{ heading_ff }};
    --igl-heading-fs: {{ heading_fs }};
    --igl-heading-fw: {{ section.settings.heading_font_weight }};
    --igl-heading-size: {{ section.settings.heading_size }}px;
    --igl-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --igl-heading-tt: {% if section.settings.heading_uppercase %}uppercase{% else %}none{% endif %};
    --igl-subheading-size: {{ section.settings.subheading_size }}px;
    --igl-subheading-size-mobile: {{ section.settings.subheading_size_mobile }}px;
    --igl-group-letter-size: {{ section.settings.group_letter_size }}px;
    --igl-name-size: {{ section.settings.card_name_size }}px;
    --igl-term-size: {{ section.settings.term_size }}px;
    --igl-body-ff: {{ body_ff }};
    --igl-body-fs: {{ body_fs }};
    --igl-body-fw: {{ section.settings.body_font_weight }};
    --igl-body-strong-fw: {{ section.settings.body_strong_weight }};
    --igl-body-size: {{ section.settings.body_size }}px;
  }
{%- endstyle -%}

{%- capture groups_markup -%}
  {%- assign available_letters = '' -%}
  {%- for letter in letters -%}
    {%- capture group_items -%}
      {%- for block in section.blocks -%}
        {%- if initials[forloop.index0] == letter -%}
          {%- render 'ingredient-glossary-card', block: block -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}

    {%- if group_items != blank -%}
      {%- assign available_letters = available_letters | append: letter | append: ',' -%}
      <div
        id="IngredientGlossary-{{ section.id }}-{{ forloop.index }}"
        class="igl__group"
        data-glossary-group="{{ forloop.index }}"
      >
        <h2 class="igl__group-letter">{{ letter }}</h2>
        {{ group_items }}
      </div>
    {%- endif -%}
  {%- endfor -%}

  {%- comment -%} Ingredients whose first character is not in the index go to a final "#" group. {%- endcomment -%}
  {%- capture other_items -%}
    {%- for block in section.blocks -%}
      {%- assign initial = initials[forloop.index0] -%}
      {%- if initial != '_' -%}
        {%- unless letters contains initial -%}
          {%- render 'ingredient-glossary-card', block: block -%}
        {%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if other_items != blank -%}
    <div id="IngredientGlossary-{{ section.id }}-0" class="igl__group" data-glossary-group="0">
      <h2 class="igl__group-letter">#</h2>
      {{ other_items }}
    </div>
  {%- endif -%}
{%- endcapture -%}

{%- assign available = available_letters | split: ',' -%}

<div class="igl igl-{{ section.id }}">
  <div class="igl__container">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <header class="igl__hero">
        {%- if section.settings.heading != blank -%}
          <{{ section.settings.heading_tag }} class="igl__heading">
            {{- section.settings.heading -}}
          </{{ section.settings.heading_tag }}>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="igl__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    <ingredient-glossary
      class="igl__glossary"
      data-status-template="{{ section.settings.status_text | escape }}"
    >
      {%- if section.settings.show_search -%}
        <div class="igl__search" role="search">
          <label for="{{ search_id }}" class="visually-hidden">{{ section.settings.search_label | escape }}</label>
          <div class="igl__search-box">
            <span class="igl__search-icon svg-wrapper" aria-hidden="true">
              {{- 'icon-search.svg' | inline_asset_content -}}
            </span>
            <input
              id="{{ search_id }}"
              class="igl__search-input"
              type="search"
              enterkeyhint="search"
              autocomplete="off"
              spellcheck="false"
              placeholder="{{ section.settings.search_placeholder | escape }}"
              data-glossary-search
            >
            <button
              type="button"
              class="igl__search-clear"
              aria-label="{{ section.settings.clear_label | escape }}"
              data-glossary-clear
            >
              <span class="svg-wrapper" aria-hidden="true">{{- 'icon-close.svg' | inline_asset_content -}}</span>
            </button>
          </div>
        </div>
      {%- endif -%}

      <div class="igl__body">
        {%- if section.settings.show_letters -%}
          <nav
            class="igl__letters{% if section.settings.sticky_letters %} igl__letters--sticky{% endif %}"
            aria-label="{{ section.settings.letters_label | escape }}"
          >
            <ul class="igl__letter-list list-unstyled" role="list">
              {%- for letter in letters -%}
                <li>
                  {%- if available contains letter -%}
                    <a
                      class="igl__letter"
                      href="#IngredientGlossary-{{ section.id }}-{{ forloop.index }}"
                      data-glossary-letter="{{ forloop.index }}"
                    >
                      {{- letter -}}
                    </a>
                  {%- else -%}
                    <span class="igl__letter" data-disabled aria-hidden="true">{{ letter }}</span>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}

        {%- if section.settings.show_filter -%}
          <div class="igl__filter">
            <label for="{{ filter_id }}" class="visually-hidden">{{ section.settings.filter_label | escape }}</label>
            <div class="select igl__select">
              <select id="{{ filter_id }}" class="select__select igl__select-input" data-glossary-filter>
                <option value="all">{{ section.settings.filter_all_label | escape }}</option>
                <option value="active">{{ section.settings.active_label | escape }}</option>
                <option value="inactive">{{ section.settings.inactive_label | escape }}</option>
              </select>
              <span class="svg-wrapper" aria-hidden="true">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
            </div>
          </div>
        {%- endif -%}

        <p class="visually-hidden" role="status" aria-live="polite" data-glossary-status data-total="{{ total }}"></p>

        <div class="igl__groups">
          {{ groups_markup }}
          <p class="igl__empty" data-glossary-empty {% if total > 0 %}hidden{% endif %}>
            {{- section.settings.empty_text | escape -}}
          </p>
        </div>
      </div>
    </ingredient-glossary>
  </div>
</div>

