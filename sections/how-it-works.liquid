{{ 'section-how-it-works.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font

  case section.settings.heading_font_source
    when 'theme_heading'
      assign heading_ff = 'var(--font-heading-family)'
      assign heading_fs = 'var(--font-heading-style)'
    when 'theme_body'
      assign heading_ff = 'var(--font-body-family)'
      assign heading_fs = 'var(--font-body-style)'
    else
      assign heading_ff = heading_font.family | append: ', ' | append: heading_font.fallback_families
      assign heading_fs = heading_font.style
  endcase

  case section.settings.body_font_source
    when 'theme_heading'
      assign body_ff = 'var(--font-heading-family)'
      assign body_fs = 'var(--font-heading-style)'
    when 'theme_body'
      assign body_ff = 'var(--font-body-family)'
      assign body_fs = 'var(--font-body-style)'
    else
      assign body_ff = body_font.family | append: ', ' | append: body_font.fallback_families
      assign body_fs = body_font.style
  endcase

  assign stage_blocks = section.blocks | where: 'type', 'stage'
-%}

{%- style -%}
  {% if section.settings.heading_font_source == 'custom' %}
    {%- assign heading_font_weighted = heading_font | font_modify: 'weight', section.settings.heading_font_weight | default: heading_font -%}
    {{ heading_font_weighted | font_face: font_display: 'swap' }}
  {% endif %}
  {% if section.settings.body_font_source == 'custom' %}
    {{ body_font | font_face: font_display: 'swap' }}
    {%- assign body_font_bold = body_font | font_modify: 'weight', 'bold' -%}
    {{ body_font_bold | font_face: font_display: 'swap' }}
    {%- assign body_font_italic = body_font | font_modify: 'style', 'italic' -%}
    {{ body_font_italic | font_face: font_display: 'swap' }}
  {% endif %}

  .hiw--{{ section.id }} {
    --hiw-bg: {{ section.settings.background_color }};
    --hiw-max-width: {{ section.settings.max_width }}px;
    --hiw-pt: {{ section.settings.padding_top }}px;
    --hiw-pb: {{ section.settings.padding_bottom }}px;
    --hiw-px: {{ section.settings.padding_x }}px;
    --hiw-pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --hiw-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --hiw-px-mobile: {{ section.settings.padding_x_mobile }}px;
    --hiw-stack-gap: {{ section.settings.stack_gap }}px;
    --hiw-stack-gap-mobile: {{ section.settings.stack_gap_mobile }}px;
    --hiw-text-max-width: {{ section.settings.text_max_width }}px;

    --hiw-heading-ff: {{ heading_ff }};
    --hiw-heading-fs: {{ heading_fs }};
    --hiw-heading-fw: {{ section.settings.heading_font_weight }};
    --hiw-heading-color: {{ section.settings.heading_color }};
    --hiw-heading-size: {{ section.settings.heading_size }}px;
    --hiw-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --hiw-heading-lh: {{ section.settings.heading_line_height }}px;
    --hiw-heading-lh-mobile: {{ section.settings.heading_line_height_mobile }}px;
    --hiw-header-gap: {{ section.settings.header_gap }}px;
    --hiw-subheading-color: {{ section.settings.subheading_color }};
    --hiw-subheading-size: {{ section.settings.subheading_size }}px;
    --hiw-subheading-lh: {{ section.settings.subheading_line_height }}px;
    --hiw-body-ff: {{ body_ff }};
    --hiw-body-fs: {{ body_fs }};

    --hiw-columns: {{ section.settings.columns_desktop }};
    --hiw-columns-tablet: {{ section.settings.columns_tablet }};
    --hiw-stage-gap: {{ section.settings.stage_gap }}px;
    --hiw-stage-gap-mobile: {{ section.settings.stage_gap_mobile }}px;
    --hiw-stage-inner-gap: {{ section.settings.stage_inner_gap }}px;
    --hiw-head-gap: {{ section.settings.head_gap }}px;
    --hiw-icon-size: {{ section.settings.icon_size }}px;
    --hiw-icon-color: {{ section.settings.icon_color }};
    --hiw-title-gap: {{ section.settings.title_gap }}px;
    --hiw-label-color: {{ section.settings.label_color }};
    --hiw-title-color: {{ section.settings.title_color }};
    --hiw-title-size: {{ section.settings.title_size }}px;
    --hiw-title-lh: {{ section.settings.title_line_height }}px;
    --hiw-title-size-mobile: {{ section.settings.title_size_mobile }}px;
    --hiw-title-lh-mobile: {{ section.settings.title_line_height_mobile }}px;
    --hiw-point-color: {{ section.settings.point_color }};
    --hiw-point-size: {{ section.settings.point_size }}px;
    --hiw-point-lh: {{ section.settings.point_line_height }}px;
    --hiw-point-gap: {{ section.settings.point_gap }}px;
    --hiw-bullet-color: {{ section.settings.bullet_color }};

    --hiw-footer-gap: {{ section.settings.footer_gap }}px;
    --hiw-button-bg: {{ section.settings.button_background }};
    --hiw-button-color: {{ section.settings.button_color }};
    --hiw-button-border: {{ section.settings.button_border }};
    --hiw-button-bg-hover: {{ section.settings.button_background_hover }};
    --hiw-button-color-hover: {{ section.settings.button_color_hover }};
    --hiw-button-border-hover: {{ section.settings.button_border_hover }};
    --hiw-button-size: {{ section.settings.button_size }}px;
    --hiw-button-height: {{ section.settings.button_height }}px;
    --hiw-button-max-width: {{ section.settings.button_max_width }}px;
    --hiw-button-radius: {{ section.settings.button_radius }}px;
    --hiw-disclaimer-color: {{ section.settings.disclaimer_color }};
    --hiw-disclaimer-size: {{ section.settings.disclaimer_size }}px;
    --hiw-disclaimer-style: {% if section.settings.disclaimer_italic %}italic{% else %}normal{% endif %};
  }
{%- endstyle -%}

<section class="hiw hiw--{{ section.id }}">
  <div class="hiw__inner">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="hiw__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="hiw__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="hiw__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if stage_blocks.size > 0 -%}
      <ol class="hiw__stages" role="list">
        {%- liquid
          # Point blocks belong to the closest stage block above them.
          assign stage_open = false
          assign list_open = false
        -%}
        {%- for block in section.blocks -%}
          {%- assign next_block = section.blocks[forloop.index] -%}
          {%- case block.type -%}
            {%- when 'stage' -%}
              {%- if list_open %}</ul>{% endif -%}
              {%- if stage_open %}</li>{% endif -%}
              <li
                class="hiw-stage{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
                {{ block.shopify_attributes }}
              >
                <div class="hiw-stage__head">
                  {%- if block.settings.icon_image != blank -%}
                    {{
                      block.settings.icon_image
                      | image_url: width: 120
                      | image_tag: loading: 'lazy', alt: '', class: 'hiw-stage__icon'
                    }}
                  {%- elsif block.settings.icon != 'none' -%}
                    {%- render 'stage-icon', icon: block.settings.icon, class: 'hiw-stage__icon' -%}
                  {%- endif -%}
                  <h3 class="hiw-stage__title">
                    {%- if block.settings.label != blank -%}
                      <span class="hiw-stage__label">{{ block.settings.label | escape }}</span>
                    {%- endif -%}
                    {%- if block.settings.title != blank -%}
                      <span>{{ block.settings.title | escape }}</span>
                    {%- endif -%}
                  </h3>
                </div>
              {%- liquid
                assign stage_open = true
                assign list_open = false
                if next_block.type == 'point'
                  assign list_open = true
                endif
              -%}
              {%- if list_open -%}
                <ul class="hiw-stage__list" role="list">
              {%- endif -%}
            {%- when 'point' -%}
              {%- if list_open -%}
                <li class="hiw-stage__point" {{ block.shopify_attributes }}>
                  {%- if section.settings.bullet != blank -%}
                    <span class="hiw-stage__bullet" aria-hidden="true">{{ section.settings.bullet | escape }}</span>
                  {%- endif -%}
                  <span class="hiw-stage__point-text">{{ block.settings.text }}</span>
                </li>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
        {%- if list_open %}</ul>{% endif -%}
        {%- if stage_open %}</li>{% endif -%}
      </ol>
    {%- endif -%}

    {%- if section.settings.button_label != blank or section.settings.disclaimer != blank -%}
      <div class="hiw__footer">
        {%- if section.settings.button_label != blank -%}
          <a
            class="hiw__button"
            {% if section.settings.button_link != blank %}
              href="{{ section.settings.button_link }}"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
          >
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.disclaimer != blank -%}
          <p class="hiw__disclaimer">{{ section.settings.disclaimer }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

