{{ 'section-ingredient-tiles.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font
  assign dose_font = section.settings.dose_font

  case section.settings.heading_font_source
    when 'theme_heading'
      assign heading_ff = 'var(--font-heading-family)'
      assign heading_fs = 'var(--font-heading-style)'
    when 'theme_body'
      assign heading_ff = 'var(--font-body-family)'
      assign heading_fs = 'var(--font-body-style)'
    else
      assign heading_ff = heading_font.family | append: ', ' | append: heading_font.fallback_families
      assign heading_fs = heading_font.style
  endcase

  case section.settings.body_font_source
    when 'theme_heading'
      assign body_ff = 'var(--font-heading-family)'
      assign body_fs = 'var(--font-heading-style)'
    when 'theme_body'
      assign body_ff = 'var(--font-body-family)'
      assign body_fs = 'var(--font-body-style)'
    else
      assign body_ff = body_font.family | append: ', ' | append: body_font.fallback_families
      assign body_fs = body_font.style
  endcase

  assign ingredient_blocks = section.blocks | where: 'type', 'ingredient'
  assign badge_blocks = section.blocks | where: 'type', 'badge'
  assign badge_count = badge_blocks.size | at_least: 1
-%}

{%- style -%}
  {% if section.settings.heading_font_source == 'custom' %}
    {%- assign heading_font_weighted = heading_font | font_modify: 'weight', section.settings.heading_font_weight | default: heading_font -%}
    {{ heading_font_weighted | font_face: font_display: 'swap' }}
  {% endif %}
  {% if section.settings.body_font_source == 'custom' %}
    {{ body_font | font_face: font_display: 'swap' }}
    {%- assign body_font_semibold = body_font | font_modify: 'weight', '600' -%}
    {{ body_font_semibold | font_face: font_display: 'swap' }}
    {%- assign body_font_bold = body_font | font_modify: 'weight', 'bold' -%}
    {{ body_font_bold | font_face: font_display: 'swap' }}
    {%- assign body_font_italic = body_font | font_modify: 'style', 'italic' -%}
    {{ body_font_italic | font_face: font_display: 'swap' }}
  {% endif %}
  {%- assign dose_font_weighted = dose_font | font_modify: 'weight', section.settings.dose_font_weight | default: dose_font -%}
  {{ dose_font_weighted | font_face: font_display: 'swap' }}

  .igr--{{ section.id }} {
    --igr-bg: {{ section.settings.background_color }};
    --igr-max-width: {{ section.settings.max_width }}px;
    --igr-pt: {{ section.settings.padding_top }}px;
    --igr-pb: {{ section.settings.padding_bottom }}px;
    --igr-px: {{ section.settings.padding_x }}px;
    --igr-pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --igr-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --igr-px-mobile: {{ section.settings.padding_x_mobile }}px;
    --igr-stack-gap: {{ section.settings.stack_gap }}px;
    --igr-stack-gap-mobile: {{ section.settings.stack_gap_mobile }}px;

    --igr-heading-ff: {{ heading_ff }};
    --igr-heading-fs: {{ heading_fs }};
    --igr-heading-fw: {{ section.settings.heading_font_weight }};
    --igr-heading-color: {{ section.settings.heading_color }};
    --igr-heading-size: {{ section.settings.heading_size }}px;
    --igr-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --igr-heading-lh: {{ section.settings.heading_line_height }}px;
    --igr-heading-lh-mobile: {{ section.settings.heading_line_height_mobile }}px;
    --igr-header-gap: {{ section.settings.header_gap }}px;
    --igr-subheading-color: {{ section.settings.subheading_color }};
    --igr-subheading-size: {{ section.settings.subheading_size }}px;
    --igr-subheading-lh: {{ section.settings.subheading_line_height }}px;
    --igr-subheading-max-width: {{ section.settings.subheading_max_width }}px;
    --igr-body-ff: {{ body_ff }};
    --igr-body-fs: {{ body_fs }};

    --igr-columns: {{ section.settings.columns_desktop }};
    --igr-columns-tablet: {{ section.settings.columns_tablet }};
    --igr-columns-mobile: {{ section.settings.columns_mobile }};
    --igr-column-gap: {{ section.settings.column_gap }}px;
    --igr-row-gap: {{ section.settings.row_gap }}px;
    --igr-column-gap-mobile: {{ section.settings.column_gap_mobile }}px;
    --igr-row-gap-mobile: {{ section.settings.row_gap_mobile }}px;
    --igr-tile-bg: {{ section.settings.tile_background }};
    --igr-tile-min-height: {{ section.settings.tile_min_height }}px;
    --igr-tile-radius: {{ section.settings.tile_radius }}px;
    --igr-tile-pt: {{ section.settings.tile_padding_top }}px;
    --igr-tile-pt-mobile: {{ section.settings.tile_padding_top_mobile }}px;
    --igr-tile-pb: {{ section.settings.tile_padding_bottom }}px;
    --igr-tile-px: {{ section.settings.tile_padding_x }}px;
    --igr-tile-gap: {{ section.settings.tile_gap }}px;
    --igr-scrim-opacity: {{ section.settings.scrim_opacity | divided_by: 100.0 }};

    --igr-dose-ff: {{ dose_font.family }}, {{ dose_font.fallback_families }};
    --igr-dose-fs: {{ dose_font.style }};
    --igr-dose-fw: {{ section.settings.dose_font_weight }};
    --igr-dose-bg: {{ section.settings.dose_background }};
    --igr-dose-color: {{ section.settings.dose_color }};
    --igr-dose-size: {{ section.settings.dose_size }}px;
    --igr-dose-py: {{ section.settings.dose_padding_y }}px;
    --igr-dose-px: {{ section.settings.dose_padding_x }}px;
    --igr-dose-radius: {{ section.settings.dose_radius }}px;
    --igr-caption-color: {{ section.settings.caption_color }};
    --igr-caption-gap: {{ section.settings.caption_gap }}px;
    --igr-name-size: {{ section.settings.name_size }}px;
    --igr-name-lh: {{ section.settings.name_line_height }}px;
    --igr-desc-size: {{ section.settings.desc_size }}px;
    --igr-desc-lh: {{ section.settings.desc_line_height }}px;

    --igr-footer-gap: {{ section.settings.footer_gap }}px;
    --igr-footer-gap-mobile: {{ section.settings.footer_gap_mobile }}px;
    --igr-note-color: {{ section.settings.note_color }};
    --igr-note-size: {{ section.settings.note_size }}px;
    --igr-note-style: {% if section.settings.note_italic %}italic{% else %}normal{% endif %};
    --igr-badge-count: {{ badge_count }};
    --igr-badge-gap: {{ section.settings.badge_gap }}px;
    --igr-badge-gap-mobile: {{ section.settings.badge_gap_mobile }}px;
    --igr-badge-size: {{ section.settings.badge_size }}px;
    --igr-badge-size-mobile: {{ section.settings.badge_size_mobile }}px;
    --igr-badge-icon-color: {{ section.settings.badge_icon_color }};
    --igr-badge-label-color: {{ section.settings.badge_label_color }};
    --igr-badge-label-size: {{ section.settings.badge_label_size }}px;
    --igr-badge-label-width-mobile: {{ section.settings.badge_label_width_mobile }}px;

    --igr-button-bg: {{ section.settings.button_background }};
    --igr-button-color: {{ section.settings.button_color }};
    --igr-button-border: {{ section.settings.button_border }};
    --igr-button-bg-hover: {{ section.settings.button_background_hover }};
    --igr-button-color-hover: {{ section.settings.button_color_hover }};
    --igr-button-border-hover: {{ section.settings.button_border_hover }};
    --igr-button-size: {{ section.settings.button_size }}px;
    --igr-button-height: {{ section.settings.button_height }}px;
    --igr-button-max-width: {{ section.settings.button_max_width }}px;
    --igr-button-radius: {{ section.settings.button_radius }}px;
  }
{%- endstyle -%}

<section class="igr igr--{{ section.id }}">
  <div class="igr__inner">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="igr__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="igr__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="igr__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if ingredient_blocks.size > 0 -%}
      <ul class="igr__grid" role="list">
        {%- for block in ingredient_blocks -%}
          <li
            class="igr-tile{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 600
                | image_tag:
                  loading: 'lazy',
                  widths: '240, 320, 480, 600',
                  sizes: '(min-width: 1024px) 241px, calc((100vw - 42px) / 2)',
                  alt: block.settings.image_alt,
                  class: 'igr-tile__photo'
              }}
            {%- endif -%}
            <div class="igr-tile__scrim" aria-hidden="true"></div>
            <div class="igr-tile__body">
              {%- if block.settings.dose != blank -%}
                <p class="igr-tile__dose">{{ block.settings.dose | escape }}</p>
              {%- endif -%}
              <div class="igr-tile__caption">
                {%- if block.settings.name != blank -%}
                  <h3 class="igr-tile__name">{{ block.settings.name | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <p class="igr-tile__desc">{{ block.settings.description }}</p>
                {%- endif -%}
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.note != blank or badge_blocks.size > 0 or section.settings.button_label != blank -%}
      <div class="igr__footer">
        {%- if section.settings.note != blank -%}
          <p class="igr__note">{{ section.settings.note }}</p>
        {%- endif -%}

        {%- if badge_blocks.size > 0 -%}
          <ul class="igr__badges" role="list">
            {%- for block in badge_blocks -%}
              <li class="igr-badge" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 120
                    | image_tag: loading: 'lazy', alt: '', class: 'igr-badge__mark'
                  }}
                {%- else -%}
                  <span class="igr-badge__mark igr-badge__roundel" aria-hidden="true">
                    {%- render 'stage-icon', icon: block.settings.icon, class: 'igr-badge__icon' -%}
                  </span>
                {%- endif -%}
                {%- if block.settings.label != blank -%}
                  <p class="igr-badge__label">{{ block.settings.label | escape }}</p>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a
            class="igr__button"
            {% if section.settings.button_link != blank %}
              href="{{ section.settings.button_link }}"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
          >
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

