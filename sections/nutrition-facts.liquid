  "presets": [
    {
      "name": "Información nutricional",
      "blocks": [
        { "type": "group", "settings": { "title": "Complejo Bloqueador de DHT" } },
        { "type": "row", "settings": { "name": "Extracto de Palma Enana", "amount": "200 mg", "percent": "*" } },
        { "type": "row", "settings": { "name": "Extracto de Semilla de Calabaza", "amount": "100 mg", "percent": "*" } },
