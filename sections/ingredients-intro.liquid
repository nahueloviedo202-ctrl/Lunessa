  ],
  "presets": [
    {
      "name": "Ingredientes: intro",
      "blocks": [
        { "type": "badge", "settings": { "icon": "no_sugar", "label": "Sin Azúcar" } },
        { "type": "badge", "settings": { "icon": "no_gluten", "label": "Sin Gluten" } },
        { "type": "badge", "settings": { "icon": "no_gmo", "label": "Sin OGM" } },
