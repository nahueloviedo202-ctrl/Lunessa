{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-rating.css' | asset_url | stylesheet_tag }}
{{ 'component-rail-controls.css' | asset_url | stylesheet_tag }}
{{ 'section-product-rail.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font

  case section.settings.heading_font_source
    when 'theme_heading'
      assign heading_ff = 'var(--font-heading-family)'
      assign heading_fs = 'var(--font-heading-style)'
    when 'theme_body'
      assign heading_ff = 'var(--font-body-family)'
      assign heading_fs = 'var(--font-body-style)'
    else
      assign heading_ff = heading_font.family | append: ', ' | append: heading_font.fallback_families
      assign heading_fs = heading_font.style
  endcase

  case section.settings.body_font_source
    when 'theme_heading'
      assign body_ff = 'var(--font-heading-family)'
      assign body_fs = 'var(--font-heading-style)'
    when 'theme_body'
      assign body_ff = 'var(--font-body-family)'
      assign body_fs = 'var(--font-body-style)'
    else
      assign body_ff = body_font.family | append: ', ' | append: body_font.fallback_families
      assign body_fs = body_font.style
  endcase

  assign rail_label = section.settings.heading | strip_html
  if rail_label == blank
    assign rail_label = 'general.slider.name' | t
  endif

  assign slider_id = 'Slider-' | append: section.id

  assign show_arrows = false
  if section.settings.show_arrows and section.blocks.size > 1
    assign show_arrows = true
  endif
-%}

{%- style -%}
  {%- if section.settings.heading_font_source == 'custom' -%}
    {{ heading_font | font_face: font_display: 'swap' }}
    {%- assign heading_font_weighted = heading_font | font_modify: 'weight', section.settings.heading_font_weight -%}
    {%- if heading_font_weighted -%}
      {{ heading_font_weighted | font_face: font_display: 'swap' }}
    {%- endif -%}
  {%- endif -%}
  {%- if section.settings.body_font_source == 'custom' -%}
    {{ body_font | font_face: font_display: 'swap' }}
    {%- assign body_font_bold = body_font | font_modify: 'weight', '800' -%}
    {%- if body_font_bold -%}
      {{ body_font_bold | font_face: font_display: 'swap' }}
    {%- endif -%}
  {%- endif -%}

  .product-rail-{{ section.id }} {
    --pr-bg: {{ section.settings.background }};
    --pr-color: {{ section.settings.text_color }};
    --pr-pt: {{ section.settings.padding_top }}px;
    --pr-pb: {{ section.settings.padding_bottom }}px;
    --pr-pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --pr-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --pr-max-width: {{ section.settings.max_width }}px;
    --pr-px: {{ section.settings.padding_x }}px;
    --pr-px-mobile: {{ section.settings.padding_x_mobile }}px;
    --pr-stack-gap: {{ section.settings.stack_gap }}px;
    --pr-heading-ff: {{ heading_ff }};
    --pr-heading-fs: {{ heading_fs }};
    --pr-heading-fw: {{ section.settings.heading_font_weight }};
    --pr-heading-size: {{ section.settings.heading_size }}px;
    --pr-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --pr-heading-tt: {% if section.settings.heading_uppercase %}uppercase{% else %}none{% endif %};
    --pr-body-ff: {{ body_ff }};
    --pr-body-fs: {{ body_fs }};
    --pr-card-width: {{ section.settings.card_width }}px;
    --pr-card-width-mobile: {{ section.settings.card_width_mobile }}px;
    --pr-gap: {{ section.settings.card_gap }}px;
    --pr-gap-mobile: {{ section.settings.card_gap_mobile }}px;
    --pr-media-ratio: {{ section.settings.media_ratio | divided_by: 100.0 }};
    --pr-media-ratio-mobile: {{ section.settings.media_ratio_mobile | divided_by: 100.0 }};
    --pr-radius: {{ section.settings.radius }}px;
    --pr-border: {{ section.settings.card_border }};
    --pr-info-bg: {{ section.settings.info_background }};
    --pr-badge-bg: {{ section.settings.badge_background }};
    --pr-badge-color: {{ section.settings.badge_color }};
    --pr-button-bg: {{ section.settings.button_background }};
    --pr-button-color: {{ section.settings.button_text }};
    --pr-button-bg-hover: {{ section.settings.button_background_hover }};
    --pr-button-color-hover: {{ section.settings.button_text_hover }};
    --pr-focus: {{ section.settings.focus_color }};
    --rail-arrow-bg: {{ section.settings.arrow_background }};
    --rail-arrow-color: {{ section.settings.arrow_color }};
    --rail-arrow-bg-hover: {{ section.settings.arrow_background_hover }};
    --rail-arrow-color-hover: {{ section.settings.arrow_color_hover }};
    --rail-focus: {{ section.settings.focus_color }};
    --rail-subheading-ff: {{ body_ff }};
    --rail-subheading-fs: {{ body_fs }};
    --rail-subheading-size: {{ section.settings.subheading_size }}px;
    --rail-subheading-size-mobile: {{ section.settings.subheading_size_mobile }}px;
  }
{%- endstyle -%}

<div class="product-rail product-rail-{{ section.id }}{% if section.settings.peek %} product-rail--peek{% endif %}">
  <div class="product-rail__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="product-rail__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <slider-component class="product-rail__slider">
      {%- render 'rail-controls',
        slider_id: slider_id,
        subheading: section.settings.subheading,
        show_arrows: show_arrows
      -%}

      <ul
        id="{{ slider_id }}"
        class="slider slider--everywhere product-rail__track list-unstyled"
        role="list"
        aria-label="{{ rail_label | escape }}"
        tabindex="0"
      >
        {%- for block in section.blocks -%}
          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="slider__slide product-rail__slide"
          >
            {%- render 'product-rail-card', block: block -%}
          </li>
        {%- endfor -%}
      </ul>
    </slider-component>
  </div>
</div>

