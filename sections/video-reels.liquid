      "default": "#FFFAF7"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Ancho máximo",
      "min": 640,
      "max": 2040,
      "step": 20,
      "unit": "px",
      "default": 1440
    },
    {
      "type": "range",
      "id": "stack_gap",
      "label": "Separación entre título, videos y botón en escritorio",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "stack_gap_mobile",
      "label": "Separación entre título, videos y botón en móvil y tablet",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Espaciado en escritorio"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaciado superior",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 86
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaciado inferior",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 86
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Espaciado lateral",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Espaciado en móvil y tablet"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Espaciado superior",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Espaciado inferior",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_x_mobile",
      "label": "Espaciado lateral",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Título"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título",
      "default": "Resultados que cambian vidas, contados por veterinarios y clientes"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color",
      "default": "#212427"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Tamaño en escritorio",
      "min": 12,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "heading_line_height",
