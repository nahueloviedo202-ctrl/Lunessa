{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'section-video-reels.css' | asset_url | stylesheet_tag }}
<script src="{{ 'video-reels.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font

  case section.settings.heading_font_source
    when 'theme_heading'
      assign heading_ff = 'var(--font-heading-family)'
      assign heading_fs = 'var(--font-heading-style)'
    when 'theme_body'
      assign heading_ff = 'var(--font-body-family)'
      assign heading_fs = 'var(--font-body-style)'
    else
      assign heading_ff = heading_font.family | append: ', ' | append: heading_font.fallback_families
      assign heading_fs = heading_font.style
  endcase

  case section.settings.body_font_source
    when 'theme_heading'
      assign body_ff = 'var(--font-heading-family)'
      assign body_fs = 'var(--font-heading-style)'
    when 'theme_body'
      assign body_ff = 'var(--font-body-family)'
      assign body_fs = 'var(--font-body-style)'
    else
      assign body_ff = body_font.family | append: ', ' | append: body_font.fallback_families
      assign body_fs = body_font.style
  endcase

  assign tile_width = section.settings.tile_width | append: 'px'
  capture sizes
    echo '(min-width: 990px) ' | append: tile_width | append: ', '
    echo '(min-width: 750px) calc((100vw - 64px) / ' | append: section.settings.columns_tablet | append: '), '
    echo 'calc((100vw - 52px) / ' | append: section.settings.columns_mobile | append: ')'
  endcapture
-%}

{%- style -%}
  {% if section.settings.heading_font_source == 'custom' %}
    {%- assign heading_font_weighted = heading_font | font_modify: 'weight', section.settings.heading_font_weight | default: heading_font -%}
    {{ heading_font_weighted | font_face: font_display: 'swap' }}
  {% endif %}
  {% if section.settings.body_font_source == 'custom' %}
    {{ body_font | font_face: font_display: 'swap' }}
    {%- assign body_font_bold = body_font | font_modify: 'weight', 'bold' -%}
    {{ body_font_bold | font_face: font_display: 'swap' }}
    {%- assign body_font_italic = body_font | font_modify: 'style', 'italic' -%}
    {{ body_font_italic | font_face: font_display: 'swap' }}
  {% endif %}

  .vrl--{{ section.id }} {
    --vrl-bg: {{ section.settings.background_color }};
    --vrl-max-width: {{ section.settings.max_width }}px;
    --vrl-pt: {{ section.settings.padding_top }}px;
    --vrl-pb: {{ section.settings.padding_bottom }}px;
    --vrl-px: {{ section.settings.padding_x }}px;
    --vrl-pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --vrl-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --vrl-px-mobile: {{ section.settings.padding_x_mobile }}px;
    --vrl-stack-gap: {{ section.settings.stack_gap }}px;
    --vrl-stack-gap-mobile: {{ section.settings.stack_gap_mobile }}px;

    --vrl-heading-ff: {{ heading_ff }};
    --vrl-heading-fs: {{ heading_fs }};
    --vrl-heading-fw: {{ section.settings.heading_font_weight }};
    --vrl-heading-color: {{ section.settings.heading_color }};
    --vrl-heading-size: {{ section.settings.heading_size }}px;
    --vrl-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --vrl-heading-lh: {{ section.settings.heading_line_height }}px;
    --vrl-heading-lh-mobile: {{ section.settings.heading_line_height_mobile }}px;
    --vrl-header-gap: {{ section.settings.header_gap }}px;
    --vrl-subheading-color: {{ section.settings.subheading_color }};
    --vrl-subheading-size: {{ section.settings.subheading_size }}px;
    --vrl-subheading-lh: {{ section.settings.subheading_line_height }}px;
    --vrl-subheading-max-width: {{ section.settings.subheading_max_width }}px;
    --vrl-body-ff: {{ body_ff }};
    --vrl-body-fs: {{ body_fs }};

    --vrl-tile-width: {{ tile_width }};
    --vrl-gap: {{ section.settings.gap }}px;
    --vrl-gap-mobile: {{ section.settings.gap_mobile }}px;
    --vrl-columns-tablet: {{ section.settings.columns_tablet }};
    --vrl-columns-mobile: {{ section.settings.columns_mobile }};
    --vrl-snap: {{ section.settings.snap }};
    --vrl-ratio: {{ section.settings.ratio }};
    --vrl-radius: {{ section.settings.radius }}px;
    --vrl-radius-mobile: {{ section.settings.radius_mobile }}px;
    --vrl-icon-color: {{ section.settings.icon_color }};
    --vrl-icon-size: {{ section.settings.icon_size }}px;
    --vrl-icon-size-mobile: {{ section.settings.icon_size_mobile }}px;
    --vrl-focus-color: {{ section.settings.focus_color }};
    --vrl-arrow-color: {{ section.settings.arrow_color }};

    --vrl-footer-gap: {{ section.settings.footer_gap }}px;
    --vrl-button-bg: {{ section.settings.button_background }};
    --vrl-button-color: {{ section.settings.button_color }};
    --vrl-button-border: {{ section.settings.button_border }};
    --vrl-button-bg-hover: {{ section.settings.button_background_hover }};
    --vrl-button-color-hover: {{ section.settings.button_color_hover }};
    --vrl-button-border-hover: {{ section.settings.button_border_hover }};
    --vrl-button-size: {{ section.settings.button_size }}px;
    --vrl-button-height: {{ section.settings.button_height }}px;
    --vrl-button-max-width: {{ section.settings.button_max_width }}px;
    --vrl-button-radius: {{ section.settings.button_radius }}px;
    --vrl-disclaimer-color: {{ section.settings.disclaimer_color }};
    --vrl-disclaimer-size: {{ section.settings.disclaimer_size }}px;
    --vrl-disclaimer-style: {% if section.settings.disclaimer_italic %}italic{% else %}normal{% endif %};
  }
{%- endstyle -%}

<section class="vrl vrl--{{ section.id }}">
  <div class="vrl__inner">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="vrl__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="vrl__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="vrl__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <video-reels
        data-play-label="{{ section.settings.play_label | escape }}"
        data-pause-label="{{ section.settings.pause_label | escape }}"
      >
        <slider-component class="vrl__rail">
          <ul
            id="Slider-{{ section.id }}"
            class="vrl__track slider slider--desktop"
            role="list"
            {% if section.settings.heading != blank %}
              aria-label="{{ section.settings.heading | strip_html | escape }}"
            {% endif %}
          >
            {%- for block in section.blocks -%}
              {%- liquid
                assign video = block.settings.video
                assign media_alt = block.settings.media_alt | default: section.settings.play_label
                if block.settings.image != blank
                  assign poster_image = block.settings.image
                elsif video != blank and video.preview_image != blank
                  assign poster_image = video.preview_image
                else
                  assign poster_image = nil
                endif
              -%}
              <li
                id="Slide-{{ section.id }}-{{ forloop.index }}"
                class="vrl-tile slider__slide"
                data-reel
                {{ block.shopify_attributes }}
              >
                <div class="vrl-tile__frame">
                  {%- if poster_image -%}
                    {{
                      poster_image
                      | image_url: width: 600
                      | image_tag:
                        loading: 'lazy',
                        widths: '252, 320, 480, 504, 600',
                        sizes: sizes,
                        alt: media_alt,
                        class: 'vrl-tile__media'
                    }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'vrl-tile__media placeholder-svg' }}
                  {%- endif -%}

                  {%- if video != blank -%}
                    {%- liquid
                      assign mp4_sources = video.sources | where: 'format', 'mp4' | sort: 'width'
                      assign mp4_source = mp4_sources.last
                      for source in mp4_sources
                        if source.width >= 720
                          assign mp4_source = source
                          break
                        endif
                      endfor
                      assign hls_source = video.sources | where: 'format', 'm3u8' | first
                    -%}
                    <video
                      class="vrl-tile__video"
                      data-revealed="false"
                      aria-label="{{ media_alt | escape }}"
                      aria-hidden="true"
                      loop
                      playsinline
                      preload="none"
                    >
                      {%- if mp4_source -%}
                        <source src="{{ mp4_source.url }}" type="{{ mp4_source.mime_type }}">
                      {%- endif -%}
                      {%- if hls_source -%}
                        <source src="{{ hls_source.url }}" type="{{ hls_source.mime_type }}">
                      {%- endif -%}
                    </video>
                    <button
                      type="button"
                      class="vrl-tile__toggle"
                      data-reel-toggle
                      aria-label="{{ section.settings.play_label | escape }}: {{ media_alt | escape }}"
                    >
                      {%- render 'play-square-icon', icon: 'play', class: 'vrl-tile__icon vrl-tile__icon--play' -%}
                      {%- render 'play-square-icon', icon: 'pause', class: 'vrl-tile__icon vrl-tile__icon--pause' -%}
                    </button>
                  {%- endif -%}
                </div>
              </li>
            {%- endfor -%}
          </ul>

          {%- if section.settings.show_arrows -%}
            <div class="slider-buttons vrl__buttons">
              <button
                type="button"
                class="slider-button slider-button--prev"
                name="previous"
                aria-label="{{ 'general.slider.previous_slide' | t }}"
                aria-controls="Slider-{{ section.id }}"
              >
                <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
              </button>
              <div class="slider-counter caption">
                <span class="slider-counter--current">1</span>
                <span aria-hidden="true"> / </span>
                <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
                <span class="slider-counter--total">{{ section.blocks.size }}</span>
              </div>
              <button
                type="button"
                class="slider-button slider-button--next"
                name="next"
                aria-label="{{ 'general.slider.next_slide' | t }}"
                aria-controls="Slider-{{ section.id }}"
              >
                <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
              </button>
            </div>
          {%- endif -%}
        </slider-component>
      </video-reels>
    {%- endif -%}

    {%- if section.settings.button_label != blank or section.settings.disclaimer != blank -%}
      <div class="vrl__footer">
        {%- if section.settings.button_label != blank -%}
          <a
            class="vrl__button"
            {% if section.settings.button_link != blank %}
              href="{{ section.settings.button_link }}"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
          >
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.disclaimer != blank -%}
          <p class="vrl__disclaimer">{{ section.settings.disclaimer }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Carril de videos",
  "tag": "div",
  "class": "section-video-reels",
  "max_blocks": 16,
  "settings": [
    {
      "type": "header",
      "content": "Diseño"
