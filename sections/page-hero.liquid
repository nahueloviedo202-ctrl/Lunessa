    },
    {
      "type": "color",
      "id": "secondary_color",
      "label": "Secundario: texto y borde",
      "default": "#CDFC4B"
    },
    {
      "type": "color",
      "id": "secondary_color_hover",
      "label": "Secundario: texto y borde al pasar el mouse",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Título",
      "limit": 2,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Título",
          "default": "Un suplemento diferente para tu perro"
        },
        {
          "type": "select",
          "id": "tag",
          "label": "Etiqueta HTML",
          "options": [
            {
              "value": "h1",
              "label": "H1"
            },
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "p",
              "label": "Párrafo"
            }
          ],
          "default": "h1"
        },
        {
          "type": "range",
          "id": "font_size",
          "min": 24,
          "max": 120,
          "step": 2,
          "unit": "px",
          "label": "Tamaño (desktop)",
          "default": 60
        },
        {
          "type": "range",
          "id": "font_size_mobile",
          "min": 16,
          "max": 80,
          "step": 2,
          "unit": "px",
          "label": "Tamaño (mobile)",
          "default": 36
        },
        {
          "type": "range",
          "id": "line_height",
          "min": 70,
          "max": 150,
          "step": 1,
          "unit": "%",
          "label": "Interlineado",
          "default": 82
        },
        {
          "type": "range",
          "id": "letter_spacing",
          "min": -10,
          "max": 20,
          "step": 1,
          "label": "Espaciado entre letras (centésimas de em)",
          "default": -2
        },
        {
          "type": "checkbox",
          "id": "uppercase",
          "label": "Mayúsculas",
          "default": true
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "default": "#FFFFFF"
        },
        {
          "type": "range",
          "id": "max_width",
          "min": 200,
          "max": 1200,
          "step": 10,
          "unit": "px",
          "label": "Ancho máximo",
          "default": 600
        }
      ]
    },
