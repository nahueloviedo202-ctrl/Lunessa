      "default": "theme_body"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Fuente personalizada de textos y botones",
      "default": "assistant_n4"
    },
    {
      "type": "header",
      "content": "Botones"
    },
    {
      "type": "range",
      "id": "button_height",
      "min": 32,
      "max": 72,
      "step": 1,
      "unit": "px",
      "label": "Alto",
      "default": 42
    },
    {
      "type": "range",
      "id": "button_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Radio de bordes",
      "default": 5
    },
    {
      "type": "range",
      "id": "button_font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Tamaño de texto",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_letter_spacing",
      "min": -5,
      "max": 20,
