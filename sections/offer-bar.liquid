{{ 'section-offer-bar.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign body_font = section.settings.body_font

  case section.settings.font_source
    when 'theme_heading'
      assign font_ff = 'var(--font-heading-family)'
      assign font_fs = 'var(--font-heading-style)'
    when 'theme_body'
      assign font_ff = 'var(--font-body-family)'
      assign font_fs = 'var(--font-body-style)'
    else
      assign font_ff = body_font.family | append: ', ' | append: body_font.fallback_families
      assign font_fs = body_font.style
  endcase

  assign background = section.settings.background_gradient
  if background == blank
    assign background = section.settings.background_color
  endif
-%}

{%- style -%}
  {% if section.settings.font_source == 'custom' %}
    {{ body_font | font_face: font_display: 'swap' }}
    {%- assign weights = '' -%}
    {%- for block in section.blocks -%}
      {%- assign weights = weights | append: block.settings.font_weight | append: ',' -%}
    {%- endfor -%}
    {%- assign weights = weights | split: ',' | uniq -%}
    {%- for weight in weights -%}
      {%- assign weighted_font = body_font | font_modify: 'weight', weight -%}
      {{ weighted_font | font_face: font_display: 'swap' }}
    {%- endfor -%}
  {% endif %}

  .offer-bar-{{ section.id }} {
    --ofb-bg: {{ background }};
    --ofb-pt: {{ section.settings.padding_top }}px;
    --ofb-pb: {{ section.settings.padding_bottom }}px;
    --ofb-px: {{ section.settings.padding_x }}px;
    --ofb-pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --ofb-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --ofb-px-mobile: {{ section.settings.padding_x_mobile }}px;
    --ofb-max-width: {{ section.settings.max_width }}px;
    --ofb-align: {{ section.settings.text_alignment }};
    --ofb-ff: {{ font_ff }};
    --ofb-fs: {{ font_fs }};
  }
{%- endstyle -%}

<div class="offer-bar offer-bar-{{ section.id }}">
  {%- if section.settings.link != blank -%}
    <a href="{{ section.settings.link }}" class="offer-bar__inner offer-bar__link">
  {%- else -%}
    <div class="offer-bar__inner">
  {%- endif -%}
  {%- for block in section.blocks -%}
    <p
      class="offer-bar__text"
      style="--size: {{ block.settings.font_size }}px; --size-tablet: {{ block.settings.font_size_tablet }}px; --size-mobile: {{ block.settings.font_size_mobile }}px; --lh: {{ block.settings.line_height }}%; --lh-tablet: {{ block.settings.line_height_tablet }}%; --lh-mobile: {{ block.settings.line_height_mobile }}%; --ls: {{ block.settings.letter_spacing }}px; --weight: {{ block.settings.font_weight }}; --tt: {{ block.settings.text_transform }}; --color: {{ block.settings.color }}; --mt: {{ block.settings.margin_top }}px; --mt-tablet: {{ block.settings.margin_top_tablet }}px; --mt-mobile: {{ block.settings.margin_top_mobile }}px;"
      {{ block.shopify_attributes }}
    >
      {{- block.settings.text -}}
    </p>
  {%- endfor -%}
  {%- if section.settings.link != blank -%}
    </a>
  {%- else -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Barra de oferta",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Degradado de fondo",
      "info": "Si está vacío se usa el color de fondo.",
      "default": "linear-gradient(102deg, rgba(108, 0, 17, 1) 0%, rgba(227, 91, 19, 1) 100%)"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#6C0011"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Enlace de la barra",
      "info": "Opcional. Hace que toda la barra sea clicable."
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alineación del texto",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Ancho máximo del contenido",
      "min": 200,
      "max": 1200,
      "step": 10,
      "unit": "px",
      "default": 550
    },
    {
      "type": "header",
      "content": "Tipografía"
    },
    {
      "type": "select",
      "id": "font_source",
      "label": "Fuente",
      "options": [
        { "value": "custom", "label": "Personalizada" },
        { "value": "theme_heading", "label": "Títulos del tema" },
        { "value": "theme_body", "label": "Cuerpo del tema" }
      ],
      "default": "custom"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Fuente personalizada",
      "default": "inter_n4"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Relleno superior en escritorio",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Relleno inferior en escritorio",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Relleno lateral en escritorio",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Relleno superior en móvil",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Relleno inferior en móvil",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_x_mobile",
      "label": "Relleno lateral en móvil",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Línea de texto",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Texto",
          "default": "OFERTA DE OCTUBRE"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "default": "#FFFFFF"
        },
        {
          "type": "select",
          "id": "font_weight",
          "label": "Grosor",
          "options": [
            { "value": "400", "label": "Normal" },
            { "value": "500", "label": "Medio" },
            { "value": "600", "label": "Seminegrita" },
            { "value": "700", "label": "Negrita" }
          ],
          "default": "700"
        },
        {
          "type": "select",
          "id": "text_transform",
          "label": "Mayúsculas",
          "options": [
            { "value": "none", "label": "Ninguna" },
            { "value": "capitalize", "label": "Capitalizar palabras" },
            { "value": "uppercase", "label": "Mayúsculas" },
            { "value": "lowercase", "label": "Minúsculas" }
          ],
          "default": "none"
        },
        {
          "type": "range",
          "id": "letter_spacing",
          "label": "Espaciado entre letras",
          "min": -2,
          "max": 4,
          "step": 0.1,
          "unit": "px",
          "default": 0
        },
        {
          "type": "header",
          "content": "Tamaño"
        },
        {
          "type": "range",
          "id": "font_size",
          "label": "Tamaño en escritorio",
          "min": 8,
          "max": 40,
          "step": 1,
          "unit": "px",
          "default": 15
        },
        {
          "type": "range",
          "id": "font_size_tablet",
          "label": "Tamaño en tablet",
          "min": 8,
          "max": 40,
          "step": 1,
          "unit": "px",
          "default": 16
        },
        {
          "type": "range",
          "id": "font_size_mobile",
          "label": "Tamaño en móvil",
          "min": 8,
          "max": 40,
          "step": 1,
          "unit": "px",
          "default": 15
        },
        {
          "type": "range",
          "id": "line_height",
          "label": "Interlineado en escritorio",
          "min": 80,
          "max": 200,
          "step": 5,
          "unit": "%",
          "default": 100
        },
        {
          "type": "range",
          "id": "line_height_tablet",
          "label": "Interlineado en tablet",
          "min": 80,
          "max": 200,
          "step": 5,
          "unit": "%",
          "default": 180
        },
        {
          "type": "range",
          "id": "line_height_mobile",
          "label": "Interlineado en móvil",
          "min": 80,
          "max": 200,
          "step": 5,
          "unit": "%",
          "default": 100
        },
        {
          "type": "header",
          "content": "Margen superior"
        },
        {
          "type": "range",
          "id": "margin_top",
          "label": "Escritorio",
          "min": 0,
          "max": 40,
          "step": 1,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "margin_top_tablet",
          "label": "Tablet",
          "min": 0,
          "max": 40,
          "step": 1,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "margin_top_mobile",
          "label": "Móvil",
          "min": 0,
          "max": 40,
          "step": 1,
          "unit": "px",
          "default": 0
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barra de oferta",
      "blocks": [
        { "type": "text" },
        {
          "type": "text",
          "settings": {
            "text": "4 Regalos Gratis + 90 Días de Garantia",
            "font_weight": "400",
            "font_size": 12,
            "font_size_mobile": 12
          }
        }
      ]
    }
  ]
}
{% endschema %}
