      "default": 32
    },
    {
      "type": "range",
      "id": "row_gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Espacio entre filas (desktop)",
      "default": 32
    },
    {
      "type": "range",
      "id": "row_gap_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
