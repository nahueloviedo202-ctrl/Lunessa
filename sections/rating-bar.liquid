      "default": 28
    },
    {
      "type": "checkbox",
      "id": "heading_uppercase",
      "label": "Frase en mayúsculas",
      "default": true
    },
    {
      "type": "range",
      "id": "heading_max_width",
      "min": 200,
      "max": 900,
      "step": 10,
      "unit": "px",
      "label": "Ancho máximo de la frase (desktop)",
      "default": 460
    },
    {
      "type": "range",
      "id": "heading_max_width_mobile",
      "min": 160,
      "max": 600,
      "step": 10,
      "unit": "px",
      "label": "Ancho máximo de la frase (mobile)",
      "default": 320
    },
    {
      "type": "select",
      "id": "body_font_source",
      "label": "Fuente de textos chicos",
      "options": [
        {
          "value": "theme_heading",
          "label": "Títulos del theme"
        },
        {
          "value": "theme_body",
          "label": "Textos del theme"
        },
        {
          "value": "custom",
          "label": "Personalizada"
        }
      ],
      "default": "theme_body"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Fuente personalizada de textos chicos",
      "default": "assistant_n4"
    },
    {
      "type": "range",
