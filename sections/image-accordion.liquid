      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "stack_gap_mobile",
      "label": "Separación entre título, contenido y botón en móvil y tablet",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Separación entre imagen y contenido en escritorio",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "column_gap_mobile",
