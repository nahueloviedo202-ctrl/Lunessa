{{ 'section-image-accordion.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font

  case section.settings.heading_font_source
    when 'theme_heading'
      assign heading_ff = 'var(--font-heading-family)'
      assign heading_fs = 'var(--font-heading-style)'
    when 'theme_body'
      assign heading_ff = 'var(--font-body-family)'
      assign heading_fs = 'var(--font-body-style)'
    else
      assign heading_ff = heading_font.family | append: ', ' | append: heading_font.fallback_families
      assign heading_fs = heading_font.style
  endcase

  case section.settings.body_font_source
    when 'theme_heading'
      assign body_ff = 'var(--font-heading-family)'
      assign body_fs = 'var(--font-heading-style)'
    when 'theme_body'
      assign body_ff = 'var(--font-body-family)'
      assign body_fs = 'var(--font-body-style)'
    else
      assign body_ff = body_font.family | append: ', ' | append: body_font.fallback_families
      assign body_fs = body_font.style
  endcase

  assign accordion_name = 'Accordion-' | append: section.id
-%}

{%- style -%}
  {% if section.settings.heading_font_source == 'custom' %}
    {%- assign heading_font_weighted = heading_font | font_modify: 'weight', section.settings.heading_font_weight | default: heading_font -%}
    {{ heading_font_weighted | font_face: font_display: 'swap' }}
  {% endif %}
  {% if section.settings.body_font_source == 'custom' %}
    {{ body_font | font_face: font_display: 'swap' }}
    {%- assign body_font_bold = body_font | font_modify: 'weight', 'bold' -%}
    {{ body_font_bold | font_face: font_display: 'swap' }}
    {%- assign body_font_italic = body_font | font_modify: 'style', 'italic' -%}
    {{ body_font_italic | font_face: font_display: 'swap' }}
    {%- assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic' -%}
    {{ body_font_bold_italic | font_face: font_display: 'swap' }}
  {% endif %}

  .iac--{{ section.id }} {
    --iac-bg: {{ section.settings.background_color }};
    --iac-max-width: {{ section.settings.max_width }}px;
    --iac-pt: {{ section.settings.padding_top }}px;
    --iac-pb: {{ section.settings.padding_bottom }}px;
    --iac-px: {{ section.settings.padding_x }}px;
    --iac-pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --iac-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --iac-px-mobile: {{ section.settings.padding_x_mobile }}px;
    --iac-stack-gap: {{ section.settings.stack_gap }}px;
    --iac-stack-gap-mobile: {{ section.settings.stack_gap_mobile }}px;
    --iac-column-gap: {{ section.settings.column_gap }}px;
    --iac-column-gap-mobile: {{ section.settings.column_gap_mobile }}px;
    --iac-align: {{ section.settings.vertical_alignment }};
    --iac-content-gap: {{ section.settings.content_gap }}px;

    --iac-image-max-width: {{ section.settings.image_max_width }}px;
    --iac-image-ratio: {{ section.settings.image_ratio }};
    --iac-image-ratio-mobile: {{ section.settings.image_ratio_mobile }};
    --iac-image-radius: {{ section.settings.image_radius }}px;

    --iac-heading-ff: {{ heading_ff }};
    --iac-heading-fs: {{ heading_fs }};
    --iac-heading-fw: {{ section.settings.heading_font_weight }};
    --iac-heading-color: {{ section.settings.heading_color }};
    --iac-heading-size: {{ section.settings.heading_size }}px;
    --iac-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --iac-heading-lh: {{ section.settings.heading_line_height }}px;
    --iac-heading-lh-mobile: {{ section.settings.heading_line_height_mobile }}px;
    --iac-header-gap: {{ section.settings.header_gap }}px;
    --iac-subheading-color: {{ section.settings.subheading_color }};
    --iac-subheading-max-width: {{ section.settings.subheading_max_width }}px;
    --iac-body-ff: {{ body_ff }};
    --iac-body-fs: {{ body_fs }};

    --iac-text-color: {{ section.settings.text_color }};
    --iac-text-size: {{ section.settings.text_size }}px;
    --iac-text-lh: {{ section.settings.text_line_height }}px;
    --iac-text-max-width: {{ section.settings.text_max_width }}px;
    --iac-text-align: {{ section.settings.text_alignment }};

    --iac-row-gap: {{ section.settings.row_gap }}px;
    --iac-row-padding: {{ section.settings.row_padding }}px;
    --iac-list-padding: {{ section.settings.list_padding }}px;
    --iac-divider-color: {{ section.settings.divider_color }};
    --iac-title-color: {{ section.settings.title_color }};
    --iac-title-fw: {{ section.settings.title_font_weight }};
    --iac-title-size: {{ section.settings.title_size }}px;
    --iac-title-lh: {{ section.settings.title_line_height }}px;
    --iac-icon-color: {{ section.settings.icon_color }};
    --iac-icon-size: {{ section.settings.icon_size }}px;
    --iac-body-color: {{ section.settings.body_color }};
    --iac-body-size: {{ section.settings.body_size }}px;
    --iac-body-lh: {{ section.settings.body_line_height }}px;
    --iac-link-color: {{ section.settings.link_color }};

    --iac-button-bg: {{ section.settings.button_background }};
    --iac-button-color: {{ section.settings.button_color }};
    --iac-button-border: {{ section.settings.button_border }};
    --iac-button-bg-hover: {{ section.settings.button_background_hover }};
    --iac-button-color-hover: {{ section.settings.button_color_hover }};
    --iac-button-border-hover: {{ section.settings.button_border_hover }};
    --iac-button-size: {{ section.settings.button_size }}px;
    --iac-button-height: {{ section.settings.button_height }}px;
    --iac-button-max-width: {{ section.settings.button_max_width }}px;
    --iac-button-radius: {{ section.settings.button_radius }}px;
  }
{%- endstyle -%}

<section
  class="iac iac--{{ section.id }}{% if section.settings.image_position == 'right' %} iac--media-right{% endif %}{% unless section.settings.image_first_mobile %} iac--media-last-mobile{% endunless %}"
>
  <div class="iac__inner">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="iac__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="iac__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="iac__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="iac__split">
      <div class="iac__media{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1000
            | image_tag:
              loading: 'lazy',
              widths: '320, 480, 640, 828, 1000',
              sizes: '(min-width: 1024px) 488px, calc(100vw - 32px)',
              class: 'iac__image'
          }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'iac__image placeholder-svg' }}
        {%- endif -%}
      </div>

      <div class="iac__content{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- if section.settings.text != blank -%}
          <div class="iac__text">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="iac__list">
            {%- for block in section.blocks -%}
              <details
                class="iac-item"
                {% if section.settings.exclusive %}
                  name="{{ accordion_name }}"
                {% endif %}
                {% if block.settings.open %}
                  open
                {% endif %}
                {{ block.shopify_attributes }}
              >
                <summary
                  id="Summary-{{ block.id }}"
                  class="iac-item__summary"
                  aria-controls="Details-{{ block.id }}"
                >
                  <span class="iac-item__title">{{ block.settings.title | escape }}</span>
                  <svg
                    class="iac-item__icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    aria-hidden="true"
                    focusable="false"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path d="M2.75 8.25L12 17.5L21.25 8.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </summary>
                <div
                  id="Details-{{ block.id }}"
                  class="iac-item__body"
                  role="region"
                  aria-labelledby="Summary-{{ block.id }}"
                >
                  {{ block.settings.content }}
                </div>
              </details>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.button_label != blank -%}
      <a
        class="iac__button"
        {% if section.settings.button_link != blank %}
          href="{{ section.settings.button_link }}"
        {% else %}
          role="link" aria-disabled="true"
        {% endif %}
      >
        {{- section.settings.button_label | escape -}}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
