{{ 'section-ingredients-filter-grid.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign radio_prefix = 'IngFilter-' | append: section.id | append: '-'
  assign all_radio_id = radio_prefix | append: 'all'

  assign filter_count = 0
  for block in section.blocks
    if block.type == 'filter' and block.settings.label != blank
      assign filter_count = filter_count | plus: 1
    endif
  endfor

  assign show_all = false
  if section.settings.show_all and section.settings.all_label != blank
    assign show_all = true
  endif

  assign show_filters = false
  if filter_count > 0
    assign show_filters = true
  endif

  assign shadow_alpha = section.settings.card_shadow_opacity | divided_by: 100.0
  assign card_shadow = section.settings.card_shadow_color | color_modify: 'alpha', shadow_alpha
-%}

{%- style -%}
  {% render 'ingredients-page-fonts', section: section %}

  .ingf--{{ section.id }} {
    --ingf-bg: {{ section.settings.background }};
    --ingf-pt: {{ section.settings.padding_top }}px;
    --ingf-pb: {{ section.settings.padding_bottom }}px;
    --ingf-pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --ingf-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --ingf-px: {{ section.settings.padding_horizontal }}px;

    --ingf-tabs-mb: {{ section.settings.filters_margin_bottom }}px;
    --ingf-tab-gap: {{ section.settings.filter_gap }}px;
    --ingf-tab-px: {{ section.settings.filter_padding_horizontal }}px;
    --ingf-tab-py: {{ section.settings.filter_padding_vertical }}px;
    --ingf-tab-radius: {{ section.settings.filter_radius }}px;
    --ingf-tab-size: {{ section.settings.filter_size }}px;
    --ingf-tab-color: {{ section.settings.filter_color }};
    --ingf-tab-active-bg: {{ section.settings.filter_active_background }};
    --ingf-tab-active-color: {{ section.settings.filter_active_color }};

    --ingf-max-width: {{ section.settings.max_width }}px;
    --ingf-columns: {{ section.settings.columns_desktop }};
    --ingf-columns-tablet: {{ section.settings.columns_tablet }};
    --ingf-columns-mobile: {{ section.settings.columns_mobile }};
    --ingf-gap: {{ section.settings.grid_gap }}px;

    --ingf-card-bg: {{ section.settings.card_background }};
    --ingf-card-radius: {{ section.settings.card_radius }}px;
    --ingf-card-shadow: {{ card_shadow }};
    --ingf-body-pt: {{ section.settings.card_padding_top }}px;
    --ingf-body-pb: {{ section.settings.card_padding_bottom }}px;
    --ingf-body-px: {{ section.settings.card_padding_horizontal }}px;
    --ingf-image-ratio: {{ section.settings.image_ratio }};
    --ingf-image-fit: {{ section.settings.image_fit }};
    --ingf-image-bg: {{ section.settings.image_background }};

    --ingf-name-size: {{ section.settings.name_size }}px;
    --ingf-name-color: {{ section.settings.name_color }};
    --ingf-desc-size: {{ section.settings.description_size }}px;
    --ingf-desc-color: {{ section.settings.description_color }};
    --ingf-tag-size: {{ section.settings.tag_size }}px;
    --ingf-tag-color: {{ section.settings.tag_color }};
    --ingf-tag-radius: {{ section.settings.tag_radius }}px;
  }

  {%- for block in section.blocks -%}
    {%- if block.type == 'filter' and block.settings.label != blank -%}
      {%- assign filter_handle = block.settings.label | handleize %}
      .ingf--{{ section.id }}:has([id="{{ radio_prefix }}{{ block.id }}"]:checked) .ingf-card:not([data-filters~="{{ filter_handle }}"]) {
        display: none;
      }
    {%- endif -%}
  {%- endfor %}
{%- endstyle -%}

<div class="ingf ingf--{{ section.id }}">
  {%- if show_filters -%}
    <div
      class="ingf__filters"
      role="radiogroup"
      {% if section.settings.filters_label != blank %}
        aria-label="{{ section.settings.filters_label | escape }}"
      {% endif %}
    >
      {%- if show_all -%}
        <input
          type="radio"
          class="ingf__radio visually-hidden"
          name="IngFilter-{{ section.id }}"
          id="{{ all_radio_id }}"
          checked
        >
        <label for="{{ all_radio_id }}" class="ingf__filter">{{ section.settings.all_label | escape }}</label>
      {%- endif -%}

      {%- assign first_filter = true -%}
      {%- for block in section.blocks -%}
        {%- if block.type != 'filter' or block.settings.label == blank -%}
          {%- continue -%}
        {%- endif -%}
        {%- assign radio_id = radio_prefix | append: block.id -%}
        <input
          type="radio"
          class="ingf__radio visually-hidden"
          name="IngFilter-{{ section.id }}"
          id="{{ radio_id }}"
          {% if show_all == false and first_filter %}
            checked
          {% endif %}
        >
        <label
          for="{{ radio_id }}"
          class="ingf__filter"
          data-filter-radio="{{ radio_id }}"
          {{ block.shopify_attributes }}
        >
          {{- block.settings.label | escape -}}
        </label>
        {%- assign first_filter = false -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  <ul class="ingf__grid list-unstyled" role="list">
    {%- for block in section.blocks -%}
      {%- if block.type != 'ingredient' -%}
        {%- continue -%}
      {%- endif -%}
      {%- liquid
        assign card_filters = ''
        assign categories = block.settings.categories | split: ','
        for category in categories
          assign category_handle = category | strip | handleize
          if category_handle != blank
            assign card_filters = card_filters | append: category_handle | append: ' '
          endif
        endfor
      -%}
      <li
        class="ingf-card"
        data-filters="{{ card_filters | strip }}"
        {% if show_filters and show_all %}
          data-filter-radio="{{ all_radio_id }}"
        {% endif %}
        {{ block.shopify_attributes }}
      >
        <div class="ingf-card__media">
          {%- if block.settings.image != blank -%}
            {%- assign image_alt = block.settings.image.alt | default: block.settings.name | escape -%}
            {{
              block.settings.image
              | image_url: width: 900
              | image_tag:
                loading: 'lazy',
                widths: '300, 450, 600, 750, 900',
                sizes: '(min-width: 1000px) 370px, (min-width: 640px) 50vw, 100vw',
                class: 'ingf-card__image',
                alt: image_alt
            }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'ingf-card__image ingf-card__image--placeholder placeholder-svg' }}
          {%- endif -%}
        </div>
        <div class="ingf-card__body">
          {%- if block.settings.name != blank -%}
            <h3 class="ingf-card__name">{{ block.settings.name | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.description != blank -%}
            <p class="ingf-card__description">{{ block.settings.description }}</p>
          {%- endif -%}
          {%- if block.settings.tag != blank -%}
            <span class="ingf-card__tag">{{ block.settings.tag | escape }}</span>
          {%- endif -%}
        </div>
      </li>
    {%- endfor -%}
  </ul>
</div>

{%- if request.design_mode -%}
  <script>
    document.addEventListener('shopify:block:select', (event) => {
      const radioId = event.target.dataset.filterRadio;
      const radio = radioId && document.getElementById(radioId);
      if (radio) radio.checked = true;
    });
  </script>
{%- endif -%}

{% schema %}
{
