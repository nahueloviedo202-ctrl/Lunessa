{{ 'section-review-photos.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font
  assign script_font = section.settings.script_font

  case section.settings.heading_font_source
    when 'theme_heading'
      assign heading_ff = 'var(--font-heading-family)'
      assign heading_fs = 'var(--font-heading-style)'
    when 'theme_body'
      assign heading_ff = 'var(--font-body-family)'
      assign heading_fs = 'var(--font-body-style)'
    else
      assign heading_ff = heading_font.family | append: ', ' | append: heading_font.fallback_families
      assign heading_fs = heading_font.style
  endcase

  case section.settings.body_font_source
    when 'theme_heading'
      assign body_ff = 'var(--font-heading-family)'
      assign body_fs = 'var(--font-heading-style)'
    when 'theme_body'
      assign body_ff = 'var(--font-body-family)'
      assign body_fs = 'var(--font-body-style)'
    else
      assign body_ff = body_font.family | append: ', ' | append: body_font.fallback_families
      assign body_fs = body_font.style
  endcase

  assign script_ff = script_font.family | append: ', ' | append: script_font.fallback_families
  assign overlay_alpha = section.settings.overlay_opacity | divided_by: 100.0
  assign overlay = section.settings.overlay_color | color_modify: 'alpha', overlay_alpha
  assign heading_id = 'ReviewPhotos-Heading-' | append: section.id
-%}

{%- style -%}
  {%- if section.settings.heading_font_source == 'custom' -%}
    {{ heading_font | font_face: font_display: 'swap' }}
    {%- assign heading_font_weighted = heading_font | font_modify: 'weight', section.settings.heading_font_weight -%}
    {%- if heading_font_weighted -%}
      {{ heading_font_weighted | font_face: font_display: 'swap' }}
    {%- endif -%}
  {%- endif -%}
  {%- if section.settings.body_font_source == 'custom' -%}
    {{ body_font | font_face: font_display: 'swap' }}
    {%- assign body_font_bold = body_font | font_modify: 'weight', '800' -%}
    {%- if body_font_bold -%}
      {{ body_font_bold | font_face: font_display: 'swap' }}
    {%- endif -%}
  {%- endif -%}
  {{ script_font | font_face: font_display: 'swap' }}

  .review-photos-{{ section.id }} {
    --rp-bg: {{ section.settings.background }};
    --rp-heading-color: {{ section.settings.heading_color }};
    --rp-card-frame: {{ section.settings.card_frame }};
    --rp-card-color: {{ section.settings.card_text_color }};
    --rp-badge-bg: {{ section.settings.badge_background }};
    --rp-badge-color: {{ section.settings.badge_text_color }};
    --rp-overlay: {{ overlay }};
    --rp-button-bg: {{ section.settings.button_background }};
    --rp-button-color: {{ section.settings.button_text }};
    --rp-button-bg-hover: {{ section.settings.button_background_hover }};
    --rp-button-color-hover: {{ section.settings.button_text_hover }};
    --rp-pt: {{ section.settings.padding_top }}px;
    --rp-pb: {{ section.settings.padding_bottom }}px;
    --rp-pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --rp-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --rp-max-width: {{ section.settings.max_width }}px;
    --rp-cards-max-width: {{ section.settings.cards_max_width }}px;
    --rp-px: {{ section.settings.padding_x }}px;
    --rp-px-mobile: {{ section.settings.padding_x_mobile }}px;
    --rp-stack-gap: {{ section.settings.stack_gap }}px;
    --rp-gap: {{ section.settings.card_gap }}px;
    --rp-gap-mobile: {{ section.settings.card_gap_mobile }}px;
    --rp-columns: {{ section.settings.columns_desktop }};
    --rp-card-min-height: {{ section.settings.card_min_height }}px;
    --rp-radius: {{ section.settings.radius }}px;
    --rp-heading-ff: {{ heading_ff }};
    --rp-heading-fs: {{ heading_fs }};
    --rp-heading-fw: {{ section.settings.heading_font_weight }};
    --rp-heading-size: {{ section.settings.heading_size }}px;
    --rp-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --rp-heading-tt: {% if section.settings.heading_uppercase %}uppercase{% else %}none{% endif %};
    --rp-body-ff: {{ body_ff }};
    --rp-body-fs: {{ body_fs }};
    --rp-subheading-size: {{ section.settings.subheading_size }}px;
    --rp-subheading-size-mobile: {{ section.settings.subheading_size_mobile }}px;
    --rp-script-ff: {{ script_ff }};
    --rp-script-fs: {{ script_font.style }};
    --rp-script-fw: {{ script_font.weight }};
    --rp-script-size: {{ section.settings.script_size }}px;
    --rp-quote-size: {{ section.settings.quote_size }}px;
  }
{%- endstyle -%}

<div
  class="review-photos review-photos-{{ section.id }}"
  {% if section.settings.heading != blank %}
    role="region" aria-labelledby="{{ heading_id }}"
  {% endif %}
>
  <div class="review-photos__container">
    {%- if section.settings.heading != blank -%}
      <h2 id="{{ heading_id }}" class="review-photos__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="review-photos__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="review-photos__list list-unstyled" role="list">
        {%- for block in section.blocks -%}
          <li class="review-photos__item">
            {%- render 'review-photo-card', block: block -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a
        {% if section.settings.button_link != blank %}
          href="{{ section.settings.button_link }}"
        {% else %}
          role="link" aria-disabled="true"
        {% endif %}
        class="review-photos__button"
      >
        {{- section.settings.button_label | escape -}}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
