{{ 'section-quality-standards.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font

  case section.settings.heading_font_source
    when 'theme_heading'
      assign heading_ff = 'var(--font-heading-family)'
      assign heading_fs = 'var(--font-heading-style)'
    when 'theme_body'
      assign heading_ff = 'var(--font-body-family)'
      assign heading_fs = 'var(--font-body-style)'
    else
      assign heading_ff = heading_font.family | append: ', ' | append: heading_font.fallback_families
      assign heading_fs = heading_font.style
  endcase

  case section.settings.body_font_source
    when 'theme_heading'
      assign body_ff = 'var(--font-heading-family)'
      assign body_fs = 'var(--font-heading-style)'
    when 'theme_body'
      assign body_ff = 'var(--font-body-family)'
      assign body_fs = 'var(--font-body-style)'
    else
      assign body_ff = body_font.family | append: ', ' | append: body_font.fallback_families
      assign body_fs = body_font.style
  endcase
-%}

{%- style -%}
  {% if section.settings.heading_font_source == 'custom' %}
    {%- assign heading_font_weighted = heading_font | font_modify: 'weight', section.settings.heading_font_weight | default: heading_font -%}
    {{ heading_font_weighted | font_face: font_display: 'swap' }}
  {% endif %}
  {% if section.settings.body_font_source == 'custom' %}
    {{ body_font | font_face: font_display: 'swap' }}
    {%- assign body_font_bold = body_font | font_modify: 'weight', 'bold' -%}
    {{ body_font_bold | font_face: font_display: 'swap' }}
  {% endif %}

  .qst--{{ section.id }} {
    --qst-bg: {{ section.settings.background_color }};
    --qst-max-width: {{ section.settings.max_width }}px;
    --qst-pt: {{ section.settings.padding_top }}px;
    --qst-pb: {{ section.settings.padding_bottom }}px;
    --qst-px: {{ section.settings.padding_x }}px;
    --qst-pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --qst-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --qst-px-mobile: {{ section.settings.padding_x_mobile }}px;
    --qst-stack-gap: {{ section.settings.stack_gap }}px;
    --qst-stack-gap-mobile: {{ section.settings.stack_gap_mobile }}px;
    --qst-column-gap: {{ section.settings.column_gap }}px;
    --qst-column-gap-mobile: {{ section.settings.column_gap_mobile }}px;
    --qst-content-gap: {{ section.settings.content_gap }}px;

    --qst-image-max-width: {{ section.settings.image_max_width }}px;
    --qst-image-ratio: {{ section.settings.image_ratio }};
    --qst-image-ratio-mobile: {{ section.settings.image_ratio_mobile }};
    --qst-image-radius: {{ section.settings.image_radius }}px;

    --qst-heading-ff: {{ heading_ff }};
    --qst-heading-fs: {{ heading_fs }};
    --qst-heading-fw: {{ section.settings.heading_font_weight }};
    --qst-heading-color: {{ section.settings.heading_color }};
    --qst-heading-size: {{ section.settings.heading_size }}px;
    --qst-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --qst-heading-lh: {{ section.settings.heading_line_height }}px;
    --qst-heading-lh-mobile: {{ section.settings.heading_line_height_mobile }}px;
    --qst-header-gap: {{ section.settings.header_gap }}px;
    --qst-subheading-color: {{ section.settings.subheading_color }};
    --qst-subheading-size: {{ section.settings.subheading_size }}px;
    --qst-subheading-lh: {{ section.settings.subheading_line_height }}px;
    --qst-subheading-max-width: {{ section.settings.subheading_max_width }}px;
    --qst-body-ff: {{ body_ff }};
    --qst-body-fs: {{ body_fs }};

    --qst-badge-columns: {{ section.settings.badge_columns }};
    --qst-badge-columns-mobile: {{ section.settings.badge_columns_mobile }};
    --qst-badge-column-width: {{ section.settings.badge_column_width }}px;
    --qst-badge-gap: {{ section.settings.badge_gap }}px;
    --qst-badge-gap-mobile: {{ section.settings.badge_gap_mobile }}px;
    --qst-badge-inner-gap: {{ section.settings.badge_inner_gap }}px;
    --qst-badge-inner-gap-mobile: {{ section.settings.badge_inner_gap_mobile }}px;
    --qst-badge-size: {{ section.settings.badge_size }}px;
    --qst-badge-size-mobile: {{ section.settings.badge_size_mobile }}px;
    --qst-badge-icon-color: {{ section.settings.badge_icon_color }};
    --qst-badge-label-color: {{ section.settings.badge_label_color }};
    --qst-badge-label-size: {{ section.settings.badge_label_size }}px;

    --qst-button-bg: {{ section.settings.button_background }};
    --qst-button-color: {{ section.settings.button_color }};
    --qst-button-border: {{ section.settings.button_border }};
    --qst-button-bg-hover: {{ section.settings.button_background_hover }};
    --qst-button-color-hover: {{ section.settings.button_color_hover }};
    --qst-button-border-hover: {{ section.settings.button_border_hover }};
    --qst-button-size: {{ section.settings.button_size }}px;
    --qst-button-height: {{ section.settings.button_height }}px;
    --qst-button-max-width: {{ section.settings.button_max_width }}px;
    --qst-button-radius: {{ section.settings.button_radius }}px;
  }
{%- endstyle -%}

<section
  class="qst qst--{{ section.id }}{% if section.settings.image_position == 'right' %} qst--media-right{% endif %}{% unless section.settings.image_first_mobile %} qst--media-last-mobile{% endunless %}"
>
  <div class="qst__inner">
    <div class="qst__split">
      <div class="qst__media{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1000
            | image_tag:
              loading: 'lazy',
              widths: '320, 480, 640, 828, 1000',
              sizes: '(min-width: 1024px) 464px, calc(100vw - 32px)',
              class: 'qst__image'
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'qst__image placeholder-svg' }}
        {%- endif -%}
      </div>

      <div class="qst__content{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
          <div class="qst__header">
            {%- if section.settings.heading != blank -%}
              <h2 class="qst__heading">{{ section.settings.heading }}</h2>
            {%- endif -%}
            {%- if section.settings.subheading != blank -%}
              <p class="qst__subheading">{{ section.settings.subheading }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="qst__badges" role="list">
            {%- for block in section.blocks -%}
              <li class="qst-badge" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 200
                    | image_tag: loading: 'lazy', alt: '', class: 'qst-badge__mark'
                  }}
                {%- else -%}
                  <span class="qst-badge__mark qst-badge__roundel" aria-hidden="true">
                    {%- render 'stage-icon', icon: block.settings.icon, class: 'qst-badge__icon' -%}
                  </span>
                {%- endif -%}
                {%- if block.settings.label != blank -%}
                  <p class="qst-badge__label">{{ block.settings.label | escape }}</p>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.button_label != blank -%}
      <a
        class="qst__button"
        {% if section.settings.button_link != blank %}
          href="{{ section.settings.button_link }}"
        {% else %}
          role="link" aria-disabled="true"
        {% endif %}
      >
        {{- section.settings.button_label | escape -}}
      </a>
    {%- endif -%}
  </div>
</section>

