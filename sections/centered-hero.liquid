{{ 'section-centered-hero.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {%- if section.settings.heading_font_custom -%}
    {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if section.settings.body_font_custom -%}
    {{ section.settings.body_font | font_face: font_display: 'swap' }}
  {%- endif -%}

  .chr--{{ section.id }} {
    {%- if section.settings.heading_font_custom %}
      --chr-heading-font: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
      --chr-heading-style: {{ section.settings.heading_font.style }};
    {%- endif %}
    {%- if section.settings.body_font_custom %}
      --chr-body-font: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
      --chr-body-style: {{ section.settings.body_font.style }};
    {%- endif %}
    --chr-bg: {{ section.settings.background }};
    --chr-color: {{ section.settings.text_color }};
    --chr-align: {{ section.settings.alignment }};
    --chr-max-width: {{ section.settings.max_width }}px;
    --chr-pt: {{ section.settings.padding_top }}px;
    --chr-pb: {{ section.settings.padding_bottom }}px;
    --chr-pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --chr-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --chr-px: {{ section.settings.padding_horizontal }}px;
  }
{%- endstyle -%}

{%- liquid
  case section.settings.alignment
    when 'left'
      assign chr_items = 'flex-start'
    when 'right'
      assign chr_items = 'flex-end'
    else
      assign chr_items = 'center'
  endcase
-%}

<section class="chr chr--{{ section.id }}" style="--chr-items: {{ chr_items }};">
  <div class="chr__inner">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'eyebrow' -%}
          <p
            class="chr__eyebrow"
            style="--chr-block-mt: {{ block.settings.margin_top }}px; --chr-eyebrow-color: {{ block.settings.text_color }}; --chr-eyebrow-bg: {{ block.settings.background }}; --chr-eyebrow-size: {{ block.settings.text_size }}px;"
            {{ block.shopify_attributes }}
          >
            {{- block.settings.text | escape -}}
          </p>

        {%- when 'heading' -%}
          <{{ block.settings.heading_tag }}
            class="chr__heading"
            style="--chr-block-mt: {{ block.settings.margin_top }}px; --chr-heading-color: {{ block.settings.text_color }}; --chr-heading-size: {{ block.settings.text_size }}px; --chr-heading-size-mobile: {{ block.settings.text_size_mobile }}px; --chr-heading-weight: {{ block.settings.font_weight }}; --chr-heading-lh: {{ block.settings.line_height | divided_by: 100.0 }}; --chr-heading-max: {{ block.settings.max_width }}px;"
            {{ block.shopify_attributes }}
          >
            {{- block.settings.heading -}}
          </{{ block.settings.heading_tag }}>

        {%- when 'text' -%}
          <div
            class="chr__text rte"
            style="--chr-block-mt: {{ block.settings.margin_top }}px; --chr-text-color: {{ block.settings.text_color }}; --chr-text-size: {{ block.settings.text_size }}px; --chr-text-size-mobile: {{ block.settings.text_size_mobile }}px; --chr-text-lh: {{ block.settings.line_height | divided_by: 100.0 }}; --chr-text-max: {{ block.settings.max_width }}px;"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.text }}
          </div>

        {%- when 'image' -%}
          <div
            class="chr__media"
            style="--chr-block-mt: {{ block.settings.margin_top }}px; --chr-image-max: {{ block.settings.max_width }}px; --chr-image-max-mobile: {{ block.settings.max_width_mobile }}px; --chr-image-radius: {{ block.settings.radius }}px;"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.image != blank -%}
              {%- capture image_sizes -%}
                (min-width: 750px) {{ block.settings.max_width }}px, min({{ block.settings.max_width_mobile }}px, 100vw)
              {%- endcapture -%}
              {%- liquid
                if section.index > 2
                  assign image_loading = 'lazy'
                else
                  assign image_loading = 'eager'
                endif
              -%}
              {{
                block.settings.image
                | image_url: width: 1600
                | image_tag:
                  loading: image_loading,
                  widths: '340, 480, 680, 1000, 1600',
                  sizes: image_sizes,
                  class: 'chr__image'
              }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'chr__image chr__image--placeholder placeholder-svg' }}
            {%- endif -%}
          </div>

        {%- when 'button' -%}
          <div
            class="chr__button-wrapper"
            style="--chr-block-mt: {{ block.settings.margin_top }}px;"
            {{ block.shopify_attributes }}
          >
            <a
              class="chr__button{% if block.settings.full_width_mobile %} chr__button--full-mobile{% endif %}"
              {% if block.settings.link != blank %}
                href="{{ block.settings.link }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
              style="--chr-button-bg: {{ block.settings.background }}; --chr-button-color: {{ block.settings.text_color }}; --chr-button-size: {{ block.settings.text_size }}px; --chr-button-weight: {{ block.settings.font_weight }}; --chr-button-py: {{ block.settings.padding_vertical }}px; --chr-button-px: {{ block.settings.padding_horizontal }}px; --chr-button-radius: {{ block.settings.radius }}px;"
            >
              {{- block.settings.label | escape -}}
            </a>
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

