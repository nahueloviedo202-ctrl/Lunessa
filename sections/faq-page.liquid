{{ 'section-faq-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'drag-scroll.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'faq-page.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  {%- if section.settings.heading_font_custom -%}
    {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if section.settings.body_font_custom -%}
    {{ section.settings.body_font | font_face: font_display: 'swap' }}
  {%- endif -%}

  .fqp--{{ section.id }} {
    {%- if section.settings.heading_font_custom %}
      --fqp-heading-font: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
      --fqp-heading-style: {{ section.settings.heading_font.style }};
    {%- endif %}
    {%- if section.settings.body_font_custom %}
      --fqp-body-font: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
      --fqp-body-style: {{ section.settings.body_font.style }};
    {%- endif %}
    --fqp-bg: {{ section.settings.background }};
    --fqp-max-width: {{ section.settings.max_width }}px;
    --fqp-heading-color: {{ section.settings.heading_color }};

    --fqp-hero-pt: {{ section.settings.hero_padding_top }}px;
    --fqp-hero-pb: {{ section.settings.hero_padding_bottom }}px;
    --fqp-title-size: {{ section.settings.title_size }}px;
    --fqp-title-size-mobile: {{ section.settings.title_size_mobile }}px;
    --fqp-intro-color: {{ section.settings.intro_color }};
    --fqp-intro-size: {{ section.settings.intro_size }}px;
    --fqp-intro-max: {{ section.settings.intro_max_width }}px;
    --fqp-updated-color: {{ section.settings.updated_color }};
    --fqp-updated-strong: {{ section.settings.updated_strong_color }};

    --fqp-layout-pt: {{ section.settings.layout_padding_top }}px;
    --fqp-layout-pb: {{ section.settings.layout_padding_bottom }}px;
    --fqp-nav-width: {{ section.settings.nav_width }}px;
    --fqp-nav-top: {{ section.settings.nav_sticky_top }}px;
    --fqp-nav-color: {{ section.settings.nav_color }};
    --fqp-nav-bg: {{ section.settings.nav_background }};
    --fqp-nav-border: {{ section.settings.nav_border }};
    --fqp-nav-active-color: {{ section.settings.nav_active_color }};
    --fqp-nav-active-bg: {{ section.settings.nav_active_background }};

    --fqp-category-size: {{ section.settings.category_size }}px;
    --fqp-category-size-mobile: {{ section.settings.category_size_mobile }}px;
    --fqp-question-color: {{ section.settings.question_color }};
    --fqp-question-size: {{ section.settings.question_size }}px;
    --fqp-answer-color: {{ section.settings.answer_color }};
    --fqp-answer-size: {{ section.settings.answer_size }}px;
    --fqp-link-color: {{ section.settings.link_color }};
  }
{%- endstyle -%}

<section class="fqp fqp--{{ section.id }}">
  {%- if section.settings.show_hero -%}
    <div class="fqp__hero">
      {%- if section.settings.title != blank -%}
        <{{ section.settings.title_tag }} class="fqp__title">{{ section.settings.title }}</{{ section.settings.title_tag }}>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <div class="fqp__intro rte">{{ section.settings.intro }}</div>
      {%- endif -%}
      {%- if section.settings.updated != blank -%}
        <p class="fqp__updated">{{ section.settings.updated }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    {%- liquid
      assign category_count = section.blocks | where: 'type', 'category' | size
    -%}
    <div class="fqp__layout{% if category_count == 0 %} fqp__layout--no-nav{% endif %}">
      {%- if category_count > 0 -%}
        <faq-scrollspy class="fqp__aside">
          <drag-scroll class="fqp__nav-scroller" data-faq-scroller>
            <nav class="fqp__nav" aria-label="{{ section.settings.title | strip_html | escape }}">
              {%- assign is_first_link = true -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'category' -%}
                  {%- assign anchor = block.settings.anchor | default: block.settings.title | handleize -%}
                  <a
                    href="#{{ anchor }}"
                    class="fqp__nav-link{% if is_first_link %} is-active{% endif %}"
                    {% if is_first_link %}
                      aria-current="true"
                    {% endif %}
                  >
                    {{- block.settings.title | escape -}}
                  </a>
                  {%- assign is_first_link = false -%}
                {%- endif -%}
              {%- endfor -%}
            </nav>
          </drag-scroll>
        </faq-scrollspy>
      {%- endif -%}

      <div class="fqp__content">
        {%- for block in section.blocks -%}
          {%- comment -%}
            Questions are rendered by the category before them; only questions placed
            before the first category are rendered here, as an untitled group.
          {%- endcomment -%}
          {%- if block.type == 'question' and forloop.index0 > 0 -%}
            {%- continue -%}
          {%- endif -%}

          {%- liquid
            if block.type == 'category'
              assign questions_offset = forloop.index
              assign anchor = block.settings.anchor | default: block.settings.title | handleize
            else
              assign questions_offset = 0
              assign anchor = ''
            endif
          -%}
          <div
            class="fqp__group"
            {% if anchor != blank %}
              id="{{ anchor }}"
            {% endif %}
            {% if block.type == 'category' %}
              {{ block.shopify_attributes }}
            {% endif %}
          >
            {%- if block.type == 'category' and block.settings.title != blank -%}
              <h2 class="fqp__category">{{ block.settings.title | escape }}</h2>
            {%- endif -%}
            {%- for item in section.blocks offset: questions_offset -%}
              {%- if item.type != 'question' -%}
                {%- break -%}
              {%- endif -%}
              <div class="fqp__item" {{ item.shopify_attributes }}>
                <h3 class="fqp__question">{{ item.settings.question | escape }}</h3>
                <div class="fqp__answer rte">{{ item.settings.answer }}</div>
              </div>
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
