{{ 'section-prose-split-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font

  case section.settings.heading_font_source
    when 'theme_heading'
      assign heading_ff = 'var(--font-heading-family)'
      assign heading_fs = 'var(--font-heading-style)'
    when 'theme_body'
      assign heading_ff = 'var(--font-body-family)'
      assign heading_fs = 'var(--font-body-style)'
    else
      assign heading_ff = heading_font.family | append: ', ' | append: heading_font.fallback_families
      assign heading_fs = heading_font.style
  endcase

  case section.settings.body_font_source
    when 'theme_heading'
      assign body_ff = 'var(--font-heading-family)'
      assign body_fs = 'var(--font-heading-style)'
    when 'theme_body'
      assign body_ff = 'var(--font-body-family)'
      assign body_fs = 'var(--font-body-style)'
    else
      assign body_ff = body_font.family | append: ', ' | append: body_font.fallback_families
      assign body_fs = body_font.style
  endcase

  case section.settings.text_alignment
    when 'left'
      assign align_items = 'flex-start'
    when 'right'
      assign align_items = 'flex-end'
    else
      assign align_items = 'center'
  endcase

  assign image = section.settings.image
  assign image_mobile = section.settings.image_mobile | default: image
  assign focal = image.presentation.focal_point | default: 'center'
  assign focal_mobile = image_mobile.presentation.focal_point | default: 'center'

  if section.index == 1
    assign media_loading = 'eager'
    assign media_priority = 'high'
  else
    assign media_loading = 'lazy'
    assign media_priority = 'auto'
  endif

  assign bleed_factor = section.settings.media_bleed_mobile | times: 2 | plus: 100 | divided_by: 100.0
  assign mobile_vw = bleed_factor | times: 100 | round
  assign media_sizes = '(min-width: 750px) min(' | append: section.settings.media_width | append: 'px, 55vw), ' | append: mobile_vw | append: 'vw'
-%}

{%- style -%}
  {%- if section.settings.heading_font_source == 'custom' -%}
    {{ heading_font | font_face: font_display: 'swap' }}
    {%- assign heading_font_weighted = heading_font | font_modify: 'weight', section.settings.heading_font_weight -%}
    {%- if heading_font_weighted -%}
      {{ heading_font_weighted | font_face: font_display: 'swap' }}
    {%- endif -%}
  {%- endif -%}
  {%- if section.settings.body_font_source == 'custom' -%}
    {{ body_font | font_face: font_display: 'swap' }}
    {%- assign body_font_weighted = body_font | font_modify: 'weight', section.settings.body_font_weight -%}
    {%- if body_font_weighted -%}
      {{ body_font_weighted | font_face: font_display: 'swap' }}
    {%- endif -%}
  {%- endif -%}

  .prose-split-hero-{{ section.id }} {
    --psh-bg-start: {{ section.settings.background_start }};
    --psh-bg-end: {{ section.settings.background_end }};
    --psh-bg-stop-start: {{ section.settings.background_stop_start }}%;
    --psh-bg-stop-end: {{ section.settings.background_stop_end }}%;
    --psh-bg-stop-start-mobile: {{ section.settings.background_stop_start_mobile }}%;
    --psh-bg-stop-end-mobile: {{ section.settings.background_stop_end_mobile }}%;
    --psh-heading-color: {{ section.settings.heading_color }};
    --psh-text-color: {{ section.settings.text_color }};
    --psh-pt: {{ section.settings.padding_top }}px;
    --psh-pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --psh-pl: {{ section.settings.padding_left }}px;
    --psh-pl-max: {{ section.settings.padding_left_max }}px;
    --psh-px-mobile: {{ section.settings.padding_x_mobile }}px;
    --psh-gap: {{ section.settings.column_gap }}px;
    --psh-gap-mobile: {{ section.settings.column_gap_mobile }}px;
    --psh-copy-width: {{ section.settings.copy_width }}px;
    --psh-copy-min-height: {{ section.settings.copy_min_height }}px;
    --psh-copy-gap: {{ section.settings.copy_gap }}px;
    --psh-copy-gap-mobile: {{ section.settings.copy_gap_mobile }}px;
    --psh-prose-width: {{ section.settings.prose_width }}px;
    --psh-paragraph-gap: {{ section.settings.paragraph_gap }}px;
    --psh-paragraph-gap-mobile: {{ section.settings.paragraph_gap_mobile }}px;
    --psh-text-align: {{ section.settings.text_alignment }};
    --psh-align-items: {{ align_items }};
    --psh-media-width: {{ section.settings.media_width }}px;
    --psh-ratio: 100 / {{ section.settings.media_ratio }};
    --psh-ratio-mobile: 100 / {{ section.settings.media_ratio_mobile }};
    --psh-radius: {{ section.settings.media_radius }}px;
    --psh-zoom: {{ section.settings.image_zoom | divided_by: 100.0 }};
    --psh-zoom-mobile: {{ section.settings.image_zoom_mobile | divided_by: 100.0 }};
    --psh-focal: {{ focal }};
    --psh-focal-mobile: {{ focal_mobile }};
    --psh-bleed-mobile: {{ section.settings.media_bleed_mobile }}%;
    --psh-crop-bottom-mobile: {{ section.settings.media_crop_bottom_mobile }}%;
    --psh-heading-ff: {{ heading_ff }};
    --psh-heading-fs: {{ heading_fs }};
    --psh-heading-fw: {{ section.settings.heading_font_weight }};
    --psh-heading-size: {{ section.settings.heading_size }}px;
    --psh-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --psh-heading-lh: {{ section.settings.heading_line_height | divided_by: 100.0 }};
    --psh-heading-ls: {{ section.settings.heading_letter_spacing | divided_by: 1000.0 }}em;
    --psh-heading-tt: {% if section.settings.heading_uppercase %}uppercase{% else %}none{% endif %};
    --psh-body-ff: {{ body_ff }};
    --psh-body-fs: {{ body_fs }};
    --psh-body-fw: {{ section.settings.body_font_weight }};
    --psh-body-size: {{ section.settings.body_size }}px;
    --psh-body-size-mobile: {{ section.settings.body_size_mobile }}px;
    --psh-body-lh: {{ section.settings.body_line_height | divided_by: 100.0 }};
    --psh-body-lh-mobile: {{ section.settings.body_line_height_mobile | divided_by: 100.0 }};
    --psh-body-ls: {{ section.settings.body_letter_spacing | divided_by: 1000.0 }}em;
  }
{%- endstyle -%}

<div class="prose-split-hero prose-split-hero-{{ section.id }}">
  <div class="prose-split-hero__copy">
    {%- if section.settings.heading != blank -%}
      <{{ section.settings.heading_tag }} class="prose-split-hero__heading">
        {{- section.settings.heading -}}
      </{{ section.settings.heading_tag }}>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="prose-split-hero__prose">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'paragraph' -%}
              {%- if block.settings.text != blank -%}
                <p class="prose-split-hero__paragraph" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <figure class="prose-split-hero__figure">
    {%- if image != blank -%}
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ image_mobile | image_url: width: 375 }} 375w, {{ image_mobile | image_url: width: 550 }} 550w, {{ image_mobile | image_url: width: 750 }} 750w, {{ image_mobile | image_url: width: 1100 }} 1100w, {{ image_mobile | image_url: width: 1500 }} 1500w"
            sizes="{{ mobile_vw }}vw"
            width="{{ image_mobile.width }}"
            height="{{ image_mobile.height }}"
          >
        {%- endif -%}
        {{
          image
          | image_url: width: 2000
          | image_tag:
            class: 'prose-split-hero__image',
            widths: '375, 550, 750, 1100, 1500, 2000',
            sizes: media_sizes,
            loading: media_loading,
            fetchpriority: media_priority,
            alt: image.alt
        }}
      </picture>
    {%- else -%}
      {{ 'image' | placeholder_svg_tag: 'prose-split-hero__image placeholder-svg' }}
    {%- endif -%}
  </figure>
</div>

{% schema %}
