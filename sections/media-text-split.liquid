      "default": 20
    },
    {
      "type": "select",
      "id": "body_font_source",
      "label": "Fuente de textos",
      "options": [
        {
          "value": "theme_heading",
          "label": "Títulos del theme"
        },
        {
          "value": "theme_body",
          "label": "Textos del theme"
        },
        {
          "value": "custom",
          "label": "Personalizada"
        }
      ],
      "default": "theme_body"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Fuente personalizada de textos",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Tamaño de textos (desktop)",
      "default": 18
    },
    {
      "type": "range",
      "id": "body_size_mobile",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Tamaño de textos (mobile)",
      "default": 16
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 600,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "label": "Ancho máximo del contenido",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_x",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Margen lateral (desktop)",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_x_mobile",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Margen lateral (mobile)",
      "default": 16
    },
    {
      "type": "range",
