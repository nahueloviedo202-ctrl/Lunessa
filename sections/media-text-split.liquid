      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Espacio entre título y contenido",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Espaciado superior (desktop)",
      "default": 64
