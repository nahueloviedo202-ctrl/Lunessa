    },
    {
      "type": "range",
      "id": "padding_x_mobile",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Margen lateral (mobile)",
      "default": 16
    },
    {
      "type": "range",
      "id": "group_gap",
      "min": 8,
      "max": 80,
