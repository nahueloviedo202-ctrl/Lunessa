{{ 'section-results-checklist.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font

  case section.settings.heading_font_source
    when 'theme_heading'
      assign heading_ff = 'var(--font-heading-family)'
      assign heading_fs = 'var(--font-heading-style)'
    when 'theme_body'
      assign heading_ff = 'var(--font-body-family)'
      assign heading_fs = 'var(--font-body-style)'
    else
      assign heading_ff = heading_font.family | append: ', ' | append: heading_font.fallback_families
      assign heading_fs = heading_font.style
  endcase

  case section.settings.body_font_source
    when 'theme_heading'
      assign body_ff = 'var(--font-heading-family)'
      assign body_fs = 'var(--font-heading-style)'
    when 'theme_body'
      assign body_ff = 'var(--font-body-family)'
      assign body_fs = 'var(--font-body-style)'
    else
      assign body_ff = body_font.family | append: ', ' | append: body_font.fallback_families
      assign body_fs = body_font.style
  endcase

  # object-fit: cover enlarges the image when the box is narrower than the photo,
  # so the requested width must grow by the same factor to stay sharp.
  assign image_cover_desktop = 1.0
  assign image_cover_mobile = 1.0
  if section.settings.image != blank
    assign image_ar = section.settings.image.aspect_ratio | times: 1.0
    if section.settings.image_ratio != 'auto'
      assign ratio_parts = section.settings.image_ratio | split: '/'
      assign box_ar = ratio_parts[0] | strip | times: 1.0 | divided_by: ratio_parts[1]
      if image_ar > box_ar
        assign image_cover_desktop = image_ar | divided_by: box_ar
      endif
    endif
    if section.settings.image_ratio_mobile != 'auto'
      assign ratio_parts = section.settings.image_ratio_mobile | split: '/'
      assign box_ar = ratio_parts[0] | strip | times: 1.0 | divided_by: ratio_parts[1]
      if image_ar > box_ar
        assign image_cover_mobile = image_ar | divided_by: box_ar
      endif
    endif
  endif
  assign image_sizes_desktop = section.settings.image_max_width | times: image_cover_desktop | ceil
  assign image_gutter_mobile = section.settings.padding_x_mobile | times: 2
  assign image_cover_mobile = image_cover_mobile | round: 3
  capture image_sizes
    echo '(min-width: 1024px) ' | append: image_sizes_desktop | append: 'px, calc((100vw - ' | append: image_gutter_mobile | append: 'px) * ' | append: image_cover_mobile | append: ')'
  endcapture
-%}

{%- style -%}
  {% if section.settings.heading_font_source == 'custom' %}
    {%- assign heading_font_weighted = heading_font | font_modify: 'weight', section.settings.heading_font_weight | default: heading_font -%}
    {{ heading_font_weighted | font_face: font_display: 'swap' }}
    {%- assign heading_font_italic = heading_font_weighted | font_modify: 'style', 'italic' -%}
    {{ heading_font_italic | font_face: font_display: 'swap' }}
  {% endif %}
  {% if section.settings.body_font_source == 'custom' %}
    {{ body_font | font_face: font_display: 'swap' }}
    {%- assign body_font_bold = body_font | font_modify: 'weight', 'bold' -%}
    {{ body_font_bold | font_face: font_display: 'swap' }}
    {%- assign body_font_italic = body_font | font_modify: 'style', 'italic' -%}
    {{ body_font_italic | font_face: font_display: 'swap' }}
    {%- assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic' -%}
    {{ body_font_bold_italic | font_face: font_display: 'swap' }}
  {% endif %}

  .rcl--{{ section.id }} {
    --rcl-bg: {{ section.settings.background_color }};
    --rcl-max-width: {{ section.settings.max_width }}px;
    --rcl-pt: {{ section.settings.padding_top }}px;
    --rcl-pb: {{ section.settings.padding_bottom }}px;
    --rcl-px: {{ section.settings.padding_x }}px;
    --rcl-pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --rcl-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --rcl-px-mobile: {{ section.settings.padding_x_mobile }}px;
    --rcl-column-gap: {{ section.settings.column_gap }}px;
    --rcl-column-gap-mobile: {{ section.settings.column_gap_mobile }}px;
    --rcl-content-gap: {{ section.settings.content_gap }}px;

    --rcl-image-max-width: {{ section.settings.image_max_width }}px;
    --rcl-image-ratio: {{ section.settings.image_ratio }};
    --rcl-image-ratio-mobile: {{ section.settings.image_ratio_mobile }};
    --rcl-image-radius: {{ section.settings.image_radius }}px;

    --rcl-heading-ff: {{ heading_ff }};
    --rcl-heading-fs: {{ heading_fs }};
    --rcl-heading-fw: {{ section.settings.heading_font_weight }};
    --rcl-heading-color: {{ section.settings.heading_color }};
    --rcl-highlight-color: {{ section.settings.highlight_color }};
    --rcl-heading-size: {{ section.settings.heading_size }}px;
    --rcl-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --rcl-heading-lh: {{ section.settings.heading_line_height }}px;
    --rcl-heading-lh-mobile: {{ section.settings.heading_line_height_mobile }}px;
    --rcl-header-gap: {{ section.settings.header_gap }}px;
    --rcl-subheading-color: {{ section.settings.subheading_color }};
    --rcl-subheading-size: {{ section.settings.subheading_size }}px;
    --rcl-subheading-lh: {{ section.settings.subheading_line_height }}px;
    --rcl-body-ff: {{ body_ff }};
    --rcl-body-fs: {{ body_fs }};

    --rcl-list-max-width: {{ section.settings.list_max_width }}px;
    --rcl-list-columns: {{ section.settings.list_columns }};
    --rcl-item-gap: {{ section.settings.item_gap }}px;
    --rcl-item-bg: {{ section.settings.item_background }};
    --rcl-item-border: {{ section.settings.item_border_color }};
    --rcl-item-border-width: {{ section.settings.item_border_width }}px;
    --rcl-item-radius: {{ section.settings.item_radius }}px;
    --rcl-item-min-height: {{ section.settings.item_min_height }}px;
    --rcl-item-py: {{ section.settings.item_padding_y }}px;
    --rcl-item-px: {{ section.settings.item_padding_x }}px;
    --rcl-item-py-mobile: {{ section.settings.item_padding_y_mobile }}px;
    --rcl-item-px-mobile: {{ section.settings.item_padding_x_mobile }}px;
    --rcl-item-icon-gap: {{ section.settings.item_icon_gap }}px;
    --rcl-item-color: {{ section.settings.item_color }};
    --rcl-item-size: {{ section.settings.item_size }}px;
    --rcl-item-lh: {{ section.settings.item_line_height }}px;
    --rcl-item-size-mobile: {{ section.settings.item_size_mobile }}px;
    --rcl-item-lh-mobile: {{ section.settings.item_line_height_mobile }}px;
    --rcl-icon-fill: {{ section.settings.icon_fill }};
    --rcl-icon-color: {{ section.settings.icon_color }};
    --rcl-icon-size: {{ section.settings.icon_size }}px;

    --rcl-footer-gap: {{ section.settings.footer_gap }}px;
    --rcl-button-bg: {{ section.settings.button_background }};
    --rcl-button-color: {{ section.settings.button_color }};
    --rcl-button-border: {{ section.settings.button_border }};
    --rcl-button-bg-hover: {{ section.settings.button_background_hover }};
    --rcl-button-color-hover: {{ section.settings.button_color_hover }};
    --rcl-button-border-hover: {{ section.settings.button_border_hover }};
    --rcl-button-size: {{ section.settings.button_size }}px;
    --rcl-button-height: {{ section.settings.button_height }}px;
    --rcl-button-max-width: {{ section.settings.button_max_width }}px;
    --rcl-button-radius: {{ section.settings.button_radius }}px;
    --rcl-disclaimer-color: {{ section.settings.disclaimer_color }};
    --rcl-disclaimer-size: {{ section.settings.disclaimer_size }}px;
    --rcl-disclaimer-style: {% if section.settings.disclaimer_italic %}italic{% else %}normal{% endif %};
  }
{%- endstyle -%}

<section
  class="rcl rcl--{{ section.id }}{% if section.settings.image_position == 'right' %} rcl--media-right{% endif %}{% unless section.settings.image_first_mobile %} rcl--media-last-mobile{% endunless %}"
>
  <div class="rcl__inner">
    <div class="rcl__media{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 2400
          | image_tag:
            loading: 'lazy',
            widths: '360, 540, 720, 960, 1200, 1500, 1800, 2400',
            sizes: image_sizes,
            class: 'rcl__image'
        }}
      {%- else -%}
        {{ 'product-apparel-1' | placeholder_svg_tag: 'rcl__image placeholder-svg' }}
      {%- endif -%}
    </div>

    <div class="rcl__content{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
        <div class="rcl__header">
          {%- if section.settings.heading != blank -%}
            <h2 class="rcl__heading">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="rcl__subheading">{{ section.settings.subheading }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="rcl__list" role="list">
          {%- for block in section.blocks -%}
            <li class="rcl-item" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                {{
                  block.settings.icon
                  | image_url: width: 96
                  | image_tag: loading: 'lazy', alt: '', class: 'rcl-item__icon'
                }}
              {%- else -%}
                {%- render 'circle-check-icon', class: 'rcl-item__icon' -%}
              {%- endif -%}
              <span class="rcl-item__label">{{ block.settings.text }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.button_label != blank or section.settings.disclaimer != blank -%}
        <div class="rcl__footer">
          {%- if section.settings.button_label != blank -%}
            <a
              class="rcl__button"
              {% if section.settings.button_link != blank %}
                href="{{ section.settings.button_link }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
            >
              {{- section.settings.button_label | escape -}}
            </a>
          {%- endif -%}
          {%- if section.settings.disclaimer != blank -%}
            <p class="rcl__disclaimer">{{ section.settings.disclaimer }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
