{%- liquid
  assign hero_product = section.settings.product | default: product
  render 'product-offer-hero', product: hero_product
-%}

{% schema %}
{
  "name": "Producto con ofertas",
  "tag": "div",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Producto",
      "info": "Si se deja vacío, en la plantilla de producto se usa el producto actual."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "range",
      "id": "gallery_width",
      "min": 30,
      "max": 70,
      "step": 5,
      "unit": "%",
      "label": "Ancho de la galería (escritorio)",
      "default": 50
    },
    {
      "type": "range",
      "id": "columns_gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Separación entre columnas",
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_row_gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Separación galería / información (móvil)",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_gutter",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Margen lateral (móvil)",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Relleno superior",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Relleno inferior",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Relleno superior (móvil)",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Relleno inferior (móvil)",
      "default": 32
    },
    {
      "type": "header",
      "content": "Tipografía"
    },
    {
      "type": "checkbox",
      "id": "heading_font_custom",
      "label": "Usar fuente personalizada en títulos",
      "info": "Si está desactivado se usa la fuente de títulos del tema.",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Fuente de títulos",
      "default": "assistant_n4"
    },
    {
      "type": "checkbox",
      "id": "body_font_custom",
      "label": "Usar fuente personalizada en textos",
      "info": "Si está desactivado se usa la fuente de cuerpo del tema.",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Fuente de textos",
      "default": "assistant_n4"
    },
    {
      "type": "header",
      "content": "Galería"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Proporción de imagen",
      "options": [
        { "value": "1 / 1", "label": "Cuadrada (1:1)" },
        { "value": "4 / 5", "label": "Vertical (4:5)" },
        { "value": "3 / 4", "label": "Vertical (3:4)" },
        { "value": "4 / 3", "label": "Horizontal (4:3)" }
      ],
      "default": "1 / 1"
    },
    {
      "type": "select",
      "id": "media_fit",
      "label": "Ajuste de imagen",
      "options": [
        { "value": "cover", "label": "Recortar" },
        { "value": "contain", "label": "Contener" }
      ],
      "default": "cover"
    },
    {
      "type": "range",
      "id": "media_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Radio de imagen principal",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_thumbnails",
      "label": "Mostrar miniaturas",
      "default": true
