{{ 'section-mark-strip.css' | asset_url | stylesheet_tag }}
<script src="{{ 'drag-scroll.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign font = section.settings.font

  case section.settings.font_source
    when 'theme_heading'
      assign font_ff = 'var(--font-heading-family)'
      assign font_fs = 'var(--font-heading-style)'
    when 'theme_body'
      assign font_ff = 'var(--font-body-family)'
      assign font_fs = 'var(--font-body-style)'
    else
      assign font_ff = font.family | append: ', ' | append: font.fallback_families
      assign font_fs = font.style
  endcase

  assign heading_font = section.settings.heading_font
  case section.settings.heading_font_source
    when 'theme_heading'
      assign heading_ff = 'var(--font-heading-family)'
      assign heading_fs = 'var(--font-heading-style)'
    when 'theme_body'
      assign heading_ff = 'var(--font-body-family)'
      assign heading_fs = 'var(--font-body-style)'
    else
      assign heading_ff = heading_font.family | append: ', ' | append: heading_font.fallback_families
      assign heading_fs = heading_font.style
  endcase

  assign strip_label = section.settings.aria_label
  if strip_label == blank
    assign strip_label = section.settings.heading | strip_html
  endif

  assign is_marquee = false
  if section.settings.layout == 'marquee'
    assign is_marquee = true
  endif
-%}

{%- style -%}
  {%- if section.settings.font_source == 'custom' -%}
    {{ font | font_face: font_display: 'swap' }}
    {%- assign font_weighted = font | font_modify: 'weight', section.settings.title_weight -%}
    {%- if font_weighted -%}
      {{ font_weighted | font_face: font_display: 'swap' }}
    {%- endif -%}
  {%- endif -%}
  {%- if section.settings.heading_font_source == 'custom' -%}
    {{ heading_font | font_face: font_display: 'swap' }}
    {%- assign heading_font_weighted = heading_font | font_modify: 'weight', section.settings.heading_font_weight -%}
    {%- if heading_font_weighted -%}
      {{ heading_font_weighted | font_face: font_display: 'swap' }}
    {%- endif -%}
  {%- endif -%}

  .mark-strip-{{ section.id }} {
    --ms-bg: {{ section.settings.background }};
    --ms-color: {{ section.settings.text_color }};
    --ms-focus: {{ section.settings.focus_color }};
    --ms-py: {{ section.settings.padding_vertical }}px;
    --ms-py-mobile: {{ section.settings.padding_vertical_mobile }}px;
    --ms-px: {{ section.settings.padding_x }}px;
    --ms-gap: {{ section.settings.item_gap }}px;
    --ms-gap-mobile: {{ section.settings.item_gap_mobile }}px;
    --ms-icon-gap: {{ section.settings.icon_gap }}px;
    --ms-icon-size: {{ section.settings.icon_size }}px;
    --ms-icon-size-mobile: {{ section.settings.icon_size_mobile }}px;
    --ms-ff: {{ font_ff }};
    --ms-fs: {{ font_fs }};
    --ms-title-size: {{ section.settings.title_size }}px;
    --ms-title-size-mobile: {{ section.settings.title_size_mobile }}px;
    --ms-title-weight: {{ section.settings.title_weight }};
    --ms-caption-size: {{ section.settings.caption_size }}px;
    --ms-ls: {{ section.settings.letter_spacing | divided_by: 1000.0 }}em;
    --ms-duration: {{ section.settings.duration }}s;
    --ms-duration-mobile: {{ section.settings.duration_mobile }}s;
    --ms-min-height: {{ section.settings.min_height }}px;
    --ms-heading-ff: {{ heading_ff }};
    --ms-heading-fs: {{ heading_fs }};
    --ms-heading-fw: {{ section.settings.heading_font_weight }};
    --ms-heading-size: {{ section.settings.heading_size }}px;
    --ms-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --ms-heading-tt: {% if section.settings.heading_uppercase %}uppercase{% else %}none{% endif %};
    --ms-heading-gap: {{ section.settings.heading_gap }}px;
  }
{%- endstyle -%}

{%- if section.blocks.size > 0 -%}
  <div class="mark-strip-section mark-strip-{{ section.id }}">
    {%- if section.settings.heading != blank -%}
      <h2 class="mark-strip__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <drag-scroll
      class="mark-strip mark-strip--{{ section.settings.layout }} mark-strip--pack-{{ section.settings.item_alignment }}{% if is_marquee %} mark-strip--{{ section.settings.direction }}{% if section.settings.pause_on_hover %} mark-strip--pause{% endif %}{% endif %}"
      role="group"
      {% if strip_label != blank %}
        aria-label="{{ strip_label | escape }}"
      {% endif %}
      {% if is_marquee %}
        tabindex="0"
      {% endif %}
    >
      <div class="mark-strip__belt">
        {%- liquid
          if is_marquee
            assign run_count = 2
          else
            assign run_count = 1
          endif
        -%}
        {%- for run in (1..run_count) -%}
          {%- assign is_clone = forloop.last -%}
          {%- if run_count == 1 -%}
            {%- assign is_clone = false -%}
          {%- endif -%}
          <ul
            class="mark-strip__run list-unstyled{% if is_clone %} mark-strip__clone{% endif %}"
            role="list"
            {% if is_clone %}
              aria-hidden="true"
            {% endif %}
          >
            {%- for i in (1..section.settings.repeat_count) -%}
              {%- assign is_repeat = false -%}
              {%- if is_clone or i > 1 -%}
                {%- assign is_repeat = true -%}
              {%- endif -%}
              {%- if is_marquee or i == 1 -%}
                {%- for block in section.blocks -%}
                  {%- render 'mark-strip-item', block: block, is_clone: is_repeat -%}
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endfor -%}
      </div>
    </drag-scroll>
  </div>
{%- endif -%}

