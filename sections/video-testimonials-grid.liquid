{{ 'section-video-testimonials-grid.css' | asset_url | stylesheet_tag }}
<script src="{{ 'video-testimonials-grid.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font

  case section.settings.heading_font_source
    when 'theme_heading'
      assign heading_ff = 'var(--font-heading-family)'
      assign heading_fs = 'var(--font-heading-style)'
    when 'theme_body'
      assign heading_ff = 'var(--font-body-family)'
      assign heading_fs = 'var(--font-body-style)'
    else
      assign heading_ff = heading_font.family | append: ', ' | append: heading_font.fallback_families
      assign heading_fs = heading_font.style
  endcase

  case section.settings.body_font_source
    when 'theme_heading'
      assign body_ff = 'var(--font-heading-family)'
      assign body_fs = 'var(--font-heading-style)'
    when 'theme_body'
      assign body_ff = 'var(--font-body-family)'
      assign body_fs = 'var(--font-body-style)'
    else
      assign body_ff = body_font.family | append: ', ' | append: body_font.fallback_families
      assign body_fs = body_font.style
  endcase
-%}

{%- style -%}
  {% if section.settings.heading_font_source == 'custom' %}
    {%- assign heading_font_weighted = heading_font | font_modify: 'weight', section.settings.heading_font_weight | default: heading_font -%}
    {{ heading_font_weighted | font_face: font_display: 'swap' }}
  {% endif %}
  {% if section.settings.body_font_source == 'custom' %}
    {{ body_font | font_face: font_display: 'swap' }}
    {%- assign body_font_bold = body_font | font_modify: 'weight', 'bold' -%}
    {{ body_font_bold | font_face: font_display: 'swap' }}
    {%- assign body_font_italic = body_font | font_modify: 'style', 'italic' -%}
    {{ body_font_italic | font_face: font_display: 'swap' }}
  {% endif %}

  .vtg--{{ section.id }} {
    --vtg-bg: {{ section.settings.background_color }};
    --vtg-max-width: {{ section.settings.max_width }}px;
    --vtg-pt: {{ section.settings.padding_top }}px;
    --vtg-pb: {{ section.settings.padding_bottom }}px;
    --vtg-px: {{ section.settings.padding_x }}px;
    --vtg-pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --vtg-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --vtg-px-mobile: {{ section.settings.padding_x_mobile }}px;
    --vtg-stack-gap: {{ section.settings.stack_gap }}px;
    --vtg-stack-gap-mobile: {{ section.settings.stack_gap_mobile }}px;

    --vtg-heading-ff: {{ heading_ff }};
    --vtg-heading-fs: {{ heading_fs }};
    --vtg-heading-fw: {{ section.settings.heading_font_weight }};
    --vtg-heading-color: {{ section.settings.heading_color }};
    --vtg-heading-size: {{ section.settings.heading_size }}px;
    --vtg-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --vtg-heading-lh: {{ section.settings.heading_line_height }}px;
    --vtg-heading-lh-mobile: {{ section.settings.heading_line_height_mobile }}px;
    --vtg-heading-max-width: {{ section.settings.heading_max_width }}px;
    --vtg-body-ff: {{ body_ff }};
    --vtg-body-fs: {{ body_fs }};

    --vtg-columns: {{ section.settings.columns_desktop }};
    --vtg-columns-tablet: {{ section.settings.columns_tablet }};
    --vtg-columns-mobile: {{ section.settings.columns_mobile }};
    --vtg-grid-gap: {{ section.settings.grid_gap }}px;
    --vtg-grid-gap-mobile: {{ section.settings.grid_gap_mobile }}px;

    --vtg-card-bg: {{ section.settings.card_background }};
    --vtg-card-radius: {{ section.settings.card_radius }}px;
    --vtg-card-padding: {{ section.settings.card_padding }}px;
    --vtg-card-gap: {{ section.settings.card_gap }}px;
    --vtg-card-body-gap: {{ section.settings.card_body_gap }}px;
    --vtg-media-ratio: {{ section.settings.media_ratio }};
    --vtg-media-radius: {{ section.settings.media_radius }}px;
    --vtg-name-color: {{ section.settings.name_color }};
    --vtg-name-size: {{ section.settings.name_size }}px;
    --vtg-name-lh: {{ section.settings.name_line_height }}px;
    --vtg-badge-fill: {{ section.settings.badge_fill }};
    --vtg-badge-stroke: {{ section.settings.badge_stroke }};
    --vtg-badge-size: {{ section.settings.badge_size }}px;
    --vtg-quote-color: {{ section.settings.quote_color }};
    --vtg-quote-size: {{ section.settings.quote_size }}px;
    --vtg-quote-lh: {{ section.settings.quote_line_height }}px;

    --vtg-footer-gap: {{ section.settings.footer_gap }}px;
    --vtg-button-bg: {{ section.settings.button_background }};
    --vtg-button-color: {{ section.settings.button_color }};
    --vtg-button-border: {{ section.settings.button_border }};
    --vtg-button-bg-hover: {{ section.settings.button_background_hover }};
    --vtg-button-color-hover: {{ section.settings.button_color_hover }};
    --vtg-button-border-hover: {{ section.settings.button_border_hover }};
    --vtg-button-size: {{ section.settings.button_size }}px;
    --vtg-button-height: {{ section.settings.button_height }}px;
    --vtg-button-max-width: {{ section.settings.button_max_width }}px;
    --vtg-button-radius: {{ section.settings.button_radius }}px;
    --vtg-disclaimer-color: {{ section.settings.disclaimer_color }};
    --vtg-disclaimer-size: {{ section.settings.disclaimer_size }}px;
  }
{%- endstyle -%}

<section class="vtg vtg--{{ section.id }}">
  <div class="vtg__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="vtg__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <video-testimonials-grid class="vtg__grid" data-autoplay="{{ section.settings.video_autoplay }}">
        {%- for block in section.blocks -%}
          <div
            class="vtg__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            <article class="vtg-card">
              {%- liquid
                assign video = block.settings.video
                assign media_alt = block.settings.media_alt | default: block.settings.name
              -%}
              {%- if video != blank -%}
                {%- liquid
                  assign mp4_sources = video.sources | where: 'format', 'mp4' | sort: 'width'
                  assign mp4_source = mp4_sources.last
                  for source in mp4_sources
                    if source.width >= 720
                      assign mp4_source = source
                      break
                    endif
                  endfor
                  assign hls_source = video.sources | where: 'format', 'm3u8' | first

                  if block.settings.image != blank
                    assign poster = block.settings.image | image_url: width: 720
                  elsif video.preview_image != blank
                    assign poster = video.preview_image | image_url: width: 720
                  else
                    assign poster = nil
                  endif
                -%}
                <video
                  class="vtg-card__media"
                  {% if poster != blank %}
                    poster="{{ poster }}"
                  {% endif %}
                  aria-label="{{ media_alt | escape }}"
                  muted
                  loop
                  playsinline
                  preload="none"
                >
                  {%- if mp4_source -%}
                    <source src="{{ mp4_source.url }}" type="{{ mp4_source.mime_type }}">
                  {%- endif -%}
                  {%- if hls_source -%}
                    <source src="{{ hls_source.url }}" type="{{ hls_source.mime_type }}">
                  {%- endif -%}
                </video>
              {%- elsif block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    widths: '300, 450, 600, 720, 900',
                    sizes: '(min-width: 1024px) 340px, (min-width: 750px) 90vw, calc(100vw - 32px)',
                    alt: media_alt,
                    class: 'vtg-card__media'
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'vtg-card__media placeholder-svg' }}
              {%- endif -%}

              <div class="vtg-card__body">
                {%- if block.settings.name != blank or block.settings.verified -%}
                  <p class="vtg-card__name">
                    <span>{{ block.settings.name | escape }}</span>
                    {%- if block.settings.verified -%}
                      <span class="vtg-card__badge" role="img" aria-label="{{ section.settings.verified_label | escape }}">
                        {%- render 'verified-badge-icon' -%}
                      </span>
                    {%- endif -%}
                  </p>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="vtg-card__quote">{{ block.settings.text }}</p>
                {%- endif -%}
              </div>
            </article>
          </div>
        {%- endfor -%}
      </video-testimonials-grid>
    {%- endif -%}

    {%- if section.settings.button_label != blank or section.settings.disclaimer != blank -%}
      <div class="vtg__footer">
        {%- if section.settings.button_label != blank -%}
          <a
            class="vtg__button"
            {% if section.settings.button_link != blank %}
              href="{{ section.settings.button_link }}"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
          >
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.disclaimer != blank -%}
          <p class="vtg__disclaimer">{{ section.settings.disclaimer }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

