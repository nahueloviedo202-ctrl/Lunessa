      "default": "#FDF8ED"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Color de texto",
      "default": "#731122"
    },
    {
      "type": "range",
      "id": "button_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Radio",
      "default": 15
    },
    {
      "type": "range",
      "id": "button_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Tamaño de texto",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_size_mobile",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Tamaño de texto (móvil)",
      "default": 15
    },
    {
      "type": "header",
      "content": "Pestañas"
    },
    {
      "type": "range",
      "id": "tabs_margin_top",
      "min": 0,
      "max": 60,
