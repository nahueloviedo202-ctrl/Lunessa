        { "value": "500", "label": "Medio" },
        { "value": "600", "label": "Semi negrita" },
        { "value": "700", "label": "Negrita" }
      ],
      "default": "500"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color del título",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Color de fondo",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Botón"
    },
