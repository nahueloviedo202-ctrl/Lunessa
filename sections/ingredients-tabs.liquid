{{ 'section-ingredients-tabs.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ingredients-tabs.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign radio_prefix = 'Ingredients-' | append: section.id | append: '-'

  assign tab_count = 0
  assign active_tab = 0
  for b in section.blocks
    if b.type == 'tab'
      assign tab_count = tab_count | plus: 1
      if b.settings.selected and active_tab == 0
        assign active_tab = tab_count
      endif
    endif
  endfor
  if active_tab == 0
    assign active_tab = 1
  endif
-%}

{%- style -%}
  {%- if section.settings.heading_font_custom -%}
    {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if section.settings.body_font_custom -%}
    {{ section.settings.body_font | font_face: font_display: 'swap' }}
  {%- endif -%}

  .ing--{{ section.id }} {
    {%- if section.settings.heading_font_custom %}
      --ing-heading-font: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
      --ing-heading-style: {{ section.settings.heading_font.style }};
    {%- endif %}
    {%- if section.settings.body_font_custom %}
      --ing-body-font: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
      --ing-body-style: {{ section.settings.body_font.style }};
    {%- endif %}
    --ing-bg: {{ section.settings.background }};
    --ing-pt: {{ section.settings.padding_top }}px;
    --ing-pb: {{ section.settings.padding_bottom }}px;
    --ing-pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --ing-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --ing-px-mobile: {{ section.settings.padding_horizontal_mobile }}px;

    --ing-title-size: {{ section.settings.heading_size }}px;
    --ing-title-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --ing-title-weight: {{ section.settings.heading_weight }};
    --ing-title-color: {{ section.settings.heading_color }};

    --ing-button-bg: {{ section.settings.button_background }};
    --ing-button-color: {{ section.settings.button_color }};
    --ing-button-radius: {{ section.settings.button_radius }}px;
    --ing-button-size: {{ section.settings.button_size }}px;
    --ing-button-size-mobile: {{ section.settings.button_size_mobile }}px;

    --ing-tabs-mt: {{ section.settings.tabs_margin_top }}px;
    --ing-tabs-mt-mobile: {{ section.settings.tabs_margin_top_mobile }}px;
    --ing-tab-gap: {{ section.settings.tab_gap }}px;
    --ing-tab-px: {{ section.settings.tab_padding_horizontal }}px;
    --ing-tab-py: {{ section.settings.tab_padding_vertical }}px;
    --ing-tab-radius: {{ section.settings.tab_radius }}px;
    --ing-tab-size: {{ section.settings.tab_size }}px;
    --ing-tab-size-mobile: {{ section.settings.tab_size_mobile }}px;
    --ing-tab-color: {{ section.settings.tab_color }};
    --ing-tab-border: {{ section.settings.tab_border_color }};
    --ing-tab-bg: {{ section.settings.tab_background }};
    --ing-tab-active-color: {{ section.settings.tab_active_color }};
    --ing-tab-active-bg: {{ section.settings.tab_active_background }};
    --ing-panel-mt: {{ section.settings.panel_margin_top }}px;
    --ing-scrollbar-thumb: {{ section.settings.scrollbar_thumb }};
    --ing-scrollbar-track: {{ section.settings.scrollbar_track }};

    --ing-image-height: {{ section.settings.image_height }}px;
    --ing-image-height-mobile: {{ section.settings.image_height_mobile }}px;
    --ing-image-radius: {{ section.settings.image_radius }}px;
    --ing-name-size: {{ section.settings.name_size }}px;
    --ing-name-size-mobile: {{ section.settings.name_size_mobile }}px;
    --ing-name-color: {{ section.settings.name_color }};
    --ing-divider-color: {{ section.settings.divider_color }};
    --ing-divider-width: {{ section.settings.divider_width }}px;
    --ing-divider-width-mobile: {{ section.settings.divider_width_mobile }}px;
    --ing-desc-size: {{ section.settings.description_size }}px;
    --ing-desc-size-mobile: {{ section.settings.description_size_mobile }}px;
    --ing-desc-color: {{ section.settings.description_color }};
    --ing-tag-color: {{ section.settings.tag_color }};
    --ing-tag-border: {{ section.settings.tag_border_color }};
    --ing-tag-bg: {{ section.settings.tag_background }};
    --ing-tag-radius: {{ section.settings.tag_radius }}px;
    --ing-tag-size: {{ section.settings.tag_size }}px;
    --ing-tag-size-mobile: {{ section.settings.tag_size_mobile }}px;
  }

  {%- assign tab_index = 0 -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'tab' -%}
      {%- assign tab_index = tab_index | plus: 1 -%}
      {%- assign radio_id = radio_prefix | append: tab_index %}
      .ing--{{ section.id }} .ing__tabs:has([id="{{ radio_id }}"]:checked) [for="{{ radio_id }}"] {
        border-color: var(--ing-tab-active-bg);
        background: var(--ing-tab-active-bg);
        color: var(--ing-tab-active-color);
      }
      .ing--{{ section.id }} .ing__tabs:has([id="{{ radio_id }}"]:focus-visible) [for="{{ radio_id }}"] {
        outline: 2px solid var(--ing-tab-active-bg);
        outline-offset: 2px;
      }
    {%- endif -%}
  {%- endfor %}
{%- endstyle -%}

<section class="ing ing--{{ section.id }}">
  <div class="ing__container page-width">
    <div class="ing__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="ing__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <div class="ing__button-wrapper ing__button-wrapper--desktop">
          {%- render 'ingredients-tabs-button', label: section.settings.button_label, link: section.settings.button_link, icon: section.settings.button_icon -%}
        </div>
      {%- endif -%}
    </div>

    {%- if tab_count > 0 -%}
      <div class="ing__tabs">
        <div class="ing__tablist" role="radiogroup" aria-label="{{ section.settings.heading | strip_html | escape }}">
          {%- assign tab_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'tab' -%}
              {%- assign tab_index = tab_index | plus: 1 -%}
              {%- assign radio_id = radio_prefix | append: tab_index -%}
              <label for="{{ radio_id }}" class="ing__tab" data-tab-radio="{{ radio_id }}" {{ block.shopify_attributes }}>
                {{- block.settings.label | escape -}}
              </label>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- assign tab_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type != 'tab' -%}
            {%- continue -%}
          {%- endif -%}
          {%- liquid
            assign tab_index = tab_index | plus: 1
            assign radio_id = radio_prefix | append: tab_index
            assign items_offset = forloop.index
          -%}
          <input
            type="radio"
            class="ing__radio visually-hidden"
            name="ingredients-{{ section.id }}"
            id="{{ radio_id }}"
            {% if tab_index == active_tab %}
              checked
            {% endif %}
          >
          <ingredients-drag-scroll
            class="ing__panel"
            style="--ing-columns: {{ block.settings.columns }}; --ing-columns-mobile: {{ block.settings.columns_mobile }}; --ing-column-gap: {{ block.settings.column_gap }}px; --ing-row-gap: {{ block.settings.row_gap }}px; --ing-min-width: {{ block.settings.min_width }}%; --ing-min-width-tablet: {{ block.settings.min_width_tablet }}%; --ing-min-width-mobile: {{ block.settings.min_width_mobile }}%;"
          >
            <ul class="ing__grid list-unstyled" role="list">
              {%- for item in section.blocks offset: items_offset -%}
                {%- if item.type != 'ingredient' -%}
                  {%- break -%}
                {%- endif -%}
                <li class="ing-card" data-tab-radio="{{ radio_id }}" {{ item.shopify_attributes }}>
                  <div class="ing-card__media">
                    {%- if item.settings.image != blank -%}
                      {{
                        item.settings.image
                        | image_url: width: 600
                        | image_tag:
                          loading: 'lazy',
                          widths: '200, 300, 450, 600',
                          sizes: '(min-width: 990px) 300px, 50vw',
                          class: 'ing-card__image'
                      }}
                    {%- else -%}
                      {{ 'image' | placeholder_svg_tag: 'ing-card__image ing-card__image--placeholder placeholder-svg' }}
                    {%- endif -%}
                  </div>
                  {%- if item.settings.name != blank -%}
                    <h3 class="ing-card__name">{{ item.settings.name | escape }}</h3>
                  {%- endif -%}
                  <span class="ing-card__divider" aria-hidden="true"></span>
                  {%- if item.settings.description != blank -%}
                    <p class="ing-card__description">{{ item.settings.description | escape }}</p>
                  {%- endif -%}
                  {%- if item.settings.tag != blank -%}
                    <span class="ing-card__tag">{{ item.settings.tag | escape }}</span>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </ingredients-drag-scroll>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="ing__button-wrapper ing__button-wrapper--mobile">
        {%- render 'ingredients-tabs-button', label: section.settings.button_label, link: section.settings.button_link, icon: section.settings.button_icon -%}
      </div>
    {%- endif -%}
  </div>
</section>

{%- if request.design_mode -%}
  <script>
    document.addEventListener('shopify:block:select', (event) => {
      const radioId = event.target.dataset.tabRadio;
      const radio = radioId && document.getElementById(radioId);
      if (radio) radio.checked = true;
    });
  </script>
{%- endif -%}

{% schema %}
