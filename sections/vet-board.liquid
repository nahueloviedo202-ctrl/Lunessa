{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-rail-controls.css' | asset_url | stylesheet_tag }}
{{ 'section-vet-board.css' | asset_url | stylesheet_tag }}
<script src="{{ 'coverflow-slider.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font

  case section.settings.heading_font_source
    when 'theme_heading'
      assign heading_ff = 'var(--font-heading-family)'
      assign heading_fs = 'var(--font-heading-style)'
    when 'theme_body'
      assign heading_ff = 'var(--font-body-family)'
      assign heading_fs = 'var(--font-body-style)'
    else
      assign heading_ff = heading_font.family | append: ', ' | append: heading_font.fallback_families
      assign heading_fs = heading_font.style
  endcase

  case section.settings.body_font_source
    when 'theme_heading'
      assign body_ff = 'var(--font-heading-family)'
      assign body_fs = 'var(--font-heading-style)'
    when 'theme_body'
      assign body_ff = 'var(--font-body-family)'
      assign body_fs = 'var(--font-body-style)'
    else
      assign body_ff = body_font.family | append: ', ' | append: body_font.fallback_families
      assign body_fs = body_font.style
  endcase

  assign slider_id = 'Slider-' | append: section.id
  assign show_arrows = false
  if section.blocks.size > 1
    assign show_arrows = true
  endif

  assign carousel_label = section.settings.heading | strip_html
  if carousel_label == blank
    assign carousel_label = 'general.slider.name' | t
  endif

  assign neighbour_shift = section.settings.slide_width | minus: section.settings.neighbour_offset
  assign image_sizes = '(min-width: 750px) ' | append: section.settings.slide_width | append: 'px, calc(100vw - 32px)'
-%}

{%- style -%}
  {%- if section.settings.heading_font_source == 'custom' -%}
    {{ heading_font | font_face: font_display: 'swap' }}
    {%- assign heading_font_weighted = heading_font | font_modify: 'weight', section.settings.heading_font_weight -%}
    {%- if heading_font_weighted -%}
      {{ heading_font_weighted | font_face: font_display: 'swap' }}
    {%- endif -%}
  {%- endif -%}
  {%- if section.settings.body_font_source == 'custom' -%}
    {{ body_font | font_face: font_display: 'swap' }}
    {%- assign body_font_bold = body_font | font_modify: 'weight', '800' -%}
    {%- if body_font_bold -%}
      {{ body_font_bold | font_face: font_display: 'swap' }}
    {%- endif -%}
  {%- endif -%}

  .vet-board-{{ section.id }} {
    --vb-bg: {{ section.settings.background }};
    --vb-heading-color: {{ section.settings.heading_color }};
    --vb-highlight-color: {{ section.settings.highlight_color }};
    --vb-subheading-color: {{ section.settings.subheading_color }};
    --vb-card-bg: {{ section.settings.card_background }};
    --vb-card-color: {{ section.settings.card_text_color }};
    --vb-card-radius: {{ section.settings.card_radius }}px;
    --vb-card-shadow: {% if section.settings.card_shadow %}0 4px 4px 0 rgba(0, 0, 0, 0.25){% else %}none{% endif %};
    --vb-pt: {{ section.settings.padding_top }}px;
    --vb-pb: {{ section.settings.padding_bottom }}px;
    --vb-pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --vb-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --vb-max-width: {{ section.settings.max_width }}px;
    --vb-px: {{ section.settings.padding_x }}px;
    --vb-px-mobile: {{ section.settings.padding_x_mobile }}px;
    --vb-stack-gap: {{ section.settings.stack_gap }}px;
    --vb-heading-ff: {{ heading_ff }};
    --vb-heading-fs: {{ heading_fs }};
    --vb-heading-fw: {{ section.settings.heading_font_weight }};
    --vb-heading-size: {{ section.settings.heading_size }}px;
    --vb-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --vb-heading-tt: {% if section.settings.heading_uppercase %}uppercase{% else %}none{% endif %};
    --vb-heading-max: {{ section.settings.heading_max_width }}px;
    --vb-subheading-max: {{ section.settings.subheading_max_width }}px;
    --vb-body-ff: {{ body_ff }};
    --vb-body-fs: {{ body_fs }};
    --vb-subheading-size: {{ section.settings.subheading_size }}px;
    --vb-subheading-size-mobile: {{ section.settings.subheading_size_mobile }}px;
    --vb-name-size: {{ section.settings.name_size }}px;
    --vb-bio-size: {{ section.settings.bio_size }}px;
    --vb-slide-width: {{ section.settings.slide_width }}px;
    --vb-neighbour-shift: {{ neighbour_shift }}px;
    --vb-neighbour-offset: {{ section.settings.neighbour_offset }}px;
    --vb-neighbour-scale: {{ section.settings.neighbour_scale | divided_by: 100.0 }};
    --vb-neighbour-opacity: {{ section.settings.neighbour_opacity | divided_by: 100.0 }};
    --vb-image-ratio: {{ section.settings.image_ratio | divided_by: 100.0 }};
    --rail-arrow-bg: {{ section.settings.arrow_background }};
    --rail-arrow-color: {{ section.settings.arrow_color }};
    --rail-arrow-bg-hover: {{ section.settings.arrow_background_hover }};
    --rail-arrow-color-hover: {{ section.settings.arrow_color_hover }};
    --rail-focus: {{ section.settings.arrow_background }};
  }
{%- endstyle -%}

<div class="vet-board vet-board-{{ section.id }}">
  <div class="vet-board__container">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="vet-board__intro">
        {%- if section.settings.heading != blank -%}
          <h2 class="vet-board__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="vet-board__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <coverflow-slider class="vet-board__carousel">
        <ul
          id="{{ slider_id }}"
          class="slider slider--everywhere vet-board__track list-unstyled"
          role="list"
          aria-label="{{ carousel_label | escape }}"
          tabindex="0"
        >
          {%- for block in section.blocks -%}
            <li
              id="Slide-{{ section.id }}-{{ forloop.index }}"
              class="slider__slide slideshow__slide vet-board__slide"
              {% if forloop.first %}
                data-state="centre"
              {% elsif forloop.index == 2 %}
                data-state="next"
              {% else %}
                data-state="off"
              {% endif %}
              aria-label="{{ 'general.slider.of' | t | prepend: ' ' | prepend: forloop.index | append: ' ' | append: forloop.length }}"
            >
              <figure class="vet-board__card" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  {%- assign focal = block.settings.image.presentation.focal_point | default: '50% 26%' -%}
                  {%- assign image_style = 'object-position: ' | append: focal | append: ';' -%}
                  {{
                    block.settings.image
                    | image_url: width: 900
                    | image_tag:
                      class: 'vet-board__image',
                      widths: '320, 400, 600, 800, 900',
                      sizes: image_sizes,
                      loading: 'lazy',
                      alt: block.settings.image.alt,
                      style: image_style
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'vet-board__image placeholder-svg' }}
                {%- endif -%}
                <figcaption class="vet-board__name">
                  {{- block.settings.name | escape -}}
                  {%- if block.settings.credential != blank -%}
                    <span class="vet-board__credential">{{ block.settings.credential | escape }}</span>
                  {%- endif -%}
                </figcaption>
                {%- if block.settings.bio != blank -%}
                  <div class="vet-board__bio">{{ block.settings.bio }}</div>
                {%- endif -%}
              </figure>
            </li>
          {%- endfor -%}
        </ul>

        {%- render 'rail-controls',
          slider_id: slider_id,
          show_arrows: show_arrows,
          class: 'slider-buttons vet-board__arrows'
        -%}
      </coverflow-slider>
    {%- endif -%}
  </div>
</div>

{% schema %}
