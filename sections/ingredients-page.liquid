      "type": "badge",
      "name": "Insignia",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
            { "value": "none", "label": "Ninguno" },
            { "value": "no_sugar", "label": "Sin azúcar" },
            { "value": "no_gluten", "label": "Sin gluten" },
            { "value": "no_gmo", "label": "Sin OGM" },
            { "value": "gmp", "label": "Calidad / sello" }
          ],
          "default": "no_sugar"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Icono personalizado",
          "info": "Opcional. Reemplaza al icono elegido."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texto",
          "info": "Usa Enter para partir el texto en dos líneas.",
          "default": "Sin Azúcar"
        }
      ]
    },
    {
      "type": "ingredient",
      "name": "Ingrediente",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        },
        {
          "type": "text",
