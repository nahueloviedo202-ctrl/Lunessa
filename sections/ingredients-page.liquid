{{ 'section-ingredients-page.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign filter_prefix = 'IngredientFilter-' | append: section.id | append: '-'

  # Filter categories, in order of first appearance, from the ingredient blocks.
  assign category_list = '|'
  for b in section.blocks
    if b.type == 'ingredient'
      assign category = b.settings.category | strip
      if category != blank
        assign category_key = '|' | append: category | append: '|'
        unless category_list contains category_key
          assign category_list = category_list | append: category | append: '|'
        endunless
      endif
    endif
  endfor
  assign categories = category_list | remove_first: '|' | split: '|'
  assign show_filter = false
  if section.settings.show_filter and categories.size > 0
    assign show_filter = true
  endif

  assign badges = section.blocks | where: 'type', 'badge'
  assign ingredients = section.blocks | where: 'type', 'ingredient'
  assign benefits = section.blocks | where: 'type', 'benefit'
-%}

{%- style -%}
  {%- if section.settings.heading_font_custom -%}
    {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if section.settings.body_font_custom -%}
    {{ section.settings.body_font | font_face: font_display: 'swap' }}
  {%- endif -%}

  .ipg--{{ section.id }} {
    {%- if section.settings.heading_font_custom %}
      --ipg-heading-font: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
      --ipg-heading-style: {{ section.settings.heading_font.style }};
    {%- endif %}
    {%- if section.settings.body_font_custom %}
      --ipg-body-font: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
      --ipg-body-style: {{ section.settings.body_font.style }};
    {%- endif %}
    --ipg-bg: {{ section.settings.background }};
    --ipg-heading-color: {{ section.settings.heading_color }};
    --ipg-text-color: {{ section.settings.text_color }};
    --ipg-accent: {{ section.settings.accent_color }};
    --ipg-dark: {{ section.settings.dark_color }};
    --ipg-shadow: {{ section.settings.shadow_color }};
    --ipg-shadow-opacity: {{ section.settings.shadow_opacity }}%;
    --ipg-pt: {{ section.settings.padding_top }}px;
    --ipg-pt-mobile: {{ section.settings.padding_top_mobile }}px;

    --ipg-badge-from: {{ section.settings.badge_gradient_start }};
    --ipg-badge-to: {{ section.settings.badge_gradient_end }};
    --ipg-badge-color: {{ section.settings.badge_text_color }};
    --ipg-badge-size: {{ section.settings.badge_size }}px;
    --ipg-badge-size-mobile: {{ section.settings.badge_size_mobile }}px;

    --ipg-columns: {{ section.settings.columns }};
    --ipg-columns-tablet: {{ section.settings.columns_tablet }};
    --ipg-columns-mobile: {{ section.settings.columns_mobile }};
    --ipg-grid-max: {{ section.settings.grid_max_width }}px;
    --ipg-card-radius: {{ section.settings.card_radius }}px;
    --ipg-image-ratio: {{ section.settings.image_ratio }};
    --ipg-image-bg: {{ section.settings.image_background }};
    --ipg-desc-color: {{ section.settings.description_color }};

    --ipg-nutri-border: {{ section.settings.nutrition_border }};
    --ipg-nutri-section-bg: {{ section.settings.nutrition_section_background }};
    --ipg-nutri-muted: {{ section.settings.nutrition_muted_color }};

    --ipg-benefits-from: {{ section.settings.benefits_gradient_start }};
    --ipg-benefits-to: {{ section.settings.benefits_gradient_end }};
    --ipg-benefits-title: {{ section.settings.benefits_title_color }};
    --ipg-benefits-heading: {{ section.settings.benefits_heading_color }};
    --ipg-benefits-text: {{ section.settings.benefits_text_color }};
    --ipg-benefits-pb: {{ section.settings.benefits_padding }}px;
  }

  {%- if show_filter %}
    #{{ filter_prefix }}0:checked ~ .ipg__tabs [for="{{ filter_prefix }}0"]
    {%- for category in categories -%}
      , #{{ filter_prefix }}{{ forloop.index }}:checked ~ .ipg__tabs [for="{{ filter_prefix }}{{ forloop.index }}"]
    {%- endfor %} {
      border-color: var(--ipg-dark);
      background: var(--ipg-dark);
      color: #fff;
    }
    {%- for category in categories %}
      #{{ filter_prefix }}{{ forloop.index }}:checked ~ .ipg__grid .ipg-card:not([data-category="{{ category | handleize }}"]) {
        display: none;
      }
    {%- endfor %}
    {%- for i in (0..categories.size) %}
      #{{ filter_prefix }}{{ i }}:focus-visible ~ .ipg__tabs [for="{{ filter_prefix }}{{ i }}"] {
        outline: 2px solid var(--ipg-dark);
        outline-offset: 2px;
      }
    {%- endfor %}
  {%- endif %}
{%- endstyle -%}

<section class="ipg ipg--{{ section.id }}">
  {%- if badges.size > 0 -%}
    <ul class="ipg__badges list-unstyled" role="list">
      {%- for block in badges -%}
        <li class="ipg-badge" {{ block.shopify_attributes }}>
          {%- if block.settings.custom_icon != blank -%}
            {{
              block.settings.custom_icon
              | image_url: width: 80
              | image_tag: loading: 'lazy', class: 'ipg-badge__icon', alt: ''
            }}
          {%- elsif block.settings.icon != 'none' -%}
            {%- render 'ingredients-page-icon', icon: block.settings.icon, class: 'ipg-badge__icon' -%}
          {%- endif -%}
          <span class="ipg-badge__text">{{ block.settings.text | escape | newline_to_br }}</span>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  {%- if ingredients.size > 0 -%}
    <div class="ipg__catalog">
      {%- if show_filter -%}
        <input
          type="radio"
          class="ipg__filter-input visually-hidden"
          name="{{ filter_prefix }}filter"
          id="{{ filter_prefix }}0"
          checked
        >
        {%- for category in categories -%}
          <input
            type="radio"
            class="ipg__filter-input visually-hidden"
            name="{{ filter_prefix }}filter"
            id="{{ filter_prefix }}{{ forloop.index }}"
          >
        {%- endfor -%}
        <div class="ipg__tabs" role="group" aria-label="{{ section.settings.filter_label | escape }}">
          <label for="{{ filter_prefix }}0" class="ipg__tab">{{ section.settings.all_label | escape }}</label>
          {%- for category in categories -%}
            <label for="{{ filter_prefix }}{{ forloop.index }}" class="ipg__tab">{{ category | escape }}</label>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <ul class="ipg__grid list-unstyled" role="list">
        {%- for block in ingredients -%}
          <li
            class="ipg-card"
            data-category="{{ block.settings.category | strip | handleize }}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  widths: '300, 450, 600, 900',
                  sizes: '(min-width: 990px) 360px, (min-width: 750px) 50vw, 100vw',
                  class: 'ipg-card__image',
                  alt: block.settings.name
              }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'ipg-card__image placeholder-svg' }}
            {%- endif -%}
            <div class="ipg-card__body">
              <h3 class="ipg-card__name">{{ block.settings.name | escape }}</h3>
              {%- if block.settings.description != blank -%}
                <p class="ipg-card__description">{{ block.settings.description | escape }}</p>
              {%- endif -%}
              {%- if block.settings.tag != blank -%}
                <span class="ipg-card__tag">{{ block.settings.tag | escape }}</span>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}

  {%- if section.settings.show_nutrition -%}
    <div class="ipg-nutrition">
      {%- if section.settings.nutrition_title != blank -%}
        <h2 class="ipg-nutrition__title">{{ section.settings.nutrition_title | escape }}</h2>
      {%- endif -%}
      {%- assign meta_lines = section.settings.nutrition_meta | newline_to_br | split: '<br />' -%}
      {%- for line in meta_lines -%}
        {%- assign meta = line | strip -%}
        {%- if meta != blank -%}
          <p class="ipg-nutrition__meta">{{ meta | escape }}</p>
        {%- endif -%}
      {%- endfor -%}
      {%- if section.settings.calories_label != blank -%}
        <p class="ipg-nutrition__calories">
          <span>{{ section.settings.calories_label | escape }}</span>
          <span>{{ section.settings.calories_value | escape }}</span>
        </p>
      {%- endif -%}

      <div class="ipg-nutrition__scroll" role="region" aria-label="{{ section.settings.nutrition_title | escape }}" tabindex="0">
        <table class="ipg-nutrition__table">
          <thead>
            <tr>
              <th scope="col">{{ section.settings.column_name | escape }}</th>
              <th scope="col">{{ section.settings.column_amount | escape }}</th>
              <th scope="col">{{ section.settings.column_percent | escape }}</th>
            </tr>
          </thead>
          <tbody>
            {%- assign rows = section.settings.nutrition_rows | newline_to_br | split: '<br />' -%}
            {%- for line in rows -%}
              {%- assign row = line | strip -%}
              {%- if row == blank -%}
                {%- continue -%}
              {%- endif -%}
              {%- assign first_char = row | slice: 0 -%}
              {%- if first_char == '#' -%}
                <tr class="ipg-nutrition__group">
                  <th scope="colgroup" colspan="3">{{ row | remove: '#' | strip | escape }}</th>
                </tr>
              {%- else -%}
                {%- assign cells = row | split: '|' -%}
                <tr>
                  <th scope="row">{{ cells[0] | strip | escape }}</th>
                  <td>{{ cells[1] | strip | escape }}</td>
                  <td>{{ cells[2] | strip | escape }}</td>
                </tr>
              {%- endif -%}
            {%- endfor -%}
          </tbody>
        </table>
      </div>

      {%- if section.settings.nutrition_footnote != blank -%}
        <p class="ipg-nutrition__footnote">{{ section.settings.nutrition_footnote | escape }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if benefits.size > 0 or section.settings.benefits_title != blank -%}
    <div class="ipg-benefits">
      {%- if section.settings.benefits_title != blank -%}
        <h2 class="ipg-benefits__title">{{ section.settings.benefits_title }}</h2>
      {%- endif -%}
      {%- if benefits.size > 0 -%}
        <ul class="ipg-benefits__grid list-unstyled" role="list">
          {%- for block in benefits -%}
            <li class="ipg-benefit" {{ block.shopify_attributes }}>
              <h3 class="ipg-benefit__title">{{ block.settings.title | escape }}</h3>
              <p class="ipg-benefit__text">{{ block.settings.text | escape }}</p>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>

{%- if request.design_mode and show_filter -%}
  <script>
    document.addEventListener('shopify:block:select', (event) => {
      if (!event.target.classList.contains('ipg-card')) return;
      const allFilter = document.getElementById('{{ filter_prefix }}0');
      if (allFilter && event.target.closest('.ipg__catalog')?.contains(allFilter)) allFilter.checked = true;
    });
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Ingredientes (página)",
  "tag": "div",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 50,
  "settings": [
    {
      "type": "header",
      "content": "Colores generales"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fondo",
      "default": "#FEF5F1"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Títulos",
      "default": "#6B1626"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto",
      "default": "#4A2530"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Acento (filtros, etiquetas, tabla)",
      "default": "#B12141"
    },
    {
      "type": "color",
      "id": "dark_color",
      "label": "Filtro activo",
      "default": "#6B1626"
    },
    {
      "type": "color",
      "id": "shadow_color",
      "label": "Color de sombras",
      "default": "#6B1626"
    },
    {
      "type": "range",
      "id": "shadow_opacity",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "%",
      "label": "Opacidad de sombras",
      "default": 8
    },
    {
      "type": "header",
      "content": "Insignias"
    },
    {
      "type": "color",
      "id": "badge_gradient_start",
      "label": "Degradado: color inicial",
      "default": "#7A1C30"
    },
    {
      "type": "color",
      "id": "badge_gradient_end",
      "label": "Degradado: color final",
      "default": "#B12141"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Texto e icono",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "badge_size",
      "min": 60,
      "max": 160,
      "step": 2,
      "unit": "px",
      "label": "Tamaño del círculo",
      "default": 96
    },
    {
      "type": "range",
      "id": "badge_size_mobile",
      "min": 60,
      "max": 160,
      "step": 2,
      "unit": "px",
      "label": "Tamaño del círculo (móvil)",
      "default": 80
    },
    {
      "type": "header",
      "content": "Filtro e ingredientes"
    },
    {
      "type": "checkbox",
      "id": "show_filter",
      "label": "Mostrar filtro por categoría",
      "info": "Los botones se crean a partir de la categoría de cada ingrediente.",
      "default": true
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "Texto del botón \"todos\"",
      "default": "Todos"
    },
    {
      "type": "text",
      "id": "filter_label",
      "label": "Nombre accesible del filtro",
      "info": "No se ve; lo leen los lectores de pantalla.",
      "default": "Filtrar ingredientes"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Columnas (escritorio)",
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Columnas (tablet)",
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 2,
      "step": 1,
      "label": "Columnas (móvil)",
      "default": 1
    },
    {
      "type": "range",
      "id": "grid_max_width",
      "min": 600,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Ancho máximo de la cuadrícula",
      "default": 1100
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Radio de tarjetas",
      "default": 18
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Proporción de imagen",
      "options": [
        { "value": "1 / 1", "label": "Cuadrada (1:1)" },
        { "value": "4 / 3", "label": "Horizontal (4:3)" },
        { "value": "16 / 9", "label": "Panorámica (16:9)" },
        { "value": "3 / 4", "label": "Vertical (3:4)" }
      ],
      "default": "4 / 3"
    },
    {
      "type": "color",
      "id": "image_background",
      "label": "Fondo detrás de la imagen",
      "default": "#F3D9DD"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Color de la descripción",
      "default": "#4A2530"
    },
    {
      "type": "header",
      "content": "Información nutricional"
    },
    {
      "type": "checkbox",
      "id": "show_nutrition",
      "label": "Mostrar tabla nutricional",
      "default": true
    },
    {
      "type": "text",
      "id": "nutrition_title",
      "label": "Título",
      "default": "Información Nutricional"
    },
    {
      "type": "textarea",
      "id": "nutrition_meta",
      "label": "Datos bajo el título",
      "info": "Uno por línea.",
      "default": "30 dosis por envase\nDosis: 2 gominolas"
    },
    {
      "type": "text",
      "id": "calories_label",
      "label": "Calorías: texto",
      "default": "Calorías"
    },
    {
      "type": "text",
      "id": "calories_value",
      "label": "Calorías: valor",
      "default": "15"
    },
    {
      "type": "text",
      "id": "column_name",
      "label": "Encabezado de la columna de nutrientes",
      "info": "Opcional. En el original va vacío."
    },
    {
      "type": "text",
      "id": "column_amount",
      "label": "Encabezado de cantidad",
      "default": "Cantidad por dosis"
    },
    {
      "type": "text",
      "id": "column_percent",
      "label": "Encabezado de porcentaje",
      "default": "% VRN*"
    },
    {
      "type": "textarea",
      "id": "nutrition_rows",
      "label": "Filas de la tabla",
      "info": "Una fila por línea: Nutriente | Cantidad | %. Empieza la línea con # para crear un subtítulo.",
      "default": "# Complejo Bloqueador de DHT\nExtracto de Palma Enana | 200 mg | *\nExtracto de Semilla de Calabaza | 100 mg | *\nBeta-Sitosterol | 50 mg | *\n# Nutrientes Activos\nVitamina A (Palmitato de retinilo) | 800 µg RE | 89%\nVitamina C (Ácido ascórbico) | 80 mg | 89%\nVitamina B6 (Clorhidrato de piridoxina) | 1.4 mg | 82%\nVitamina B12 (Cianocobalamina) | 2.5 µg | 104%\nBiotina | 5000 mcg | 10000%\nÁcido pantoténico (Vitamina B5) | 6 mg | 120%\nVitamina E (Acetato de DL-Alfa-Tocoferilo) | 12 mg | 80%\nZinc (Citrato de zinc) | 10 mg | 91%\nSelenio | 55 µg | 100%\nAzúcares totales | 0 g | *\nSodio | 5 mg | *"
    },
    {
      "type": "text",
      "id": "nutrition_footnote",
      "label": "Nota al pie",
      "default": "*Valor de Referencia de Nutrientes (VRN) no establecido"
    },
    {
      "type": "color",
      "id": "nutrition_border",
      "label": "Bordes de la tabla",
      "default": "#E6CFD2"
    },
    {
      "type": "color",
      "id": "nutrition_section_background",
      "label": "Fondo de subtítulos",
      "default": "#FBE4E7"
    },
    {
      "type": "color",
      "id": "nutrition_muted_color",
      "label": "Encabezados y nota",
      "default": "#8A5560"
    },
    {
      "type": "header",
      "content": "Beneficios"
    },
    {
      "type": "inline_richtext",
      "id": "benefits_title",
      "label": "Título",
      "default": "Por Qué Esta Fórmula Es Diferente"
    },
    {
      "type": "color",
      "id": "benefits_gradient_start",
      "label": "Fondo: color superior",
