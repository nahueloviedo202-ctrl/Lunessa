    },
    {
      "type": "color",
      "id": "benefits_heading_color",
      "label": "Color de los subtítulos",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "benefits_text_color",
      "label": "Color del texto",
      "default": "#F2C9D1"
    },
    {
      "type": "range",
      "id": "benefits_padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Relleno vertical del bloque oscuro",
      "default": 60
    },
    {
      "type": "header",
      "content": "Espaciado y tipografía"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Relleno superior",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Relleno superior (móvil)",
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "heading_font_custom",
      "label": "Usar fuente personalizada en títulos",
      "info": "Si está desactivado se usa la fuente de títulos del tema.",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Fuente de títulos",
      "default": "assistant_n4"
    },
    {
      "type": "checkbox",
      "id": "body_font_custom",
      "label": "Usar fuente personalizada en textos",
      "info": "Si está desactivado se usa la fuente de cuerpo del tema.",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Fuente de textos",
      "default": "assistant_n4"
    }
