{{ 'section-stats-data.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font

  case section.settings.heading_font_source
    when 'theme_heading'
      assign heading_ff = 'var(--font-heading-family)'
      assign heading_fs = 'var(--font-heading-style)'
    when 'theme_body'
      assign heading_ff = 'var(--font-body-family)'
      assign heading_fs = 'var(--font-body-style)'
    else
      assign heading_ff = heading_font.family | append: ', ' | append: heading_font.fallback_families
      assign heading_fs = heading_font.style
  endcase

  case section.settings.body_font_source
    when 'theme_heading'
      assign body_ff = 'var(--font-heading-family)'
      assign body_fs = 'var(--font-heading-style)'
    when 'theme_body'
      assign body_ff = 'var(--font-body-family)'
      assign body_fs = 'var(--font-body-style)'
    else
      assign body_ff = body_font.family | append: ', ' | append: body_font.fallback_families
      assign body_fs = body_font.style
  endcase
-%}

{%- style -%}
  {% if section.settings.heading_font_source == 'custom' %}
    {%- assign heading_font_weighted = heading_font | font_modify: 'weight', section.settings.heading_font_weight | default: heading_font -%}
    {{ heading_font_weighted | font_face: font_display: 'swap' }}
    {%- unless section.settings.number_font_weight == section.settings.heading_font_weight -%}
      {%- assign number_font_weighted = heading_font | font_modify: 'weight', section.settings.number_font_weight -%}
      {{ number_font_weighted | font_face: font_display: 'swap' }}
    {%- endunless -%}
  {% endif %}
  {% if section.settings.body_font_source == 'custom' %}
    {{ body_font | font_face: font_display: 'swap' }}
    {%- assign body_font_bold = body_font | font_modify: 'weight', 'bold' -%}
    {{ body_font_bold | font_face: font_display: 'swap' }}
    {%- assign body_font_italic = body_font | font_modify: 'style', 'italic' -%}
    {{ body_font_italic | font_face: font_display: 'swap' }}
  {% endif %}

  .sdt--{{ section.id }} {
    --sdt-bg: {{ section.settings.background_color }};
    --sdt-max-width: {{ section.settings.max_width }}px;
    --sdt-pt: {{ section.settings.padding_top }}px;
    --sdt-pb: {{ section.settings.padding_bottom }}px;
    --sdt-px: {{ section.settings.padding_x }}px;
    --sdt-pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --sdt-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --sdt-px-mobile: {{ section.settings.padding_x_mobile }}px;
    --sdt-stack-gap: {{ section.settings.stack_gap }}px;
    --sdt-stack-gap-mobile: {{ section.settings.stack_gap_mobile }}px;

    --sdt-heading-ff: {{ heading_ff }};
    --sdt-heading-fs: {{ heading_fs }};
    --sdt-heading-fw: {{ section.settings.heading_font_weight }};
    --sdt-heading-color: {{ section.settings.heading_color }};
    --sdt-heading-size: {{ section.settings.heading_size }}px;
    --sdt-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --sdt-heading-lh: {{ section.settings.heading_line_height }}px;
    --sdt-heading-lh-mobile: {{ section.settings.heading_line_height_mobile }}px;
    --sdt-header-gap: {{ section.settings.header_gap }}px;
    --sdt-subheading-color: {{ section.settings.subheading_color }};
    --sdt-subheading-size: {{ section.settings.subheading_size }}px;
    --sdt-subheading-lh: {{ section.settings.subheading_line_height }}px;
    --sdt-subheading-max-width: {{ section.settings.subheading_max_width }}px;
    --sdt-body-ff: {{ body_ff }};
    --sdt-body-fs: {{ body_fs }};

    --sdt-columns: {{ section.settings.columns_desktop }};
    --sdt-columns-tablet: {{ section.settings.columns_tablet }};
    --sdt-columns-mobile: {{ section.settings.columns_mobile }};
    --sdt-grid-gap: {{ section.settings.grid_gap }}px;
    --sdt-grid-gap-mobile: {{ section.settings.grid_gap_mobile }}px;
    --sdt-stat-gap: {{ section.settings.stat_gap }}px;
    --sdt-number-color: {{ section.settings.number_color }};
    --sdt-number-fw: {{ section.settings.number_font_weight }};
    --sdt-number-size: {{ section.settings.number_size }}px;
    --sdt-number-size-mobile: {{ section.settings.number_size_mobile }}px;
    --sdt-number-ls: {{ section.settings.number_letter_spacing | divided_by: 100.0 }}em;
    --sdt-label-color: {{ section.settings.label_color }};
    --sdt-label-size: {{ section.settings.label_size }}px;
    --sdt-label-lh: {{ section.settings.label_line_height }}px;
    --sdt-label-max-width: {{ section.settings.label_max_width }}px;

    --sdt-footer-gap: {{ section.settings.footer_gap }}px;
    --sdt-button-bg: {{ section.settings.button_background }};
    --sdt-button-color: {{ section.settings.button_color }};
    --sdt-button-border: {{ section.settings.button_border }};
    --sdt-button-bg-hover: {{ section.settings.button_background_hover }};
    --sdt-button-color-hover: {{ section.settings.button_color_hover }};
    --sdt-button-border-hover: {{ section.settings.button_border_hover }};
    --sdt-button-size: {{ section.settings.button_size }}px;
    --sdt-button-height: {{ section.settings.button_height }}px;
    --sdt-button-max-width: {{ section.settings.button_max_width }}px;
    --sdt-button-radius: {{ section.settings.button_radius }}px;
    --sdt-disclaimer-color: {{ section.settings.disclaimer_color }};
    --sdt-disclaimer-size: {{ section.settings.disclaimer_size }}px;
    --sdt-disclaimer-max-width: {{ section.settings.disclaimer_max_width }}px;
    --sdt-disclaimer-style: {% if section.settings.disclaimer_italic %}italic{% else %}normal{% endif %};
  }
{%- endstyle -%}

<section class="sdt sdt--{{ section.id }}">
  <div class="sdt__inner">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="sdt__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="sdt__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="sdt__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="sdt__grid" role="list">
        {%- for block in section.blocks -%}
          <li
            class="sdt-stat{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.number != blank -%}
              <span class="sdt-stat__number">{{ block.settings.number | escape }}</span>
            {%- endif -%}
            {%- if block.settings.label != blank -%}
              <span class="sdt-stat__label">{{ block.settings.label }}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.button_label != blank or section.settings.disclaimer != blank -%}
      <div class="sdt__footer">
        {%- if section.settings.button_label != blank -%}
          <a
            class="sdt__button"
            {% if section.settings.button_link != blank %}
              href="{{ section.settings.button_link }}"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
          >
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.disclaimer != blank -%}
          <p class="sdt__disclaimer">{{ section.settings.disclaimer }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

