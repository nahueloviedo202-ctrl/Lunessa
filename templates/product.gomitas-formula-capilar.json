    "testimonials_carousel_8rAnhc": {
      "type": "testimonials-carousel",
      "blocks": {
        "testimonial_L4fDp7": {
          "type": "testimonial",
          "settings": {
            "image": "shopify://shop_images/Transformacao5.webp",
            "rating": 5,
            "title": "Mi raya ya no se nota tanto",
            "text": "\"Después de 3 meses, he notado una gran mejora. Ya no se me nota tanto la raya. Gracias por devolverme algo que pensaba que no iba a recuperar\"",
            "author": "Carmen Montoya",
            "verified": true
          }
        },
        "testimonial_DdAtd8": {
          "type": "testimonial",
          "settings": {
            "image": "shopify://shop_images/Transformacao2.webp",
            "rating": 5,
            "title": "Menos caída de pelo",
            "text": "\"Notaba muchísimo pelo en la almohada, la verdad, y la raya cada vez más ancha. Con Lunessa eso ha cambiado, se me cae mucho menos y ya casi ni se ve\"",
            "author": "Marta González",
            "verified": true
          }
        },
        "testimonial_cfNwcH": {
          "type": "testimonial",
          "settings": {
            "image": "shopify://shop_images/Transformacao7.webp",
            "rating": 5,
            "title": "Repoblar las entradas",
            "text": "\"La caída ya me tenía agobiada, pelo hasta en el coche. Con Lunessa se nota bastante menos y las entradas se han rellenado un poco\"",
            "author": "Sofía Peña",
            "verified": true
          }
        },
        "testimonial_7LGmqV": {
          "type": "testimonial",
          "settings": {
            "image": "shopify://shop_images/Transformacao1.webp",
            "rating": 5,
            "title": "Mejora en la coronilla",
            "text": "\"Noté una mejora bastante grande, sobre todo en la parte de arriba de la cabeza. Muy fácil de meter en la rutina y las gomitas están buenísimas la verdad\"",
            "author": "Cristina Navarro",
            "verified": true
          }
        },
        "testimonial_64TGNT": {
          "type": "testimonial",
          "settings": {
            "image": "shopify://shop_images/Transformacao6.webp",
            "rating": 5,
            "title": "La entrada ya no me acompleja",
            "text": "\"Se me marcaba la entrada y me acomplejaba con el pelo mojado. Con Lunessa la noto mucho más poblada, ya no me da tanto reparo llevarlo recogido\"",
            "author": "Patricia D.",
            "verified": true
          }
        },
        "testimonial_BWTwAc": {
          "type": "testimonial",
          "settings": {
            "image": "shopify://shop_images/Transformacao3.webp",
            "rating": 5,
            "title": "Lo revertí con dos gomitas al día",
            "text": "\"Durante mucho tiempo la caída me preocupó bastante, la verdad. Con solo dos gomitas al día lo conseguí revertir, y el proceso ha sido buenísimo\"",
            "author": "Elena Martínez",
            "verified": true
          }
        },
        "testimonial_VqBMFJ": {
          "type": "testimonial",
          "settings": {
            "image": "shopify://shop_images/Transformacao4.webp",
            "rating": 5,
            "title": "Lunessa ha cambiado mi melena",
            "text": "\"Tenía el pelo fino y débil, lo notaba al peinarme y verlo en el suelo del baño. Desde que tomo estas gomitas, eso se acabó\"",
            "author": "Lucía Fernández",
            "verified": true
          }
        }
