        "ingredient_03": {
          "type": "ingredient",
          "settings": {
            "name": "Extracto de Palma Enana",
            "description": "Es el ingrediente central del Triple Bloqueo DHT. Actúa sobre la hormona que ataca tu raíz, ayudando a frenar la caída desde el origen del problema, no solo desde fuera.",
            "tag": "Protección Folicular",
            "categories": "DHT"
          }
        },
        "ingredient_04": {
          "type": "ingredient",
          "settings": {
            "name": "Extracto de Semilla de Calabaza",
            "description": "Complementa la Palma Enana dentro del Triple Bloqueo DHT. Ayuda a cuidar tu folículo capilar y sostiene el efecto del extracto principal a lo largo del día.",
            "tag": "Fortalece",
            "categories": "DHT"
          }
        },
        "ingredient_05": {
          "type": "ingredient",
          "settings": {
            "name": "Beta-Sitosterol",
            "description": "Junto a la Palma Enana, es la combinación con respaldo del estudio Prager et al. (2002) sobre el bloqueo de DHT. Refuerza el efecto principal desde la raíz.",
            "tag": "Sinergia Clave",
            "categories": "DHT"
          }
        },
        "ingredient_06": {
          "type": "ingredient",
          "settings": {
            "name": "Vitamina A",
            "description": "Ayuda a renovar las células de tu cuero cabelludo, manteniendo un entorno saludable para que la raíz siga produciendo pelo fuerte.",
            "tag": "Renovación",
            "categories": "Vitaminas"
          }
        },
        "ingredient_07": {
          "type": "ingredient",
          "settings": {
            "name": "Vitamina C",
            "description": "Antioxidante que protege la fibra capilar del daño diario y ayuda a tu cuerpo a absorber mejor otros nutrientes de la fórmula.",
            "tag": "Antioxidante",
            "categories": "Vitaminas"
          }
        },
        "ingredient_08": {
          "type": "ingredient",
          "settings": {
            "name": "Vitamina B6",
            "description": "Apoya la producción natural de queratina, la proteína que forma la estructura de tu pelo.",
            "tag": "Queratina",
            "categories": "Vitaminas"
          }
        },
        "ingredient_09": {
          "type": "ingredient",
          "settings": {
            "name": "Vitamina B12",
            "description": "Ayuda a oxigenar tu raíz capilar, para que el pelo nuevo nazca con más fuerza desde el folículo.",
            "tag": "Oxigenación",
            "categories": "Vitaminas"
          }
        },
        "ingredient_10": {
          "type": "ingredient",
          "settings": {
            "name": "Biotina",
            "description": "Apoya el crecimiento natural de tu pelo, tu piel y tus uñas — por eso muchas notan también las uñas más fuertes.",
            "tag": "Crecimiento",
            "categories": "Vitaminas"
          }
        },
        "ingredient_11": {
          "type": "ingredient",
          "settings": {
            "name": "Vitamina B5",
            "description": "Hidrata tu cuero cabelludo desde dentro y ayuda a mantener su elasticidad día a día.",
            "tag": "Hidratación",
            "categories": "Vitaminas"
          }
        },
        "ingredient_12": {
          "type": "ingredient",
          "settings": {
            "name": "Vitamina E",
            "description": "Antioxidante que protege tu cuero cabelludo del estrés oxidativo diario, cuidando el entorno donde crece tu pelo.",
            "tag": "Protección",
            "categories": "Vitaminas"
          }
        },
        "ingredient_13": {
          "type": "ingredient",
          "settings": {
            "name": "Zinc",
            "description": "Ayuda a reparar tu folículo capilar y regula la producción de grasa en el cuero cabelludo.",
            "tag": "Reparación",
            "categories": "Vitaminas"
          }
        },
        "ingredient_14": {
          "type": "ingredient",
          "settings": {
            "name": "Selenio",
            "description": "Protege las células de tu cuero cabelludo frente al daño externo, día tras día.",
            "tag": "Protección Celular",
            "categories": "Vitaminas"
          }
        }
      },
